  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#A_FUNC04">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Algorithm"/>
    <func:courseId>A_FUNC04</func:courseId>
    <rdfs:label>Collatz Stopping-Time Function</rdfs:label>
    <func:definition>Given a positive integer n, count how many Collatz (3n+1) steps are required to reach 1, encapsulated as a function with a clear parameter and integer return value.</func:definition>
    <func:usesConcept>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC02">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Concept"/>
        <func:courseId>C_FUNC02</func:courseId>
        <rdfs:label>Function Definition</rdfs:label>
        <func:definition>The process of creating a function by specifying its name, parameters and body using the def keyword.</func:definition>
        <func:cognitiveType>procedural</func:cognitiveType>
        <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC01"/>
        <func:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#LC_FUNC01"/>
        <func:bestPractice>Choose descriptive function names that clearly describe the task performed.</func:bestPractice>
        <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
        <func:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#E_FUNC04"/>
      </owl:NamedIndividual>
    </func:usesConcept>
    <func:usesConcept>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC03">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Concept"/>
        <func:courseId>C_FUNC03</func:courseId>
        <rdfs:label>Function Call</rdfs:label>
        <func:definition>Executing a previously defined function by writing its name followed by parentheses containing any required arguments.</func:definition>
        <func:cognitiveType>procedural</func:cognitiveType>
        <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC01"/>
        <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC02"/>
        <func:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#E_FUNC01"/>
        <func:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#E_FUNC04"/>
        <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
      </owl:NamedIndividual>
    </func:usesConcept>
    <func:usesConcept>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC05">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Concept"/>
        <func:courseId>C_FUNC05</func:courseId>
        <rdfs:label>Parameter</rdfs:label>
        <func:definition>A variable declared in a function definition that represents an expected input value.</func:definition>
        <func:cognitiveType>conceptual</func:cognitiveType>
        <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC02"/>
        <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
        <func:acceptsType rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#DT_FUNC01"/>
        <func:acceptsType rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#DT_FUNC02"/>
        <func:acceptsType rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#DT_FUNC03"/>
      </owl:NamedIndividual>
    </func:usesConcept>
    <func:usesConcept>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC06">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Concept"/>
        <func:courseId>C_FUNC06</func:courseId>
        <rdfs:label>Argument</rdfs:label>
        <func:definition>The actual value passed to a function when it is called.</func:definition>
        <func:cognitiveType>conceptual</func:cognitiveType>
        <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC03"/>
        <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC05"/>
        <func:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#E_FUNC01"/>
        <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
      </owl:NamedIndividual>
    </func:usesConcept>
    <func:usesConcept>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC07">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Concept"/>
        <func:courseId>C_FUNC07</func:courseId>
        <rdfs:label>Return Value</rdfs:label>
        <func:definition>The value produced by a function and sent back to the caller using the return statement.</func:definition>
        <func:cognitiveType>conceptual</func:cognitiveType>
        <func:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#LC_FUNC02"/>
        <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC01"/>
        <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
        <func:producesType rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#DT_FUNC01"/>
        <func:producesType rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#DT_FUNC02"/>
        <func:producesType rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#DT_FUNC03"/>
        <func:producesType rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#DT_FUNC04"/>
      </owl:NamedIndividual>
    </func:usesConcept>
    <func:solvesProblem>Generate customized greeting messages.</func:solvesProblem>
    <func:taughtIn>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#L04">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Lecture"/>
        <func:courseId>L04</func:courseId>
        <rdfs:label>Functions</rdfs:label>
        <func:definition>Defining and using Python functions, parameters, return values and variable scope.</func:definition>
      </owl:NamedIndividual>
    </func:taughtIn>
    <func:usesConstruct>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#LC_FUNC01">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#LanguageConstruct"/>
        <func:courseId>LC_FUNC01</func:courseId>
        <rdfs:label>def</rdfs:label>
        <func:definition>Defines a new function by specifying its name, optional parameters and body.</func:definition>
        <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
        <func:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#E_FUNC04"/>
      </owl:NamedIndividual>
    </func:usesConstruct>
    <func:usesConstruct>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#LC_FUNC02">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#LanguageConstruct"/>
        <func:courseId>LC_FUNC02</func:courseId>
        <rdfs:label>return</rdfs:label>
        <func:definition>Terminates the execution of a function and optionally sends a value back to the caller.</func:definition>
        <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
      </owl:NamedIndividual>
    </func:usesConstruct>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#F_FUNC02">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#BuiltInFunction"/>
    <func:courseId>F_FUNC02</func:courseId>
    <rdfs:label>input()</rdfs:label>
    <func:definition>Reads a line of text entered by the user.</func:definition>
    <func:producesType>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#DT_FUNC03">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#DataType"/>
        <func:courseId>DT_FUNC03</func:courseId>
        <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
        <func:definition>Sequence of Unicode characters.</func:definition>
        <rdfs:label>str</rdfs:label>
      </owl:NamedIndividual>
    </func:producesType>
    <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC18">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Concept"/>
    <rdfs:label>Default Argument</rdfs:label>
    <func:courseId>C_FUNC18</func:courseId>
    <func:definition>A parameter default value used when the caller omits the corresponding argument.</func:definition>
    <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
    <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC05"/>
    <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC02"/>
    <func:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#LC_FUNC01"/>
    <func:cognitiveType>conceptual</func:cognitiveType>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#A_FUNC03">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Algorithm"/>
    <func:courseId>A_FUNC03</func:courseId>
    <rdfs:label>Iterative Factorial Function</rdfs:label>
    <func:definition>Compute n! for a non-negative integer n inside a single-purpose function that takes n as a parameter, uses a local accumulator in its body, and returns the product.</func:definition>
    <func:usesConcept>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC01">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Concept"/>
        <func:courseId>C_FUNC01</func:courseId>
        <rdfs:label>Function</rdfs:label>
        <func:definition>A reusable named block of code that performs a specific task. A function may receive inputs through parameters and optionally return a result.</func:definition>
        <func:cognitiveType>conceptual</func:cognitiveType>
        <func:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#LC_FUNC01"/>
        <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
      </owl:NamedIndividual>
    </func:usesConcept>
    <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC05"/>
    <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC07"/>
    <func:usesConcept>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC04">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Concept"/>
        <func:courseId>C_FUNC04</func:courseId>
        <rdfs:label>Function Body</rdfs:label>
        <func:definition>The indented block of statements executed whenever the function is called.</func:definition>
        <func:cognitiveType>conceptual</func:cognitiveType>
        <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC02"/>
        <func:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#LC_FUNC01"/>
        <func:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#E_FUNC03"/>
        <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
      </owl:NamedIndividual>
    </func:usesConcept>
    <func:usesConcept>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC09">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Concept"/>
        <func:courseId>C_FUNC09</func:courseId>
        <rdfs:label>Local Variable</rdfs:label>
        <func:definition>A variable created inside a function that exists only while the function executes.</func:definition>
        <func:cognitiveType>conceptual</func:cognitiveType>
        <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC01"/>
        <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC08"/>
        <func:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC17"/>
        <func:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#E_FUNC02"/>
        <func:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#E_FUNC05"/>
        <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
      </owl:NamedIndividual>
    </func:usesConcept>
    <func:usesConcept>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#P_FUNC02">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Pattern"/>
        <rdfs:label>Early-Return Guard Pattern</rdfs:label>
        <func:courseId>P_FUNC02</func:courseId>
        <func:definition>Handle invalid or edge-case inputs at the start of a function with an immediate return (a guard), before running the main computation.</func:definition>
        <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
        <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC07"/>
        <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC05"/>
        <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC04"/>
        <func:cognitiveType>procedural</func:cognitiveType>
      </owl:NamedIndividual>
    </func:usesConcept>
    <func:solvesProblem>Compute the area of a rectangle.</func:solvesProblem>
    <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
    <func:usesConstruct rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#LC_FUNC01"/>
    <func:usesConstruct rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#LC_FUNC02"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC14">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Concept"/>
    <func:courseId>C_FUNC14</func:courseId>
    <rdfs:label>Placeholder Implementation</rdfs:label>
    <func:definition>A temporary function implementation used while designing a program. The pass statement allows the function to exist before its logic has been written.</func:definition>
    <func:cognitiveType>procedural</func:cognitiveType>
    <func:implementedBy>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#LC_FUNC03">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#LanguageConstruct"/>
        <func:courseId>LC_FUNC03</func:courseId>
        <rdfs:label>pass</rdfs:label>
        <func:definition>Placeholder statement used when the body of a function has not yet been implemented.</func:definition>
        <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
      </owl:NamedIndividual>
    </func:implementedBy>
    <func:bestPractice>Use pass only while incrementally developing a program and replace it with a real implementation as soon as possible.</func:bestPractice>
    <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#F_FUNC03">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#BuiltInFunction"/>
    <func:courseId>F_FUNC03</func:courseId>
    <rdfs:label>len()</rdfs:label>
    <func:definition>Returns the number of elements contained in an object.</func:definition>
    <func:producesType>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#DT_FUNC01">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#DataType"/>
        <func:courseId>DT_FUNC01</func:courseId>
        <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
        <func:definition>Integer numeric type.</func:definition>
        <rdfs:label>int</rdfs:label>
      </owl:NamedIndividual>
    </func:producesType>
    <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/functions#isThrownBy">
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#ErrorType"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/functions#throwsError">
        <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#ErrorType"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>Associates a language construct, function, method, or concept with an error that may result from its incorrect use.</rdfs:comment>
        <rdfs:label>throws_error</rdfs:label>
      </owl:ObjectProperty>
    </owl:inverseOf>
    <rdfs:comment>Inverse of throws_error.</rdfs:comment>
    <rdfs:label>is_thrown_by</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC16">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Concept"/>
    <func:courseId>C_FUNC16</func:courseId>
    <rdfs:label>Variable Visibility</rdfs:label>
    <func:definition>The set of program locations from which a variable can be accessed. Variable visibility is determined by its scope.</func:definition>
    <func:cognitiveType>conceptual</func:cognitiveType>
    <func:dependsOn>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC08">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Concept"/>
        <func:courseId>C_FUNC08</func:courseId>
        <rdfs:label>Scope</rdfs:label>
        <func:definition>The region of a program where a variable is visible and can be accessed.</func:definition>
        <func:cognitiveType>conceptual</func:cognitiveType>
        <func:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#E_FUNC02"/>
        <func:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#E_FUNC05"/>
        <func:bestPractice>Return values instead of relying on variables defined inside a function.</func:bestPractice>
        <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
      </owl:NamedIndividual>
    </func:dependsOn>
    <func:throwsError>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#E_FUNC02">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#ErrorType"/>
        <func:courseId>E_FUNC02</func:courseId>
        <rdfs:label>NameError</rdfs:label>
        <func:definition>Raised when trying to access a variable that is outside its scope or has not been defined.</func:definition>
        <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
      </owl:NamedIndividual>
    </func:throwsError>
    <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#A_FUNC01">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Algorithm"/>
    <func:courseId>A_FUNC01</func:courseId>
    <rdfs:label>Quadratic Root Classification</rdfs:label>
    <func:definition>Classify the number of real roots of a quadratic equation ax²+bx+c=0 by decomposing the work into helper functions (e.g. discriminant computation and root-count classification) that return values to the caller.</func:definition>
    <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC01"/>
    <func:usesConcept>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC11">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Concept"/>
        <func:courseId>C_FUNC11</func:courseId>
        <rdfs:label>Problem Decomposition</rdfs:label>
        <func:definition>Breaking a larger programming task into smaller reusable functions that each perform a single responsibility.</func:definition>
        <func:cognitiveType>conceptual</func:cognitiveType>
        <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC10"/>
        <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC01"/>
        <func:bestPractice>Each function should solve one clearly defined subproblem.</func:bestPractice>
        <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
      </owl:NamedIndividual>
    </func:usesConcept>
    <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC07"/>
    <func:usesConcept>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC15">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Concept"/>
        <func:courseId>C_FUNC15</func:courseId>
        <rdfs:label>Function Interface</rdfs:label>
        <func:definition>The externally visible part of a function consisting of its name, expected parameters and returned value. The interface determines how other parts of the program interact with the function.</func:definition>
        <func:cognitiveType>conceptual</func:cognitiveType>
        <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC02"/>
        <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC05"/>
        <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC07"/>
        <func:bestPractice>Keep function interfaces simple and easy to understand.</func:bestPractice>
        <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
      </owl:NamedIndividual>
    </func:usesConcept>
    <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC05"/>
    <func:usesConcept>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#P_FUNC01">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Pattern"/>
        <rdfs:label>Helper Function Pattern</rdfs:label>
        <func:courseId>P_FUNC01</func:courseId>
        <func:definition>Extract a focused reusable function that performs one clear task so a larger problem can be solved by composing helpers instead of duplicating code.</func:definition>
        <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
        <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC01"/>
        <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC10"/>
        <func:cognitiveType>procedural</func:cognitiveType>
      </owl:NamedIndividual>
    </func:usesConcept>
    <func:solvesProblem>Determine the number of real roots of a quadratic equation.</func:solvesProblem>
    <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
    <func:usesConstruct rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#LC_FUNC01"/>
    <func:usesConstruct rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#LC_FUNC02"/>
  </owl:NamedIndividual>
