  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#SK_FUNC04">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Skill"/>
    <func:courseId>SK_FUNC04</func:courseId>
    <rdfs:label>Decompose Problems into Functions</rdfs:label>
    <func:definition>Transform a larger programming problem into several smaller functions with clearly defined responsibilities that collaborate to solve the overall task.</func:definition>
    <func:dependsOn>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#SK_FUNC01">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Skill"/>
        <func:courseId>SK_FUNC01</func:courseId>
        <rdfs:label>Design Reusable Functions</rdfs:label>
        <func:definition>Design functions that perform a single well-defined task and can be reused with different inputs without modifying their implementation.</func:definition>
        <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC01"/>
        <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC10"/>
        <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC15"/>
        <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
      </owl:NamedIndividual>
    </func:dependsOn>
    <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC11"/>
    <func:usesConcept>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC10">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Concept"/>
        <func:courseId>C_FUNC10</func:courseId>
        <rdfs:label>Code Reuse</rdfs:label>
        <func:definition>Using the same function multiple times instead of duplicating the same sequence of instructions.</func:definition>
        <func:cognitiveType>conceptual</func:cognitiveType>
        <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC01"/>
        <func:bestPractice>Avoid copying and pasting code by extracting repeated logic into functions.</func:bestPractice>
        <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
      </owl:NamedIndividual>
    </func:usesConcept>
    <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC15"/>
    <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#P_FUNC01"/>
    <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#A_FUNC02">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Algorithm"/>
    <func:courseId>A_FUNC02</func:courseId>
    <rdfs:label>Euclidean GCD Function</rdfs:label>
    <func:definition>Expose the Euclidean GCD procedure as a reusable function with two integer parameters and an integer return value, so callers can compute gcd(a, b) without duplicating the loop logic.</func:definition>
    <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC01"/>
    <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC05"/>
    <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC07"/>
    <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC10"/>
    <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC09"/>
    <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#P_FUNC02"/>
    <func:solvesProblem>Convert temperatures between measurement scales.</func:solvesProblem>
    <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
    <func:usesConstruct rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#LC_FUNC01"/>
    <func:usesConstruct rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#LC_FUNC02"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#F_FUNC01">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#BuiltInFunction"/>
    <func:courseId>F_FUNC01</func:courseId>
    <rdfs:label>print()</rdfs:label>
    <func:definition>Displays one or more values on the standard output.</func:definition>
    <func:acceptsType rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#DT_FUNC01"/>
    <func:acceptsType>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#DT_FUNC02">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#DataType"/>
        <func:courseId>DT_FUNC02</func:courseId>
        <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
        <func:definition>Boolean type containing only True and False.</func:definition>
        <rdfs:label>bool</rdfs:label>
      </owl:NamedIndividual>
    </func:acceptsType>
    <func:acceptsType rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#DT_FUNC03"/>
    <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="http://comp101.sase.um6p.ma/ontology/functions#bestPractice">
    <rdfs:label>best_practice</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment>Stores a recommended programming practice associated with an educational entity.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#SK_FUNC03">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Skill"/>
    <func:courseId>SK_FUNC03</func:courseId>
    <rdfs:label>Reason About Function Execution</rdfs:label>
    <func:definition>Predict and explain how a function executes by tracing parameter values, local variables, return statements and scope.</func:definition>
    <func:dependsOn>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#SK_FUNC02">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Skill"/>
        <func:courseId>SK_FUNC02</func:courseId>
        <rdfs:label>Manage Function Inputs and Outputs</rdfs:label>
        <func:definition>Correctly design, call and use functions by matching parameters with arguments and by returning and using computed values.</func:definition>
        <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#SK_FUNC01"/>
        <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC05"/>
        <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC06"/>
        <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC07"/>
        <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC12"/>
        <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC13"/>
        <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#P_FUNC02"/>
        <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
      </owl:NamedIndividual>
    </func:dependsOn>
    <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC03"/>
    <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC04"/>
    <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC08"/>
    <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC09"/>
    <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
  </owl:NamedIndividual>
