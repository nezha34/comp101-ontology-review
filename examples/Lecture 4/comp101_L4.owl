      <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/functions#producesType">
        <rdfs:comment>Subject produces or involves values of the object DataType as output/return. Used for BuiltInFunction return types and for pedagogical Concepts such as Function Output or Return Value (including NoneType when nothing useful is returned).</rdfs:comment>
        <rdfs:domain>
          <rdf:Description rdf:nodeID="N907d506f8107417dac3a8f268a0f8136">
            <owl:unionOf rdf:parseType="Collection">
