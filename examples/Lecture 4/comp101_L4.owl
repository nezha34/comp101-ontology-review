        <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#DataType"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#DataType"/>
    <rdfs:label>is_produced_by</rdfs:label>
