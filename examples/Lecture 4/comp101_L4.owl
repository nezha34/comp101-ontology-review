    <rdfs:range>
      <rdf:Description rdf:nodeID="N96a19a58d31f4b6b9542de1b73cba6c9">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/functions#BuiltInFunction"/>
          <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/functions#Concept"/>
        </owl:unionOf>
      </rdf:Description>
    </rdfs:range>
  </owl:ObjectProperty>
