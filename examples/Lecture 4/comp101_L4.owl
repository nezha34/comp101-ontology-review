  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/functions#Pattern">
    <rdfs:label>Pattern</rdfs:label>
    <rdfs:comment>A reusable pedagogical programming pattern taught in this lecture (e.g. helper-function extraction).</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/functions#implementsConcept">
    <rdfs:label>implements_concept</rdfs:label>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#ConceptCarrier"/>
    <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Concept"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/functions#implementedBy">
        <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Concept"/>
        <rdfs:label>implemented_by</rdfs:label>
        <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#ConceptCarrier"/>
        <rdfs:comment>Concept is realized/expressed by this ConceptCarrier (language construct, operator, builtin, or data type). Inverse of implementsConcept. Domain is Concept only (not Algorithm).</rdfs:comment>
        <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#implementsConcept"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
    <rdfs:comment>Inverse of implementedBy: a ConceptCarrier realizes or expresses this Concept. A-Box may assert only implementedBy; reasoners can infer this direction.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/functions#hasMethods">
    <rdfs:label>has_methods</rdfs:label>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#DataType"/>
    <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Method"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/functions#methodOf">
        <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#hasMethods"/>
        <rdfs:label>method_of</rdfs:label>
        <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#DataType"/>
        <rdfs:comment>This method belongs to a data type.</rdfs:comment>
        <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Method"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
    <rdfs:comment>Inverse of method_of.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#E_FUNC01">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#ErrorType"/>
    <func:courseId>E_FUNC01</func:courseId>
    <rdfs:label>TypeError</rdfs:label>
    <func:definition>Raised when a function receives an incorrect number or type of arguments.</func:definition>
    <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC13">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Concept"/>
    <func:courseId>C_FUNC13</func:courseId>
    <rdfs:label>Function Output</rdfs:label>
    <func:definition>The value produced by a function and made available to the caller through the return statement.</func:definition>
    <func:cognitiveType>conceptual</func:cognitiveType>
    <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC07"/>
    <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
    <func:producesType rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#DT_FUNC01"/>
    <func:producesType rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#DT_FUNC02"/>
    <func:producesType rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#DT_FUNC03"/>
    <func:producesType>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#DT_FUNC04">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#DataType"/>
        <func:courseId>DT_FUNC04</func:courseId>
        <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
        <func:definition>Special Python type representing the absence of a returned value.</func:definition>
        <rdfs:label>NoneType</rdfs:label>
      </owl:NamedIndividual>
    </func:producesType>
  </owl:NamedIndividual>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/functions#BuiltInFunction">
    <rdfs:label>BuiltInFunction</rdfs:label>
    <rdfs:comment>A native Python built-in function.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#ConceptCarrier"/>
  </owl:Class>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/functions#ConceptCarrier">
    <rdfs:label>ConceptCarrier</rdfs:label>
    <rdfs:comment>Python surface that can realize or carry curriculum concepts (language constructs, operators, builtins, data types). Organizational superclass used as domain/range of realization and algorithm-construct properties.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </owl:Class>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/functions#Concept">
    <rdfs:label>Concept</rdfs:label>
    <rdfs:comment>An abstract programming concept.</rdfs:comment>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#E_FUNC03">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#ErrorType"/>
    <func:courseId>E_FUNC03</func:courseId>
    <rdfs:label>IndentationError</rdfs:label>
    <func:definition>Raised when the indentation of a function body is incorrect.</func:definition>
    <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC17">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Concept"/>
    <rdfs:label>Global Variable</rdfs:label>
    <func:courseId>C_FUNC17</func:courseId>
    <func:definition>A variable defined outside any function, visible across the module unless shadowed by a local name.</func:definition>
    <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
    <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC08"/>
    <func:cognitiveType>conceptual</func:cognitiveType>
    <func:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC09"/>
    <func:throwsError>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#E_FUNC05">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#ErrorType"/>
        <rdfs:label>UnboundLocalError</rdfs:label>
        <func:courseId>E_FUNC05</func:courseId>
        <func:definition>Raised when a local variable is read before being assigned in that function.</func:definition>
        <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
      </owl:NamedIndividual>
    </func:throwsError>
  </owl:NamedIndividual>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/functions#LanguageConstruct">
    <rdfs:label>LanguageConstruct</rdfs:label>
    <rdfs:comment>A Python language construct.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#ConceptCarrier"/>
  </owl:Class>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/functions#DataType">
    <rdfs:label>DataType</rdfs:label>
    <rdfs:comment>A Python data type.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#ConceptCarrier"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC12">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Concept"/>
    <func:courseId>C_FUNC12</func:courseId>
    <rdfs:label>Function Input</rdfs:label>
    <func:definition>The collection of argument values supplied to a function when it is called. Function inputs determine how the function behaves for a particular execution.</func:definition>
    <func:cognitiveType>conceptual</func:cognitiveType>
    <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC06"/>
    <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
    <func:acceptsType rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#DT_FUNC01"/>
    <func:acceptsType rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#DT_FUNC02"/>
    <func:acceptsType rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#DT_FUNC03"/>
  </owl:NamedIndividual>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/functions#Lecture">
    <rdfs:label>Lecture</rdfs:label>
    <rdfs:comment>A COMP101 lecture.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/functions#Skill">
    <rdfs:label>Skill</rdfs:label>
    <rdfs:comment>A transferable programming competency.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/functions#acceptedBy">
    <rdfs:label>accepted_by</rdfs:label>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#DataType"/>
    <rdfs:range>
      <rdf:Description rdf:nodeID="Nd7128ecce5fa4ab5886e21323d0e5115">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/functions#BuiltInFunction"/>
          <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/functions#Concept"/>
        </owl:unionOf>
      </rdf:Description>
    </rdfs:range>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/functions#acceptsType">
        <rdfs:domain>
          <rdf:Description rdf:nodeID="N9ecc5b6609f0471c95a8b6140d88a4f2">
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/functions#BuiltInFunction"/>
              <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/functions#Concept"/>
            </owl:unionOf>
          </rdf:Description>
        </rdfs:domain>
        <rdfs:label>accepts_type</rdfs:label>
        <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#DataType"/>
        <rdfs:comment>Subject accepts or involves values of the object DataType as input. Used for BuiltInFunction callables and for pedagogical Concepts such as Function Input or Parameter.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#acceptedBy"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
    <rdfs:comment>Inverse of acceptsType.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/functions#constructUsedBy">
    <rdfs:label>construct_used_by</rdfs:label>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#ConceptCarrier"/>
    <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Algorithm"/>
    <rdfs:comment>Inverse of usesConstruct: this ConceptCarrier is employed by the object Algorithm. A-Box may assert only usesConstruct; reasoners can infer this direction.</rdfs:comment>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/functions#usesConstruct">
        <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Algorithm"/>
        <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#ConceptCarrier"/>
        <rdfs:comment>Algorithm is coded with / employs this ConceptCarrier (language construct, operator, builtin, or data type). Distinct from implementedBy (Concept → carrier realization). Inverse of constructUsedBy.</rdfs:comment>
        <rdfs:label>uses_construct</rdfs:label>
        <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#constructUsedBy"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/functions#E_FUNC04">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#ErrorType"/>
    <func:courseId>E_FUNC04</func:courseId>
    <rdfs:label>SyntaxError</rdfs:label>
    <func:definition>Raised when a function definition or call does not follow Python syntax rules.</func:definition>
    <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
