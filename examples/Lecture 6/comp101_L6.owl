  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#Pattern">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Pattern</rdfs:label>
    <rdfs:comment>A common loop or problem-solving pattern (e.g. Accumulator).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#skill_set_algebra">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Skill"/>
    <rdfs:label>Perform unions, intersections, differences</rdfs:label>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <requiresConcept rdf:resource="http://gnosis.local/ontologies/comp101#set_operations"/>
    <requiresConcept rdf:resource="http://gnosis.local/ontologies/comp101#set_union"/>
    <requiresConcept rdf:resource="http://gnosis.local/ontologies/comp101#set_intersection"/>
    <requiresConcept rdf:resource="http://gnosis.local/ontologies/comp101#set_difference"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#skill_compare_sets"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#raisedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#ErrorType"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label>raisedBy</rdfs:label>
    <owl:inverseOf rdf:resource="http://gnosis.local/ontologies/comp101#throwsError"/>
    <rdfs:comment>Inverse of throwsError: this error is raised by the given entity.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#enumerate_function">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#BuiltInFunction"/>
    <rdfs:label>enumerate()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <socraticQuestion>How can you loop over both index and value at the same time?</socraticQuestion>
    <sharedConcept rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sharedConcept>
    <canonicalId>core:enumerate</canonicalId>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yields (index, value) pairs when looping over an iterable.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W3_control"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#iteration"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#for_loop"/>
    <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#iteration"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#dict_items">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
    <rdfs:label>dict.items()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <returnsNone rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</returnsNone>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dynamic view of a dict’s (key, value) pairs.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#iteration"/>
    <methodOf rdf:resource="http://gnosis.local/ontologies/comp101#dict"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#dict_setdefault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#implementsConcept">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#ConceptCarrier"/>
    <rdfs:range rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>implementsConcept</rdfs:label>
    <rdfs:comment>Syntax-level coding of a concept (LanguageConstruct). BuiltInFunctions use usesConcept instead — do not attach implementsConcept to builtins.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#list_to_set">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>List-to-Set Conversion</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <socraticQuestion>You have a list with repeated names — how could a set help you get only the unique ones?</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Convert a list to a set to drop duplicates (order not preserved).</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#set"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#deduplication"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#dict_keys">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
    <rdfs:label>dict.keys()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <returnsNone rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</returnsNone>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dynamic view of a dict’s keys.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#iteration"/>
    <confusedWith rdf:resource="http://gnosis.local/ontologies/comp101#dict_values"/>
    <confusedWith rdf:resource="http://gnosis.local/ontologies/comp101#dict_items"/>
    <methodOf rdf:resource="http://gnosis.local/ontologies/comp101#dict"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#dict_values"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#dict">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#DataType"/>
    <rdfs:label>dict</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <socraticQuestion>Does a dictionary remember the order you added keys in? (Since Python 3.7 it does — but older tutorials and other languages often treat dicts as unordered.)</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <isOrdered rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isOrdered>
    <isMutable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isMutable>
    <isHashable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isHashable>
    <isIndexed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isIndexed>
    <isIterable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isIterable>
    <allowsDuplicates rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</allowsDuplicates>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mutable mapping from keys to values. Ordered by insertion since Python 3.7. The allowsDuplicates trait refers to keys (duplicate keys collapse); values may repeat.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#key_value_mapping"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#set"/>
    <confusedWith rdf:resource="http://gnosis.local/ontologies/comp101#set"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#tuples_as_keys">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Tuples as Dictionary Keys</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high</difficulty>
    <socraticQuestion>Why can a tuple be a dictionary key when a list cannot?</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using an immutable tuple as a dictionary key because it is hashable.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#key_immutability"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#deduplication">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Deduplication</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <socraticQuestion>You have a list with repeats — how could you keep each value only once?</socraticQuestion>
    <sharedConcept rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sharedConcept>
    <canonicalId>core:deduplication</canonicalId>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Removing repeated values, often via set conversion.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#dict_setdefault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
    <rdfs:label>dict.setdefault()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <socraticQuestion>What if you want to add a key only if it doesn't already exist?</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <returnsNone rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</returnsNone>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Returns the value for key if present; otherwise inserts key with default and returns default.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <bestPractice rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use for frequency counting: d.setdefault(word, 0) before incrementing.</bestPractice>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#dict"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#key_value_mapping"/>
    <methodOf rdf:resource="http://gnosis.local/ontologies/comp101#dict"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#ConceptCarrier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label>ConceptCarrier</rdfs:label>
    <rdfs:comment>Python surface that can implement or use curriculum concepts (syntax, methods, builtins). Groups LanguageConstruct with invokables for T-box connectivity.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#dict_pop">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
    <rdfs:label>dict.pop()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <returnsNone rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</returnsNone>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove a key and return its value; raises KeyError if absent (unless default given).</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <methodOf rdf:resource="http://gnosis.local/ontologies/comp101#dict"/>
    <throwsError rdf:resource="http://gnosis.local/ontologies/comp101#key_error"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#frozenset_issuperset_method">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
    <rdfs:label>frozenset.issuperset()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <returnsNone rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</returnsNone>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#superset"/>
    <producesType rdf:resource="http://gnosis.local/ontologies/comp101#bool"/>
    <methodOf rdf:resource="http://gnosis.local/ontologies/comp101#frozenset"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#skill_update_dict">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Skill"/>
    <rdfs:label>Add and modify dict entries</rdfs:label>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <requiresConcept rdf:resource="http://gnosis.local/ontologies/comp101#key_value_mapping"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#skill_delete_dict"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#frozenset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#DataType"/>
    <rdfs:label>frozenset</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <socraticQuestion>What if you needed a set that can never change — say, to use it as a dictionary key?</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <isOrdered rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isOrdered>
    <isMutable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isMutable>
    <isHashable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isHashable>
    <isIndexed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isIndexed>
    <isIterable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isIterable>
    <allowsDuplicates rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</allowsDuplicates>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Immutable hashable set; usable as a dict key or set element.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#Lecture">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label>Lecture</rdfs:label>
    <rdfs:comment>A week or unit in the course schedule.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#attribute_error">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#ErrorType"/>
    <rdfs:label>AttributeError</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Raised when an attribute or method reference fails on an object.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand</cognitiveType>
    <commonCauses rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Calling a method that does not exist on that type (e.g. dict.remove) or reading a missing attribute.</commonCauses>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#set_issuperset_method">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
    <rdfs:label>set.issuperset()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <returnsNone rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</returnsNone>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Test whether this set is a superset of another.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#superset"/>
    <producesType rdf:resource="http://gnosis.local/ontologies/comp101#bool"/>
    <methodOf rdf:resource="http://gnosis.local/ontologies/comp101#set"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#W12_systems">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Lecture"/>
    <rdfs:label>Week 12 — Computer Systems (placeholder; owned by another module)</rdfs:label>
    <canonicalId>course:W12</canonicalId>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#W8_sorting"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#methodOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label>methodOf</rdfs:label>
    <rdfs:comment>A method belongs to a type or class. Range widened to owl:Thing to also cover user-defined classes in the OOP module.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#subset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Subset</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <socraticQuestion>How would you check if every element of A is also in B?</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every element of A is also in B (A ⊆ B).</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <confusedWith rdf:resource="http://gnosis.local/ontologies/comp101#superset"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#set"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#set">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#DataType"/>
    <rdfs:label>set</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <socraticQuestion>What happens if you add the same value to a set twice? If you needed unique usernames where order does not matter, which type would you reach for?</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <isOrdered rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isOrdered>
    <isMutable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isMutable>
    <isHashable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isHashable>
    <isIndexed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isIndexed>
    <isIterable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isIterable>
    <allowsDuplicates rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</allowsDuplicates>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unordered mutable collection of unique hashable elements.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#hashing"/>
    <confusedWith rdf:resource="http://gnosis.local/ontologies/comp101#frozenset"/>
    <confusedWith rdf:resource="http://gnosis.local/ontologies/comp101#dict"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#frozenset"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#time_complexity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#set_difference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Set Difference</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <socraticQuestion>How would you find items in A that are not in B?</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Elements in A but not B (A − B).</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#set_operations"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#dict_default_iteration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Dict Default Iteration (keys)</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <socraticQuestion>What does for x in d give you — keys, values, or pairs?</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Iterating a dict directly yields its keys, not values or key-value pairs.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#iteration"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#dict"/>
    <confusedWith rdf:resource="http://gnosis.local/ontologies/comp101#dict_keys"/>
    <confusedWith rdf:resource="http://gnosis.local/ontologies/comp101#dict_values"/>
    <confusedWith rdf:resource="http://gnosis.local/ontologies/comp101#dict_items"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#dict_keys"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#set_issubset_method">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
    <rdfs:label>set.issubset()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <returnsNone rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</returnsNone>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Test whether this set is a subset of another.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#subset"/>
    <producesType rdf:resource="http://gnosis.local/ontologies/comp101#bool"/>
    <methodOf rdf:resource="http://gnosis.local/ontologies/comp101#set"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#frozenset_issubset_method">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
    <rdfs:label>frozenset.issubset()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <returnsNone rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</returnsNone>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#subset"/>
    <producesType rdf:resource="http://gnosis.local/ontologies/comp101#bool"/>
    <methodOf rdf:resource="http://gnosis.local/ontologies/comp101#frozenset"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#nested_dicts">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Nested Dictionaries</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <socraticQuestion>If a value in a dict is itself a dict, how would you reach an inner value?</socraticQuestion>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#dict"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#key_value_mapping"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#set_union_method">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
    <rdfs:label>set.union()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <returnsNone rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</returnsNone>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Method form of set union (also available via |).</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#set_union"/>
    <producesType rdf:resource="http://gnosis.local/ontologies/comp101#set"/>
    <methodOf rdf:resource="http://gnosis.local/ontologies/comp101#set"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#set_intersection_method"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#set_add_method">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
    <rdfs:label>set.add()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <returnsNone rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</returnsNone>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Insert one element into a set (no-op if already present).</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <methodOf rdf:resource="http://gnosis.local/ontologies/comp101#set"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#set_discard_method"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#str_split">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
    <rdfs:label>str.split()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <socraticQuestion>How do you turn a sentence into a list of words?</socraticQuestion>
    <sharedConcept rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sharedConcept>
    <canonicalId>core:str_split</canonicalId>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <returnsNone rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</returnsNone>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Split a string into a list of substrings by a separator.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <methodOf rdf:resource="http://gnosis.local/ontologies/comp101#str"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#difficulty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>difficulty</rdfs:label>
    <rdfs:comment>Author pacing hint. Enum: difficulty (low | medium | high). Enum difficulty: low | medium | high.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#cognitiveType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>cognitiveType</rdfs:label>
    <rdfs:comment>Bloom cognitive level. Enum: cognitive_type (remember | understand | apply | analyze | evaluate | create); short aliases rem/und/app/ana/eva/cre accepted in CI. Enum cognitive_type: remember | understand | apply | analyze | evaluate | create.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#set_discard_method">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
    <rdfs:label>set.discard()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <returnsNone rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</returnsNone>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove an element if present; does not raise if missing.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <confusedWith rdf:resource="http://gnosis.local/ontologies/comp101#set_remove_method"/>
    <methodOf rdf:resource="http://gnosis.local/ontologies/comp101#set"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#range_function">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#BuiltInFunction"/>
    <rdfs:label>range()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <socraticQuestion>How would you write a loop that runs exactly n times without building a list of numbers?</socraticQuestion>
    <sharedConcept rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sharedConcept>
    <canonicalId>core:range</canonicalId>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Produces an immutable sequence of integers; common in for i in range(len(lst)).</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W3_control"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#iteration"/>
    <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#iteration"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#skill_count_with_dict">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Skill"/>
    <rdfs:label>Count frequencies with a dict</rdfs:label>
    <socraticQuestion>How would you count how many times each word appears using a dict?</socraticQuestion>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <requiresConcept rdf:resource="http://gnosis.local/ontologies/comp101#key_value_mapping"/>
    <requiresConcept rdf:resource="http://gnosis.local/ontologies/comp101#iteration"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#skill_comprehend_dict"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#set_difference_method">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
    <rdfs:label>set.difference()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <returnsNone rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</returnsNone>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Method form of set difference (also available via -).</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#set_difference"/>
    <producesType rdf:resource="http://gnosis.local/ontologies/comp101#set"/>
    <methodOf rdf:resource="http://gnosis.local/ontologies/comp101#set"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#dict_comprehension">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Dictionary Comprehension</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high</difficulty>
    <socraticQuestion>Could you build a dict in one line the way you build a list with a comprehension?</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Building a new dict with {k: v for ...} syntax.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#key_value_mapping"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#Invokable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://gnosis.local/ontologies/comp101#ConceptCarrier"/>
    <rdfs:label>Invokable</rdfs:label>
    <rdfs:comment>Callable Python API: type-bound methods and global built-in functions.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#revisitedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://gnosis.local/ontologies/comp101#Lecture"/>
    <rdfs:label>revisitedIn</rdfs:label>
    <rdfs:comment>Week where a concept introduced earlier is reinforced in a new context — not first taught here.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#set_intersection_method">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
    <rdfs:label>set.intersection()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <returnsNone rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</returnsNone>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Method form of set intersection (also available via &amp;).</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#set_intersection"/>
    <producesType rdf:resource="http://gnosis.local/ontologies/comp101#set"/>
    <methodOf rdf:resource="http://gnosis.local/ontologies/comp101#set"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#set_difference_method"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#enables">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label>enables</rdfs:label>
    <owl:inverseOf rdf:resource="http://gnosis.local/ontologies/comp101#dependsOn"/>
    <rdfs:comment>Inverse of dependsOn: the source is a prerequisite that enables the target.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#key_value_pair">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Key-Value Pair</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <socraticQuestion>What are the two halves of a single dictionary entry?</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">One (key, value) entry in a mapping.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#key"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#key_error"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#usesConcept">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#ConceptCarrier"/>
    <rdfs:range rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>usesConcept</rdfs:label>
    <rdfs:comment>A method, construct, or built-in function relies on / carries out a concept or abstract operation (create, access, remove, ...). Shared name with the OOP module (replaces the earlier performsOperation).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#W6_dicts_sets">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Lecture"/>
    <rdfs:label>Week 6 — Data Structures: Dictionaries and Sets</rdfs:label>
    <canonicalId>course:W6</canonicalId>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Week 6 unit: dictionaries, sets, hashing, and structure selection.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand</cognitiveType>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#set_remove_method">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
    <rdfs:label>set.remove()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <returnsNone rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</returnsNone>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove an element; raises KeyError if missing.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <methodOf rdf:resource="http://gnosis.local/ontologies/comp101#set"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#set_union_method"/>
    <throwsError rdf:resource="http://gnosis.local/ontologies/comp101#key_error"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#set_intersection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Set Intersection</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <socraticQuestion>Given two sets, how would you keep only the items they share?</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Elements in both sets (A ∩ B).</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#set_operations"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#counter_pattern">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Pattern"/>
    <rdfs:label>Counter Pattern</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <socraticQuestion>How would you count how many items match a condition?</socraticQuestion>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W3_control"/>
    <revisitedIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#iteration"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#commonCauses">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#ErrorType"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>commonCauses</rdfs:label>
    <rdfs:comment>Typical student mistakes that trigger this error, to seed remediation (shared pedagogy metadata; from the OOP module).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#skill_iterate_dict">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Skill"/>
    <rdfs:label>Iterate keys, values, and items</rdfs:label>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <requiresConcept rdf:resource="http://gnosis.local/ontologies/comp101#iteration"/>
    <requiresConcept rdf:resource="http://gnosis.local/ontologies/comp101#key_value_pair"/>
    <requiresConcept rdf:resource="http://gnosis.local/ontologies/comp101#dict_default_iteration"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#skill_update_dict"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#skill_count_with_dict"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#isHashable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#DataType"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label>isHashable</rdfs:label>
    <rdfs:comment>Whether instances can be used as dict keys or set members. For tuple, this intro-level facet is true only when every element is itself hashable.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#producesType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#Invokable"/>
    <rdfs:range rdf:resource="http://gnosis.local/ontologies/comp101#DataType"/>
    <rdfs:label>producesType</rdfs:label>
    <rdfs:comment>The data type a method or built-in function returns (adopted from the OOP module; richer than the returnsNone boolean, which is kept as a shortcut).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#definition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>definition</rdfs:label>
    <rdfs:comment>Short plain-language definition of the entity (shared pedagogy metadata; from the OOP module).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#time_complexity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Time Complexity of Operations</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high</difficulty>
    <socraticQuestion>Why might checking whether an item is in a set be faster than checking a list?</socraticQuestion>
    <sharedConcept rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sharedConcept>
    <canonicalId>core:time_complexity</canonicalId>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">How the cost of an operation grows with collection size; list membership scans all elements, dict/set lookup is typically constant time on average.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyze</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#data_structure_selection"/>
    <revisitedIn rdf:resource="http://gnosis.local/ontologies/comp101#W8_sorting"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#ErrorType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label>ErrorType</rdfs:label>
    <rdfs:comment>An exception students may encounter (e.g. IndexError).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#frozenset_symmetric_difference_method">
