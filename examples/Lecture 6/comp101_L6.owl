    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
    <rdfs:label>frozenset.symmetric_difference()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <returnsNone rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</returnsNone>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#symmetric_difference"/>
    <producesType rdf:resource="http://gnosis.local/ontologies/comp101#frozenset"/>
    <methodOf rdf:resource="http://gnosis.local/ontologies/comp101#frozenset"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#isUsedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:range rdf:resource="http://gnosis.local/ontologies/comp101#ConceptCarrier"/>
    <rdfs:label>isUsedBy</rdfs:label>
    <owl:inverseOf rdf:resource="http://gnosis.local/ontologies/comp101#usesConcept"/>
    <rdfs:comment>Inverse of usesConcept: this concept/operation is used by the given method, construct, or built-in function.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#implementedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
