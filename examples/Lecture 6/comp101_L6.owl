  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#intersection_operator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#LanguageConstruct"/>
    <rdfs:label>&amp; (intersection operator)</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <implementsConcept rdf:resource="http://gnosis.local/ontologies/comp101#set_intersection"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#recommendedBefore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label>recommendedBefore</rdfs:label>
    <rdfs:comment>Soft order among sibling peers when PATH / dependsOn do not already decide which to introduce first (a teaching dilemma). NOT the tutor spine — that total order is only in comp101_path_w5_w6.json (/path/next). Do not sprinkle on every consecutive PATH pair; skip when traversal order is already determined. Distinct from dependsOn (strict readiness) and confusedWith (student mix-ups).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#set_union">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Set Union</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <socraticQuestion>If A = {1,2} and B = {2,3}, what is everything that appears in either set?</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Elements in either set (A ∪ B).</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#set_operations"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#dict_get">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
    <rdfs:label>dict.get()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <returnsNone rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</returnsNone>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Safe dict lookup that returns a default instead of raising KeyError.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <bestPractice rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Prefer dict.get(key, default) over direct subscript when key presence is uncertain.</bestPractice>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <methodOf rdf:resource="http://gnosis.local/ontologies/comp101#dict"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#dict_default_iteration"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#key_value_mapping">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Key-Value Mapping</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <socraticQuestion>If each value has a label you look it up by, what kind of structure is that?</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Association of unique keys to values (the dict abstraction).</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#data_structure_selection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Data Structure Selection</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high</difficulty>
    <socraticQuestion>Given a problem, which structure would you choose — list, tuple, dict, or set — and why?</socraticQuestion>
    <sharedConcept rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sharedConcept>
    <canonicalId>core:data_structure_selection</canonicalId>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Choosing among list, tuple, dict, and set based on order, mutability, uniqueness, keyed lookup, and operation cost.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluate</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#time_complexity"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#dict"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#set"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#superset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Superset</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <socraticQuestion>How would you check if A contains all of B's elements?</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every element of B is also in A (A ⊇ B).</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#set"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#empty_brace_ambiguity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Empty Brace Ambiguity</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <socraticQuestion>What does {} create — an empty dict or an empty set?</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In Python, {} is always an empty dict; an empty set requires set().</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#dict"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#set"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#key_immutability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Key Immutability</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high</difficulty>
    <socraticQuestion>Why can you use a string or tuple as a dict key, but not a list?</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dict keys and set elements must not change while stored; typically hashable immutables.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyze</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#Concept">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label>Concept</rdfs:label>
    <rdfs:comment>An idea to understand, not a keyword (e.g. Indexing).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#teaches">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#Lecture"/>
