    <isHashable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isHashable>
    <isIndexed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isIndexed>
    <isIterable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isIterable>
    <allowsDuplicates rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</allowsDuplicates>
