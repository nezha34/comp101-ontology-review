    <rdfs:label>implementedBy</rdfs:label>
    <owl:inverseOf rdf:resource="http://gnosis.local/ontologies/comp101#implementsConcept"/>
    <rdfs:comment>Inverse of implementsConcept: a concept is coded by this language construct, method, or built-in.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#frozenset_intersection_method">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
    <rdfs:label>frozenset.intersection()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <returnsNone rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</returnsNone>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#set_intersection"/>
    <producesType rdf:resource="http://gnosis.local/ontologies/comp101#frozenset"/>
    <methodOf rdf:resource="http://gnosis.local/ontologies/comp101#frozenset"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#isMutable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#DataType"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label>isMutable</rdfs:label>
    <rdfs:comment>Whether the type can be changed in place after creation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#set_copy_method">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
    <rdfs:label>set.copy()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <returnsNone rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</returnsNone>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shallow copy of a set.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <producesType rdf:resource="http://gnosis.local/ontologies/comp101#set"/>
    <methodOf rdf:resource="http://gnosis.local/ontologies/comp101#set"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#for_loop">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#LanguageConstruct"/>
    <rdfs:label>for loop</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Syntax that iterates over an iterable, binding each element in turn.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W3_control"/>
    <implementsConcept rdf:resource="http://gnosis.local/ontologies/comp101#iteration"/>
  </rdf:Description>
