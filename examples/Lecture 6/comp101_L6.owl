  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#skill_dedupe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Skill"/>
    <rdfs:label>Remove duplicates with a set</rdfs:label>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    <requiresConcept rdf:resource="http://gnosis.local/ontologies/comp101#deduplication"/>
