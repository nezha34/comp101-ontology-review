  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/functions#LC_FUNC01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#LanguageConstruct"/>
    <func:courseId>LC_FUNC01</func:courseId>
    <rdfs:label>def</rdfs:label>
    <func:definition>Defines a new function by specifying its name, optional parameters and body.</func:definition>
    <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/functions#producesType">
    <rdfs:comment>Returns this data type.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label>produces_type</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#isProducedBy"/>
    <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#DataType"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Concept"/>
    <func:courseId>C_FUNC01</func:courseId>
    <rdfs:label>Function</rdfs:label>
    <func:definition>A reusable named block of code that performs a specific task. A function may receive inputs through parameters and optionally return a result.</func:definition>
    <func:cognitiveType>conceptual</func:cognitiveType>
    <func:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#LC_FUNC01"/>
    <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC14">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Concept"/>
    <func:courseId>C_FUNC14</func:courseId>
    <rdfs:label>Placeholder Implementation</rdfs:label>
    <func:definition>A temporary function implementation used while designing a program. The pass statement allows the function to exist before its logic has been written.</func:definition>
    <func:cognitiveType>procedural</func:cognitiveType>
    <func:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#LC_FUNC03"/>
    <func:bestPractice>Use pass only while incrementally developing a program and replace it with a real implementation as soon as possible.</func:bestPractice>
    <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/functions#Operator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Operator</rdfs:label>
    <rdfs:comment>A Python operator.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#ConceptCarrier"/>
