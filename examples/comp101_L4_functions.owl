    <func:courseId>A_FUNC01</func:courseId>
    <rdfs:label>Quadratic Root Classification</rdfs:label>
    <func:definition>Determines the number of real roots of a quadratic equation by decomposing the solution into reusable functions.</func:definition>
    <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC01"/>
    <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC11"/>
    <func:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC07"/>
