  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC15">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Concept"/>
    <func:courseId>C_FUNC15</func:courseId>
    <rdfs:label>Function Interface</rdfs:label>
    <func:definition>The externally visible part of a function consisting of its name, expected parameters and returned value. The interface determines how other parts of the program interact with the function.</func:definition>
    <func:cognitiveType>conceptual</func:cognitiveType>
    <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC02"/>
    <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC05"/>
    <func:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#C_FUNC07"/>
    <func:bestPractice>Keep function interfaces simple and easy to understand.</func:bestPractice>
    <func:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#L04"/>
  </rdf:Description>
