    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/functions#Concept"/>
    <func:courseId>C_FUNC11</func:courseId>
    <rdfs:label>Problem Decomposition</rdfs:label>
    <func:definition>Breaking a larger programming task into smaller reusable functions that each perform a single responsibility.</func:definition>
