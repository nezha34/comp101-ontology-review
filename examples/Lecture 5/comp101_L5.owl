  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#isOrdered">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#DataType"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label>isOrdered</rdfs:label>
    <rdfs:comment>Whether the type preserves a positional order of elements.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#tuple_index">
