  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#tuple">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#DataType"/>
    <rdfs:label>tuple</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <socraticQuestion>How is a tuple different from a list once it is created?</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <isOrdered rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isOrdered>
    <isMutable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isMutable>
    <isHashable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isHashable>
    <isIndexed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isIndexed>
    <isIterable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isIterable>
    <allowsDuplicates rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</allowsDuplicates>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ordered immutable sequence. The isHashable trait is an intro approximation: a tuple is usable as a dict key or set member only when all of its elements are hashable (e.g. a tuple containing a list is not).</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#sequence"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#type_error"/>
    <confusedWith rdf:resource="http://gnosis.local/ontologies/comp101#list"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#op_clear">
