    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Recursively copy nested structures so nothing is shared with the original.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyze</cognitiveType>
