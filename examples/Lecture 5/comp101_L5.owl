    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <socraticQuestion>x = mylist.sort() — what is x afterwards, and why?</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <returnsNone rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</returnsNone>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sort a list in place; returns None (contrast sorted()).</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
    <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#op_update"/>
    <confusedWith rdf:resource="http://gnosis.local/ontologies/comp101#sorted_function"/>
    <methodOf rdf:resource="http://gnosis.local/ontologies/comp101#list"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#repetition_operator">
