  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#iteration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Iteration</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <socraticQuestion>How would you do something to every item in a list?</socraticQuestion>
    <sharedConcept rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sharedConcept>
    <canonicalId>core:iteration</canonicalId>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Repeatedly processing each element of an iterable.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W3_control"/>
    <revisitedIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#type_error">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#ErrorType"/>
    <rdfs:label>TypeError</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Raised when an operation is applied to an object of inappropriate type.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand</cognitiveType>
    <commonCauses rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wrong operation for the type: indexing a set, assigning to a tuple element, or using an unhashable key in a dict or set.</commonCauses>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#onPath">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label>onPath</rdfs:label>
    <rdfs:comment>True when this individual is a step on the authored W5–W6 PATH spine (comp101_path_w5_w6.json). Off-path entities remain available for skills, remediation, and on-demand tutoring.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#del_statement">
