  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#list_index">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
    <rdfs:label>list.index()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <socraticQuestion>What happens if you call list.index(x) when x is not in the list?</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <returnsNone rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</returnsNone>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Return the index of the first matching value; raises ValueError if missing.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
    <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#op_search"/>
    <producesType rdf:resource="http://gnosis.local/ontologies/comp101#int"/>
    <methodOf rdf:resource="http://gnosis.local/ontologies/comp101#list"/>
    <throwsError rdf:resource="http://gnosis.local/ontologies/comp101#value_error"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#list_reverse"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#concatenation_operator">
