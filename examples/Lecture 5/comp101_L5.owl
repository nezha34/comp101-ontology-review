  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#zero_based_indexing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Zero-based Indexing</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <socraticQuestion>A list has 5 items — what is the index of the first one? And the last one?</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The first element is at index 0; the last is at len(x)-1.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#indexing"/>
    <confusedWith rdf:resource="http://gnosis.local/ontologies/comp101#negative_indexing"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#negative_indexing"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#isIndexed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#DataType"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label>isIndexed</rdfs:label>
    <rdfs:comment>Whether elements are accessed by integer position.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#confusedWith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label>confusedWith</rdfs:label>
    <rdfs:comment>Two entities students often confuse and should explicitly distinguish (e.g. list vs tuple, set.discard vs set.remove). Symmetric. COMP101-specific name: OOP keeps contrastsWith for opposites/alternatives/confused concepts (Concept↔Concept).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#concatenation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Concatenation</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <socraticQuestion>How would you join two lists into one with +?</socraticQuestion>
    <sharedConcept rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sharedConcept>
    <canonicalId>core:concatenation</canonicalId>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#sequence"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#sequence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Sequence</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <socraticQuestion>If a collection keeps its items in order, how would you get the third one?</socraticQuestion>
    <sharedConcept rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sharedConcept>
    <canonicalId>core:sequence</canonicalId>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An ordered collection whose elements are addressed by position.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#collection"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#list_remove">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
    <rdfs:label>list.remove()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <returnsNone rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</returnsNone>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the first matching value (in-place); raises if missing.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
    <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#op_remove"/>
    <confusedWith rdf:resource="http://gnosis.local/ontologies/comp101#list_pop"/>
    <methodOf rdf:resource="http://gnosis.local/ontologies/comp101#list"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#list_pop"/>
    <throwsError rdf:resource="http://gnosis.local/ontologies/comp101#value_error"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#slicing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Slicing</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <socraticQuestion>What does items[1:3] include on a list — and does it include index 3? Does the same slice work on a string?</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Taking a contiguous subsequence by start:stop indices (e.g. items[1:3] on a list). The same syntax works on strings; introduce on lists in W5 and contrast with str.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#indexing"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#zero_based_indexing"/>
    <confusedWith rdf:resource="http://gnosis.local/ontologies/comp101#str"/>
  </rdf:Description>
