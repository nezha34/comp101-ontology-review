  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#skill_remove_elements">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Skill"/>
    <rdfs:label>Remove elements</rdfs:label>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
    <requiresConcept rdf:resource="http://gnosis.local/ontologies/comp101#op_remove"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#skill_find_and_count"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#len_function">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#BuiltInFunction"/>
    <rdfs:label>len()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <socraticQuestion>Which single built-in gives you the size of a list, a string, a dict, or a set?</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Built-in that returns the number of items in a collection.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#length"/>
    <producesType rdf:resource="http://gnosis.local/ontologies/comp101#int"/>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#list_clear">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
    <rdfs:label>list.clear()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <returnsNone rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</returnsNone>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove all elements from a list (in-place).</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
    <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#op_clear"/>
    <methodOf rdf:resource="http://gnosis.local/ontologies/comp101#list"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#op_remove">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Remove (operation)</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <socraticQuestion>How is removing a value different from looking it up?</socraticQuestion>
    <sharedConcept rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sharedConcept>
    <canonicalId>core:op_remove</canonicalId>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Abstract operation: delete an element from a collection.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#str_split">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
    <rdfs:label>str.split()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <socraticQuestion>How do you turn a sentence into a list of words?</socraticQuestion>
    <sharedConcept rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sharedConcept>
    <canonicalId>core:str_split</canonicalId>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <returnsNone rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</returnsNone>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Split a string into a list of substrings by a separator.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <revisitedIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
    <producesType rdf:resource="http://gnosis.local/ontologies/comp101#list"/>
    <confusedWith rdf:resource="http://gnosis.local/ontologies/comp101#str_join"/>
    <methodOf rdf:resource="http://gnosis.local/ontologies/comp101#str"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#cognitiveType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>cognitiveType</rdfs:label>
    <rdfs:comment>Bloom cognitive level. Enum: cognitive_type (remember | understand | apply | analyze | evaluate | create); short aliases rem/und/app/ana/eva/cre accepted in CI. Enum cognitive_type: remember | understand | apply | analyze | evaluate | create.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#difficulty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>difficulty</rdfs:label>
    <rdfs:comment>Author pacing hint. Enum: difficulty (low | medium | high). Enum difficulty: low | medium | high.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#range_function">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#BuiltInFunction"/>
    <rdfs:label>range()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <socraticQuestion>How would you write a loop that runs exactly n times without building a list of numbers?</socraticQuestion>
    <sharedConcept rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sharedConcept>
    <canonicalId>core:range</canonicalId>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Produces an immutable sequence of integers; common in for i in range(len(lst)).</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W3_control"/>
    <revisitedIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#iteration"/>
    <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#iteration"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#list_literal_syntax">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#LanguageConstruct"/>
    <rdfs:label>[] list literal</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
    <implementsConcept rdf:resource="http://gnosis.local/ontologies/comp101#list_creation"/>
    <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#op_create"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#Invokable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://gnosis.local/ontologies/comp101#ConceptCarrier"/>
    <rdfs:label>Invokable</rdfs:label>
    <rdfs:comment>Callable Python API: type-bound methods and global built-in functions.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#W5_lists">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Lecture"/>
    <rdfs:label>Week 5 — Data Structures: Lists and Tuples</rdfs:label>
    <canonicalId>course:W5</canonicalId>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Week 5 unit: lists, tuples, and sequence operations.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand</cognitiveType>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#W4_functions"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#list_extend">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
    <rdfs:label>list.extend()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <returnsNone rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</returnsNone>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Append all elements from another iterable (in-place).</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
    <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#op_combine"/>
    <methodOf rdf:resource="http://gnosis.local/ontologies/comp101#list"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#list_remove"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#revisitedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://gnosis.local/ontologies/comp101#Lecture"/>
    <rdfs:label>revisitedIn</rdfs:label>
    <rdfs:comment>Week where a concept introduced earlier is reinforced in a new context — not first taught here.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#enables">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label>enables</rdfs:label>
    <owl:inverseOf rdf:resource="http://gnosis.local/ontologies/comp101#dependsOn"/>
    <rdfs:comment>Inverse of dependsOn: the source is a prerequisite that enables the target.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#usesConcept">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#ConceptCarrier"/>
    <rdfs:range rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>usesConcept</rdfs:label>
    <rdfs:comment>A method, construct, or built-in function relies on / carries out a concept or abstract operation (create, access, remove, ...). Shared name with the OOP module (replaces the earlier performsOperation).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#op_update">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Update (operation)</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <socraticQuestion>Once a collection exists, how do you change one of the values it already holds?</socraticQuestion>
    <sharedConcept rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sharedConcept>
    <canonicalId>core:op_update</canonicalId>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Abstract operation: change an existing element or mapping entry in place.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#nested_lists">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Nested Lists</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <socraticQuestion>If a list holds other lists, how would you reach an item inside the inner list?</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lists whose elements are themselves lists; need multiple indices.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#list"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#indexing"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#container">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Container</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <socraticQuestion>What does it mean to ask whether something is 'in' a collection?</socraticQuestion>
    <sharedConcept rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sharedConcept>
    <canonicalId>core:container</canonicalId>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A collection that supports membership tests (x in c).</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#collection"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#counter_pattern">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Pattern"/>
    <rdfs:label>Counter Pattern</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <socraticQuestion>How would you count how many items match a condition?</socraticQuestion>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W3_control"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#iteration"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#commonCauses">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#ErrorType"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>commonCauses</rdfs:label>
    <rdfs:comment>Typical student mistakes that trigger this error, to seed remediation (shared pedagogy metadata; from the OOP module).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#nested_tuples">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Nested Tuples</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <socraticQuestion>If a tuple holds other tuples, how would you reach an inner value?</socraticQuestion>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#tuple"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#producesType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#Invokable"/>
    <rdfs:range rdf:resource="http://gnosis.local/ontologies/comp101#DataType"/>
    <rdfs:label>producesType</rdfs:label>
    <rdfs:comment>The data type a method or built-in function returns (adopted from the OOP module; richer than the returnsNone boolean, which is kept as a shortcut).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#isHashable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#DataType"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label>isHashable</rdfs:label>
    <rdfs:comment>Whether instances can be used as dict keys or set members. For tuple, this intro-level facet is true only when every element is itself hashable.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#definition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>definition</rdfs:label>
    <rdfs:comment>Short plain-language definition of the entity (shared pedagogy metadata; from the OOP module).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#list_copy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
    <rdfs:label>list.copy()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <returnsNone rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</returnsNone>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Create a shallow copy of a list (new outer list, shared inners).</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
    <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#op_copy"/>
    <producesType rdf:resource="http://gnosis.local/ontologies/comp101#list"/>
    <methodOf rdf:resource="http://gnosis.local/ontologies/comp101#list"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#ErrorType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label>ErrorType</rdfs:label>
    <rdfs:comment>An exception students may encounter (e.g. IndexError).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#tuple_unpacking">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Tuple Unpacking</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <socraticQuestion>How could you assign a, b = (1, 2) in a single line?</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Assigning tuple (or sequence) elements to multiple names in one statement; lengths must match.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#tuple_packing"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#skill_traverse_list">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Skill"/>
    <rdfs:label>Traverse a list</rdfs:label>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
    <requiresConcept rdf:resource="http://gnosis.local/ontologies/comp101#iteration"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#skill_modify_list"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#runtime_error">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#ErrorType"/>
    <rdfs:label>RuntimeError</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Raised for errors that do not fall into other categories — often “collection changed size during iteration”.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand</cognitiveType>
    <commonCauses rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Changing a dict or set’s size while iterating over it.</commonCauses>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#aliasing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Aliasing (references)</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high</difficulty>
    <socraticQuestion>If b = a and you append to b, what happens to a?</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Two names referring to the same object in memory; mutation through one name affects the other.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#mutability"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#list_sort"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#isUsedBy">
