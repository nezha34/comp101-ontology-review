    <implementsConcept rdf:resource="http://gnosis.local/ontologies/comp101#concatenation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#sort_vs_sorted">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>sort() vs sorted()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
    <socraticQuestion>What does list.sort() return? What about sorted(list)?</socraticQuestion>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#mutability"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#skill_copy_list">
