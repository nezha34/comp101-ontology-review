  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#element">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Element</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <socraticQuestion>When several values sit together as a group, what do we call one of those values?</socraticQuestion>
    <sharedConcept rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sharedConcept>
    <canonicalId>core:element</canonicalId>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A single item stored inside a collection.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#list_insert">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
    <rdfs:label>list.insert()</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <returnsNone rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</returnsNone>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Insert an element at a given index (in-place).</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
    <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#op_insert"/>
    <methodOf rdf:resource="http://gnosis.local/ontologies/comp101#list"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#list_extend"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#list">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#DataType"/>
    <rdfs:label>list</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <socraticQuestion>How could you store several values under a single name?</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <isOrdered rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isOrdered>
    <isMutable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isMutable>
    <isHashable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isHashable>
    <isIndexed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isIndexed>
    <isIterable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isIterable>
    <allowsDuplicates rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</allowsDuplicates>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mutable ordered sequence that allows duplicates and integer indexing.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#sequence"/>
    <confusedWith rdf:resource="http://gnosis.local/ontologies/comp101#tuple"/>
    <confusedWith rdf:resource="http://gnosis.local/ontologies/comp101#str"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#tuple"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#list_comprehension"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#requiredBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:range rdf:resource="http://gnosis.local/ontologies/comp101#Skill"/>
    <rdfs:label>requiredBy</rdfs:label>
    <owl:inverseOf rdf:resource="http://gnosis.local/ontologies/comp101#requiresConcept"/>
    <rdfs:comment>Inverse of requiresConcept: this concept is required by the given skill.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#throwsError">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://gnosis.local/ontologies/comp101#ErrorType"/>
    <rdfs:label>throwsError</rdfs:label>
    <rdfs:comment>An operation/construct can raise this error type. Prefer Method, BuiltInFunction, or LanguageConstruct carriers — not bare DataType nodes.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#W2_python">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Lecture"/>
    <rdfs:label>Week 2 — Intro to Python (placeholder; owned by another module)</rdfs:label>
    <canonicalId>course:W2</canonicalId>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#indexing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Indexing</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
    <socraticQuestion>How would you get just one item out of a list?</socraticQuestion>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Accessing an element by its integer position.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand</cognitiveType>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
    <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#sequence"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#mutability"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#allowsDuplicates">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#DataType"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label>allowsDuplicates</rdfs:label>
    <rdfs:comment>Whether the type may contain repeated elements. For dict this means duplicate *keys* are not retained (last assignment wins); values may still repeat.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#dependsOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label>dependsOn</rdfs:label>
    <rdfs:comment>Strict prerequisite: the source should be learned after the target. Transitive, so prerequisite chains close automatically (adopted from the OOP T-Box).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#mutability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
    <rdfs:label>Mutability</rdfs:label>
    <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high</difficulty>
    <socraticQuestion>After you change a list inside a function, is the original list changed too?</socraticQuestion>
    <sharedConcept rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sharedConcept>
    <canonicalId>core:mutability</canonicalId>
    <onPath rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</onPath>
    <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Whether a value can be changed in place after creation; lists are mutable, tuples and strings are not.</definition>
    <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand</cognitiveType>
    <bestPractice rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Teach mutability as theory before practice: establish that some values can change in place (lists) and others cannot (tuples, strings), then introduce append/pop so students see that theory in concrete mutations.</bestPractice>
    <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
    <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#list_append"/>
  </rdf:Description>
