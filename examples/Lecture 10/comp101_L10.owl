      </owl:NamedIndividual>
    </oop:producesType>
    <oop:throwsError>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#E_OOP_TYPE">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#ErrorType"/>
        <rdfs:label>TypeError</rdfs:label>
        <oop:courseId>E_OOP_TYPE</oop:courseId>
        <oop:definition>Raised when wrong number of arguments passed to __init__, or incompatible types used in an operation.</oop:definition>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:commonCauses>Calling a constructor or method with the wrong number/type of arguments; a dunder method returning the wrong type (e.g. __str__ returning None); instantiating a class directly that still has unimplemented abstract methods.</oop:commonCauses>
        <oop:isThrownBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP06"/>
        <oop:isThrownBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MOOP005"/>
        <oop:isThrownBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MOOP002"/>
