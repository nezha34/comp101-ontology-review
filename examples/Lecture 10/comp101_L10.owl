      <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/oop#hasExample">
        <rdfs:label>has_example</rdfs:label>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#exampleOf"/>
        <rdfs:comment>Inverse of example_of — this concept has the linked entity as a named exemplar</rdfs:comment>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/oop#DesignAbstraction">
    <rdfs:label>DesignAbstraction</rdfs:label>
    <rdfs:comment>A language-agnostic design vocabulary item</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/oop#throwsError">
    <rdfs:label>throws_error</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#ErrorType"/>
    <rdfs:comment>Misuse causes this error</rdfs:comment>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/oop#isThrownBy">
        <rdfs:label>is_thrown_by</rdfs:label>
        <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#ErrorType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#throwsError"/>
        <rdfs:comment>Inverse of throws_error — this error is thrown by a concept or mechanism</rdfs:comment>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/oop#BuiltInFunction">
    <rdfs:label>BuiltInFunction</rdfs:label>
    <rdfs:comment>A native Python function</rdfs:comment>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#COOP002">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
    <rdfs:label>Object</rdfs:label>
    <oop:courseId>COOP002</oop:courseId>
    <oop:definition>An instance of a class — the actual thing created from the blueprint. Each object has its own copy of instance attributes.</oop:definition>
    <oop:cognitiveType>conceptual</oop:cognitiveType>
    <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP001"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:isRequiredBy>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#COOP_OBJ_ID">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
        <rdfs:label>Object Identity</rdfs:label>
        <oop:courseId>COOP_OBJ_ID</oop:courseId>
        <oop:definition>The distinction between two objects being the same object in memory (is) versus having equal value (==). Without __eq__, == compares identity.</oop:definition>
        <oop:cognitiveType>conceptual</oop:cognitiveType>
        <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP002"/>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MOOP004"/>
      </owl:NamedIndividual>
    </oop:isRequiredBy>
    <oop:hasPart rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#CM_OOP01"/>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/oop#teaches">
    <rdfs:label>teaches</rdfs:label>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Lecture"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/oop#taughtIn">
        <rdfs:label>taught_in</rdfs:label>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Lecture"/>
        <rdfs:comment>First introduced in this lecture</rdfs:comment>
        <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#teaches"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
    <rdfs:comment>Inverse of taught_in — this lecture teaches the linked entity</rdfs:comment>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#MOOP002">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Method"/>
    <rdfs:label>__str__</rdfs:label>
    <oop:courseId>MOOP002</oop:courseId>
    <oop:definition>Returns a human-readable string representation of the object. Called implicitly by print() and str().</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:producesType rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DT_OOP_STR"/>
    <oop:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#E_OOP_TYPE"/>
    <oop:exampleOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP07"/>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/oop#enables">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label>enables</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment>Mechanism or role that makes this concept possible in Python</rdfs:comment>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/oop#enabledBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:label>enabled_by</rdfs:label>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#enables"/>
        <rdfs:comment>Inverse of enables — this concept is made possible by a mechanism</rdfs:comment>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP02">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DesignAbstraction"/>
    <rdfs:label>Interface</rdfs:label>
    <oop:courseId>DA_OOP02</oop:courseId>
    <oop:definition>A design abstraction defining a set of methods a class must implement without providing any implementation. Python achieves this via Abstract Base Classes or duck typing rather than a dedicated keyword.</oop:definition>
    <oop:usesConcept>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#COOP019">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
        <rdfs:label>Duck Typing</rdfs:label>
        <oop:courseId>COOP019</oop:courseId>
        <oop:definition>Python's implicit form of polymorphism: if an object has the required method, it can be used regardless of its class. 'If it walks like a duck and quacks like a duck, it is a duck.'</oop:definition>
        <oop:cognitiveType>conceptual</oop:cognitiveType>
        <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP018"/>
        <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP07"/>
        <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP_STATIC"/>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#FOOP003"/>
        <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP02"/>
        <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#SKOOP003"/>
        <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#FOOP002"/>
        <oop:enabledBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP07"/>
      </owl:NamedIndividual>
    </oop:usesConcept>
    <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP013"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#SKOOP007"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#COOP012">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
    <rdfs:label>Abstraction</rdfs:label>
    <oop:courseId>COOP012</oop:courseId>
    <oop:definition>Simplifying how others use your code by exposing a clean public interface and hiding internal implementation detail. Focus on WHAT is exposed, not HOW it works internally.</oop:definition>
    <oop:cognitiveType>conceptual</oop:cognitiveType>
    <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP_ENC"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:isUsedBy>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP06">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DesignAbstraction"/>
        <rdfs:label>UML Class Diagram</rdfs:label>
        <oop:courseId>DA_OOP06</oop:courseId>
        <oop:definition>A standardised visual notation for class structure: shows classes, attributes, methods, and relationships (inheritance, composition, association) in a language-independent diagram.</oop:definition>
        <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP013"/>
        <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP_ENC"/>
        <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP012"/>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
      </owl:NamedIndividual>
    </oop:isUsedBy>
    <oop:enabledBy>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#PI_OOP01">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#PythonInternals"/>
        <rdfs:label>Decorator</rdfs:label>
        <oop:courseId>PI_OOP01</oop:courseId>
        <oop:definition>A callable that wraps a function or class, modifying its behaviour without changing its source code. Written with @ syntax. Enables aspect-oriented patterns (logging, timing, access control).</oop:definition>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:enables rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP012"/>
      </owl:NamedIndividual>
    </oop:enabledBy>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/oop#isRequiredBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label>is_required_by</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/oop#dependsOn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label>depends_on</rdfs:label>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>Prerequisite ordering between concepts and skills</rdfs:comment>
        <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#isRequiredBy"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
    <rdfs:comment>Inverse of depends_on — this entity is a prerequisite for another</rdfs:comment>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#PI_OOP06">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#PythonInternals"/>
    <rdfs:label>__slots__</rdfs:label>
    <oop:courseId>PI_OOP06</oop:courseId>
    <oop:definition>A class attribute that replaces the default __dict__ with a fixed set of allowed instance attribute names. Reduces per-instance memory overhead and prevents dynamic attribute creation.</oop:definition>
    <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#PI_OOP04"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/oop#implementedBy">
    <rdfs:label>implemented_by</rdfs:label>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
    <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#ImplementorType"/>
    <rdfs:comment>Concept realised by a language construct, OOP mechanism, or Python internal</rdfs:comment>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/oop#implements">
        <rdfs:label>implements</rdfs:label>
        <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#ImplementorType"/>
        <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
        <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#implementedBy"/>
        <rdfs:comment>Inverse of implemented_by — this construct or mechanism implements a concept</rdfs:comment>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#E_OOP_ATTR">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#ErrorType"/>
    <rdfs:label>AttributeError</rdfs:label>
    <oop:courseId>E_OOP_ATTR</oop:courseId>
    <oop:definition>Raised when accessing an attribute that does not exist, or accessing a name-mangled attribute directly from outside the class.</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:commonCauses>Accessing an attribute/method name that was never defined; accessing a name-mangled (double-underscore) attribute from outside the class; typos in attribute names.</oop:commonCauses>
    <oop:isThrownBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP009"/>
    <oop:isThrownBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#FOOP003"/>
    <oop:isThrownBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MOOP004"/>
    <oop:isThrownBy>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP03">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OOPMechanism"/>
        <rdfs:label>Name Mangling</rdfs:label>
        <oop:courseId>OM_OOP03</oop:courseId>
        <oop:definition>An automatic interpreter transformation (not just a convention): any identifier with two leading underscores and at most one trailing underscore inside a class body is rewritten to _ClassName__attr. This is distinct from the single-underscore _attr convention (which is convention only, not rewritten) and from dunder names like __init__ (two leading AND two trailing underscores, also not rewritten).</oop:definition>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:enables rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP009"/>
        <oop:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#E_OOP_ATTR"/>
        <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP07"/>
        <oop:isRequiredBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP009"/>
        <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#SKOOP001"/>
      </owl:NamedIndividual>
    </oop:isThrownBy>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP04">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MethodRole"/>
    <rdfs:label>Class Method</rdfs:label>
    <oop:courseId>MR_OOP04</oop:courseId>
    <oop:definition>A method that receives the class itself (not an instance) as its first argument. Defined with @classmethod. Used for alternative constructors or class-level operations.</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP001"/>
    <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#SKOOP006"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP05">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MethodRole"/>
    <rdfs:label>Static Method</rdfs:label>
    <oop:courseId>MR_OOP05</oop:courseId>
    <oop:definition>A method with no implicit first argument — neither instance nor class. Defined with @staticmethod. Behaves like a plain function that lives in the class namespace.</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP001"/>
    <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#SKOOP006"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP03">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DesignAbstraction"/>
    <rdfs:label>Composition</rdfs:label>
    <oop:courseId>DA_OOP03</oop:courseId>
    <oop:definition>The has-a design principle: building complex objects by containing instances of other objects rather than inheriting from them. Generally preferred over deep inheritance hierarchies.</oop:definition>
    <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP013"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#CM_OOP01"/>
    <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#SKOOP007"/>
  </owl:NamedIndividual>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/oop#ErrorType">
    <rdfs:label>ErrorType</rdfs:label>
    <rdfs:comment>A Python exception type</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/oop#Concept">
    <rdfs:label>Concept</rdfs:label>
    <rdfs:comment>An abstract theoretical foundation</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/oop#isUsedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label>is_used_by</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/oop#usesConcept">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:label>uses_concept</rdfs:label>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>Entity operationalises or draws on a concept or mechanism</rdfs:comment>
        <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#isUsedBy"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
    <rdfs:comment>Inverse of uses_concept — this concept is used by another entity</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/oop#LanguageConstruct">
    <rdfs:label>LanguageConstruct</rdfs:label>
    <rdfs:comment>A Python syntax element</rdfs:comment>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#PI_OOP03">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#PythonInternals"/>
    <rdfs:label>Metaclass</rdfs:label>
    <oop:courseId>PI_OOP03</oop:courseId>
    <oop:definition>The class of a class. In Python every class is itself an object, and its metaclass (default: type) controls how the class is created, what attributes it has, and how subclassing works.</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:enables rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP001"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#E_OOP_RUNTIME">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#ErrorType"/>
    <rdfs:label>RuntimeError</rdfs:label>
    <oop:courseId>E_OOP_RUNTIME</oop:courseId>
    <oop:definition>Raised when an operation fails for reasons that don't fit a more specific exception type; in this lecture, specifically when zero-argument super() is called outside a proper instance method (no __class__ cell available to bind to).</oop:definition>
    <oop:commonCauses>Calling bare super() from a plain function, a nested function inside a method, or anywhere other than directly inside a method body of a class.</oop:commonCauses>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:isThrownBy>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#FOOP001">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#BuiltInFunction"/>
        <rdfs:label>super()</rdfs:label>
        <oop:courseId>FOOP001</oop:courseId>
        <oop:definition>Returns a proxy object bound to the next class in the instance's Method Resolution Order (MRO) — the parent class in simple single inheritance, but not necessarily so once multiple inheritance is involved. Used inside a method to call the next implementation without hardcoding a class name.</oop:definition>
        <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP013"/>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:exampleOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP05"/>
        <oop:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#E_OOP_RUNTIME"/>
      </owl:NamedIndividual>
    </oop:isThrownBy>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#CM_OOP05">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#ClassMember"/>
    <rdfs:label>Method Signature</rdfs:label>
    <oop:courseId>CM_OOP05</oop:courseId>
    <oop:definition>The name and parameter list that define a method's interface contract: what it's called, how many arguments it takes, and what types are expected.</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP001"/>
  </owl:NamedIndividual>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/oop#TypeProducer">
    <rdfs:label>TypeProducer</rdfs:label>
    <rdfs:comment>Union of Method, BuiltInFunction, and Algorithm -- entity types whose operation can accept and/or yield a value of some DataType. Helper union used only as the domain of producesType/acceptsType (mirrors the ImplementorType pattern); not an instantiated entity type.</rdfs:comment>
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="N55f1d037905642a3b25a12b1cbdba92a">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#Method"/>
          <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#BuiltInFunction"/>
          <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#Algorithm"/>
        </owl:unionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/oop#Skill">
    <rdfs:label>Skill</rdfs:label>
    <rdfs:comment>A transferable cognitive operation</rdfs:comment>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#COOP007">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
    <rdfs:label>Instantiation</rdfs:label>
    <oop:courseId>COOP007</oop:courseId>
    <oop:definition>The act of creating an object from a class by calling it like a function: Character('Arthur', 100, 15). Triggers __init__ automatically.</oop:definition>
    <oop:cognitiveType>procedural</oop:cognitiveType>
    <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP001"/>
    <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP01"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:enabledBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP01"/>
  </owl:NamedIndividual>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/oop#Algorithm">
    <rdfs:label>Algorithm</rdfs:label>
    <rdfs:comment>A specific algorithmic solution/procedure for a well-defined problem. No individuals in this lecture module (OOP doesn't introduce new algorithms) -- declared here only so it can participate in the producesType/acceptsType domain union; real individuals live in the static curriculum ontology this file extends.</rdfs:comment>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#CM_OOP04">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#ClassMember"/>
    <rdfs:label>Superclass</rdfs:label>
    <oop:courseId>CM_OOP04</oop:courseId>
    <oop:definition>The parent class whose attributes and methods are inherited by a subclass. Contains the common shared behaviour that child classes specialise.</oop:definition>
    <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#CM_OOP03"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP013"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#COOP_STATIC">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
    <rdfs:label>Static Typing</rdfs:label>
    <oop:courseId>COOP_STATIC</oop:courseId>
    <oop:definition>Type system where variable types are checked at compile time, not runtime. Python uses dynamic typing; static typing languages (Java, C++) contrast with Python's approach.</oop:definition>
    <oop:cognitiveType>conceptual</oop:cognitiveType>
    <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP019"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </owl:NamedIndividual>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/oop#PythonInternals">
    <rdfs:label>PythonInternals</rdfs:label>
    <rdfs:comment>A CPython meta-programming mechanism</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/oop#ClassMember">
    <rdfs:label>ClassMember</rdfs:label>
    <rdfs:comment>A named structural element belonging to a class or hierarchy</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/oop#Method">
    <rdfs:label>Method</rdfs:label>
    <rdfs:comment>A type-specific callable</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/oop#OOPMechanism">
    <rdfs:label>OOPMechanism</rdfs:label>
    <rdfs:comment>A concrete OOP operational mechanism in Python</rdfs:comment>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#SKOOP004">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Skill"/>
    <rdfs:label>Writing Dunder Methods</rdfs:label>
    <oop:courseId>SKOOP004</oop:courseId>
    <oop:definition>Implement special methods (__str__, __eq__, __len__) to integrate user-defined classes with Python built-in functions and operators.</oop:definition>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP07"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </owl:NamedIndividual>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/oop#MethodRole">
    <rdfs:label>MethodRole</rdfs:label>
    <rdfs:comment>A contract role or category a method fulfills within a class</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/oop#ImplementorType">
    <rdfs:label>ImplementorType</rdfs:label>
    <rdfs:comment>Union of LanguageConstruct, Method, OOPMechanism, and PythonInternals — entity types that can implement a Concept</rdfs:comment>
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="N4ed10f622f6c4956840856fda5482225">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#LanguageConstruct"/>
          <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#Method"/>
          <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#OOPMechanism"/>
          <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#PythonInternals"/>
        </owl:unionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
</rdf:RDF>
