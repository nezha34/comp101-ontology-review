  <rdf:Description rdf:nodeID="Ndb3092810cc84580bc9a5e183355b951">
    <rdf:first rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#LanguageConstruct"/>
    <rdf:rest rdf:nodeID="N1d319fa5d48f48d89cf4b1ca1f4536a3"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dc:title>COMP101 OOP — Object-Oriented Programming</dc:title>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <owl:versionInfo>2.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#SKOOP007">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Skill"/>
    <rdfs:label>Choosing Design Relationships</rdfs:label>
    <oop:courseId>SKOOP007</oop:courseId>
    <oop:definition>Choose between inheritance, composition, and an abstract interface when designing the relationship between two classes, and use mixins for reusable behaviour that doesn't fit a single hierarchy.</oop:definition>
    <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#SKOOP002"/>
    <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#SKOOP006"/>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP01"/>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP02"/>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP03"/>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP04"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP03">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OOPMechanism"/>
    <rdfs:label>Name Mangling</rdfs:label>
    <oop:courseId>OM_OOP03</oop:courseId>
    <oop:definition>The Python convention of prefixing an attribute with __ so it becomes _ClassName__attr internally. Discourages direct access from outside the class.</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:enables rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP009"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#L10">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Lecture"/>
    <rdfs:label>Object-Oriented Programming</rdfs:label>
    <oop:courseId>L10</oop:courseId>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N0f435e8362a64b8a86a6cd7605efd001">
    <rdf:first rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
    <rdf:rest rdf:nodeID="Ndb3092810cc84580bc9a5e183355b951"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#PI_OOP05">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#PythonInternals"/>
    <rdfs:label>__mro__</rdfs:label>
    <oop:courseId>PI_OOP05</oop:courseId>
    <oop:definition>The Method Resolution Order tuple on a class. Lists the exact sequence Python searches for attributes and methods when a class uses inheritance, following the C3 linearisation algorithm.</oop:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#enables">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label>enables</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment>Mechanism or role that makes this concept possible in Python</rdfs:comment>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#enabledBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#SKOOP006">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Skill"/>
    <rdfs:label>Choosing Method Roles</rdfs:label>
    <oop:courseId>SKOOP006</oop:courseId>
    <oop:definition>Choose the correct method role -- instance method, @classmethod, @staticmethod, or @abstractmethod -- for a given design need, and predict what each is (and isn't) allowed to access.</oop:definition>
    <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#SKOOP002"/>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP03"/>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP04"/>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP05"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#usesConcept">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label>uses_concept</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment>Entity operationalises or draws on a concept or mechanism</rdfs:comment>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#isUsedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#CM_OOP01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#ClassMember"/>
    <rdfs:label>Instance Attribute</rdfs:label>
    <oop:courseId>CM_OOP01</oop:courseId>
    <oop:definition>An attribute bound to a specific object via self (self.hp). Each object has its own independent copy.</oop:definition>
    <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#CM_OOP02"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP002"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#MOOP002">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Method"/>
    <rdfs:label>__str__</rdfs:label>
    <oop:courseId>MOOP002</oop:courseId>
    <oop:definition>Returns a human-readable string representation of the object. Called implicitly by print() and str().</oop:definition>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP07"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP07"/>
    <oop:producesType rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DT_OOP_STR"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#COOP012">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
    <rdfs:label>Abstraction</rdfs:label>
    <oop:courseId>COOP012</oop:courseId>
    <oop:definition>Simplifying how others use your code by exposing a clean public interface and hiding internal implementation detail. Focus on WHAT is exposed, not HOW it works internally.</oop:definition>
    <oop:cognitiveType>conceptual</oop:cognitiveType>
    <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP_ENC"/>
    <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP_ENC"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#E_OOP_ATTR">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#ErrorType"/>
    <rdfs:label>AttributeError</rdfs:label>
    <oop:courseId>E_OOP_ATTR</oop:courseId>
    <oop:definition>Raised when accessing an attribute that does not exist, or accessing a name-mangled attribute directly from outside the class.</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#hasExample">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has_example</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#exampleOf"/>
    <rdfs:comment>Inverse of example_of — this concept has the linked entity as a named exemplar</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#COOP013">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
    <rdfs:label>Inheritance</rdfs:label>
    <oop:courseId>COOP013</oop:courseId>
    <oop:definition>A mechanism where a child class acquires all attributes and methods of a parent class, enabling code reuse and specialisation.</oop:definition>
    <oop:cognitiveType>conceptual</oop:cognitiveType>
    <oop:bestPractice>Keep parent class logic general; specialise only in the child class.</oop:bestPractice>
    <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP001"/>
    <oop:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#LC_OOP_CLASS"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#COOP001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
    <rdfs:label>Class</rdfs:label>
    <oop:courseId>COOP001</oop:courseId>
    <oop:definition>A blueprint/template that defines the attributes and methods all objects of that type will have. Does not occupy memory until instantiated.</oop:definition>
    <oop:cognitiveType>conceptual</oop:cognitiveType>
    <oop:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#LC_OOP_CLASS"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#CM_OOP02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#ClassMember"/>
    <rdfs:label>Class Attribute</rdfs:label>
    <oop:courseId>CM_OOP02</oop:courseId>
    <oop:definition>An attribute defined on the class body, shared across all instances unless shadowed by an instance attribute of the same name.</oop:definition>
    <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#CM_OOP01"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP001"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#SKOOP001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Skill"/>
    <rdfs:label>Implementing Encapsulation</rdfs:label>
    <oop:courseId>SKOOP001</oop:courseId>
    <oop:definition>Apply name mangling to hide internal state and write getter/setter methods that enforce class invariants.</oop:definition>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP03"/>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP01"/>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP02"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#isThrownBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>is_thrown_by</rdfs:label>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#ErrorType"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#throwsError"/>
    <rdfs:comment>Inverse of throws_error — this error is thrown by a concept or mechanism</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#FOOP002">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#BuiltInFunction"/>
    <rdfs:label>isinstance()</rdfs:label>
    <oop:courseId>FOOP002</oop:courseId>
    <oop:definition>Returns True if an object is an instance of a class or a subclass. Key tool for type-safe polymorphic code.</oop:definition>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP018"/>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP019"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MethodRole"/>
    <rdfs:label>Setter Method</rdfs:label>
    <oop:courseId>MR_OOP02</oop:courseId>
    <oop:definition>A public method that safely sets a private attribute with optional validation. Enforces class invariants on mutation.</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP_ENC"/>
    <oop:enables rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP009"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#FOOP003">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#BuiltInFunction"/>
    <rdfs:label>hasattr()</rdfs:label>
    <oop:courseId>FOOP003</oop:courseId>
    <oop:definition>Returns True if an object has a named attribute. Core tool for duck-typing checks: test before you call.</oop:definition>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP019"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP07">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OOPMechanism"/>
    <rdfs:label>Dunder Method</rdfs:label>
    <oop:courseId>OM_OOP07</oop:courseId>
    <oop:definition>Special methods surrounded by double underscores (__init__, __str__, __eq__). Called implicitly by Python operators and built-in functions rather than by direct name.</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP001"/>
    <oop:enables rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP019"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#implements">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>implements</rdfs:label>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#ImplementorType"/>
    <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#implementedBy"/>
    <rdfs:comment>Inverse of implemented_by — this construct or mechanism implements a concept</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#teaches">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>teaches</rdfs:label>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Lecture"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#taughtIn"/>
    <rdfs:comment>Inverse of taught_in — this lecture teaches the linked entity</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#PI_OOP03">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#PythonInternals"/>
    <rdfs:label>Metaclass</rdfs:label>
    <oop:courseId>PI_OOP03</oop:courseId>
    <oop:definition>The class of a class. In Python every class is itself an object, and its metaclass (default: type) controls how the class is created, what attributes it has, and how subclassing works.</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:enables rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP001"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OOPMechanism"/>
    <rdfs:label>Constructor</rdfs:label>
    <oop:courseId>OM_OOP01</oop:courseId>
    <oop:definition>The __init__ method called automatically when an object is created. Initialises all instance attributes. Part of every class definition.</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP001"/>
    <oop:enables rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP007"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#cognitiveType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>cognitive_type</rdfs:label>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Cognitive demand type: procedural | conceptual | theoretical</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#bestPractice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>best_practice</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Recommended approach or convention</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#isUsedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label>is_used_by</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#usesConcept"/>
    <rdfs:comment>Inverse of uses_concept — this concept is used by another entity</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#COOP019">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
    <rdfs:label>Duck Typing</rdfs:label>
    <oop:courseId>COOP019</oop:courseId>
    <oop:definition>Python's implicit form of polymorphism: if an object has the required method, it can be used regardless of its class. 'If it walks like a duck and quacks like a duck, it is a duck.'</oop:definition>
    <oop:cognitiveType>theoretical</oop:cognitiveType>
    <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP018"/>
    <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP07"/>
    <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP_STATIC"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#Lecture">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Lecture</rdfs:label>
    <rdfs:comment>A course lecture unit</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#Method">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Method</rdfs:label>
    <rdfs:comment>A type-specific callable</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OOPMechanism"/>
    <rdfs:label>Self Reference</rdfs:label>
    <oop:courseId>OM_OOP02</oop:courseId>
    <oop:definition>The conventional first parameter (self) in every instance method. Python passes the calling object automatically. Enables methods to read and write the object's own attributes.</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:enables rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP001"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#partOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label>part_of</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment>Compositional containment — transitive</rdfs:comment>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#hasPart"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#MOOP001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Method"/>
    <rdfs:label>__init__</rdfs:label>
    <oop:courseId>MOOP001</oop:courseId>
    <oop:definition>Constructor dunder method. Called automatically when a new object is created. Initialises all instance attributes via self.</oop:definition>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP01"/>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP02"/>
    <oop:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#E_OOP_TYPE"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#E_OOP_TYPE">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#ErrorType"/>
    <rdfs:label>TypeError</rdfs:label>
    <oop:courseId>E_OOP_TYPE</oop:courseId>
    <oop:definition>Raised when wrong number of arguments passed to __init__, or incompatible types used in an operation.</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#implementedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>implemented_by</rdfs:label>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
    <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#ImplementorType"/>
    <rdfs:comment>Concept realised by a language construct, OOP mechanism, or Python internal</rdfs:comment>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#implements"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#COOP007">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
    <rdfs:label>Instantiation</rdfs:label>
    <oop:courseId>COOP007</oop:courseId>
    <oop:definition>The act of creating an object from a class by calling it like a function: Character('Arthur', 100, 15). Triggers __init__ automatically.</oop:definition>
    <oop:cognitiveType>procedural</oop:cognitiveType>
    <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP001"/>
    <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP01"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#COOP018">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
    <rdfs:label>Polymorphism</rdfs:label>
    <oop:courseId>COOP018</oop:courseId>
    <oop:definition>The ability to use the same interface with objects of different types. The correct method is chosen at runtime based on the actual type of the object.</oop:definition>
    <oop:cognitiveType>theoretical</oop:cognitiveType>
    <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP013"/>
    <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP04"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#FOOP001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#BuiltInFunction"/>
    <rdfs:label>super()</rdfs:label>
    <oop:courseId>FOOP001</oop:courseId>
    <oop:definition>Returns a proxy object for the parent class. Used inside a subclass method to call the parent's version of that method without hardcoding the parent class name.</oop:definition>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP013"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N035b1efc36394f639486cc45403568ff">
    <rdf:first rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Lecture"/>
    <rdf:rest rdf:nodeID="N0f435e8362a64b8a86a6cd7605efd001"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DesignAbstraction"/>
    <rdfs:label>Abstract Class</rdfs:label>
    <oop:courseId>DA_OOP01</oop:courseId>
    <oop:definition>A class that cannot be instantiated directly and contains at least one abstract method. Enforces a contract: all concrete subclasses must implement the abstract methods.</oop:definition>
    <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP013"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#definition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>definition</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Plain-language definition of the entity</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#SKOOP004">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Skill"/>
    <rdfs:label>Writing Dunder Methods</rdfs:label>
    <oop:courseId>SKOOP004</oop:courseId>
    <oop:definition>Implement special methods (__str__, __eq__, __len__) to integrate user-defined classes with Python built-in functions and operators.</oop:definition>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP07"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#SKOOP002">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Skill"/>
    <rdfs:label>Applying Inheritance</rdfs:label>
    <oop:courseId>SKOOP002</oop:courseId>
    <oop:definition>Create subclasses that extend a parent class, call super().__init__() correctly, and override methods to specialise behaviour.</oop:definition>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#CM_OOP03"/>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP05"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#hasPart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label>has_part</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#partOf"/>
    <rdfs:comment>Inverse of part_of — this entity contains another as a component</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#MOOP005">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Method"/>
    <rdfs:label>__len__</rdfs:label>
    <oop:courseId>MOOP005</oop:courseId>
    <oop:definition>Defines the length of an object. Called implicitly by len(). Allows user-defined classes to behave like built-in sequences.</oop:definition>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP07"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP07"/>
    <oop:producesType rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DT_OOP_INT"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#CM_OOP04">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#ClassMember"/>
    <rdfs:label>Superclass</rdfs:label>
    <oop:courseId>CM_OOP04</oop:courseId>
    <oop:definition>The parent class whose attributes and methods are inherited by a subclass. Contains the common shared behaviour that child classes specialise.</oop:definition>
    <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#CM_OOP03"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP013"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#taughtIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>taught_in</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Lecture"/>
    <rdfs:comment>First introduced in this lecture</rdfs:comment>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#teaches"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#courseId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>course_id</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Original identifier for this entity (e.g. C_OOP01)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP05">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DesignAbstraction"/>
    <rdfs:label>Design Pattern</rdfs:label>
    <oop:courseId>DA_OOP05</oop:courseId>
    <oop:definition>A named, reusable solution template for a recurring software design problem. Patterns (Factory, Strategy, Observer, etc.) are language-agnostic blueprints, not code.</oop:definition>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP013"/>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP_ENC"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#PI_OOP04">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#PythonInternals"/>
    <rdfs:label>__dict__</rdfs:label>
    <oop:courseId>PI_OOP04</oop:courseId>
    <oop:definition>The dictionary that stores an object's (or class's) attribute namespace. Instance __dict__ holds per-object attributes; class __dict__ holds class-level attributes and methods.</oop:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#producesType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>produces_type</rdfs:label>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Method"/>
    <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DataType"/>
    <rdfs:comment>Return type</rdfs:comment>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#isProducedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#PI_OOP01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#PythonInternals"/>
    <rdfs:label>Decorator</rdfs:label>
    <oop:courseId>PI_OOP01</oop:courseId>
    <oop:definition>A callable that wraps a function or class, modifying its behaviour without changing its source code. Written with @ syntax. Enables aspect-oriented patterns (logging, timing, access control).</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:enables rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP012"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#PythonInternals">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>PythonInternals</rdfs:label>
    <rdfs:comment>A CPython meta-programming mechanism</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#LC_OOP_CLASS">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#LanguageConstruct"/>
    <rdfs:label>class definition</rdfs:label>
    <oop:courseId>LC_OOP_CLASS</oop:courseId>
    <oop:definition>The class keyword syntax. Defines a new class: class Name(Parent):</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP001"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N92bb33b6340f4c60b57a1d2a376942f6">
    <rdf:first rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MethodRole"/>
    <rdf:rest rdf:nodeID="N76e46ac19f294ddfbf96b9fcf3d03416"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP04">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MethodRole"/>
    <rdfs:label>Class Method</rdfs:label>
    <oop:courseId>MR_OOP04</oop:courseId>
    <oop:definition>A method that receives the class itself (not an instance) as its first argument. Defined with @classmethod. Used for alternative constructors or class-level operations.</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP001"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#DT_OOP_INT">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DataType"/>
    <rdfs:label>int</rdfs:label>
    <oop:courseId>DT_OOP_INT</oop:courseId>
    <oop:definition>Integer — returned by __len__.</oop:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#COOP_STATIC">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
    <rdfs:label>Static Typing</rdfs:label>
    <oop:courseId>COOP_STATIC</oop:courseId>
    <oop:definition>Type system where variable types are checked at compile time, not runtime. Python uses dynamic typing; static typing languages (Java, C++) contrast with Python's approach.</oop:definition>
    <oop:cognitiveType>conceptual</oop:cognitiveType>
    <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP019"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#COOP002">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
    <rdfs:label>Object</rdfs:label>
    <oop:courseId>COOP002</oop:courseId>
    <oop:definition>An instance of a class — the actual thing created from the blueprint. Each object has its own copy of instance attributes.</oop:definition>
    <oop:cognitiveType>conceptual</oop:cognitiveType>
    <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP001"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#throwsError">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>throws_error</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#ErrorType"/>
    <rdfs:comment>Misuse causes this error</rdfs:comment>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#isThrownBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP03">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MethodRole"/>
    <rdfs:label>Abstract Method</rdfs:label>
    <oop:courseId>MR_OOP03</oop:courseId>
    <oop:definition>A method declared in a parent class with no implementation body. Forces every subclass to provide its own implementation. Defined via @abstractmethod.</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#isRequiredBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label>is_required_by</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#dependsOn"/>
    <rdfs:comment>Inverse of depends_on — this entity is a prerequisite for another</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#SKOOP003">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Skill"/>
    <rdfs:label>Applying Polymorphism</rdfs:label>
    <oop:courseId>SKOOP003</oop:courseId>
    <oop:definition>Write code that operates on objects of different types through a shared interface, using method overriding and duck typing.</oop:definition>
    <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#SKOOP002"/>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP04"/>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP019"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#Concept">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Concept</rdfs:label>
    <rdfs:comment>An abstract theoretical foundation</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#DataType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>DataType</rdfs:label>
    <rdfs:comment>A Python data type</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#contrastsWith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:label>contrasts_with</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment>Alternatives, opposites, or commonly confused peers</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#Encoding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Encoding</rdfs:label>
    <rdfs:comment>A byte-to-symbol mapping standard</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nbe2c1d0bce1b4cc0a1dab2f1601d3bdd">
    <rdf:first rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#LanguageConstruct"/>
    <rdf:rest rdf:nodeID="Nf33b58bef8734918aa227ccf73d96cce"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP04">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OOPMechanism"/>
    <rdfs:label>Method Overriding</rdfs:label>
    <oop:courseId>OM_OOP04</oop:courseId>
    <oop:definition>A subclass redefines a method that already exists in the parent class. The overriding method replaces or extends the parent's behaviour for that specific type.</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:enables rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP018"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP05">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OOPMechanism"/>
    <rdfs:label>super() Call</rdfs:label>
    <oop:courseId>OM_OOP05</oop:courseId>
    <oop:definition>Calling super() inside a subclass method returns a proxy for the parent class, allowing the child to invoke the parent's implementation without hardcoding the parent's name.</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:enables rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP013"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP04">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DesignAbstraction"/>
    <rdfs:label>Mixin</rdfs:label>
    <oop:courseId>DA_OOP04</oop:courseId>
    <oop:definition>A class designed to add a specific behaviour to other classes via multiple inheritance, without being intended as a standalone class. Provides reusable behaviour slices.</oop:definition>
    <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP06"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP05"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#commonCauses">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>common_causes</rdfs:label>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#ErrorType"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Common causes that trigger this error</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#DT_OOP_STR">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DataType"/>
    <rdfs:label>str</rdfs:label>
    <oop:courseId>DT_OOP_STR</oop:courseId>
    <oop:definition>Python's text type — returned by __str__ and __repr__.</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#enabledBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label>enabled_by</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#enables"/>
    <rdfs:comment>Inverse of enables — this concept is made possible by a mechanism</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#MOOP004">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Method"/>
    <rdfs:label>__eq__</rdfs:label>
    <oop:courseId>MOOP004</oop:courseId>
    <oop:definition>Defines equality between two objects. Called implicitly by the == operator. Without it, == compares object identity, not value.</oop:definition>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP_OBJ_ID"/>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP07"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP07"/>
    <oop:producesType rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DT_OOP_BOOL"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DesignAbstraction"/>
    <rdfs:label>Interface</rdfs:label>
    <oop:courseId>DA_OOP02</oop:courseId>
    <oop:definition>A design abstraction defining a set of methods a class must implement without providing any implementation. Python achieves this via Abstract Base Classes or duck typing rather than a dedicated keyword.</oop:definition>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP019"/>
    <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP013"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#isProducedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>is_produced_by</rdfs:label>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DataType"/>
    <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Method"/>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#producesType"/>
    <rdfs:comment>Inverse of produces_type — this type is produced by a method</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#SKOOP005">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Skill"/>
    <rdfs:label>Enforcing Class Invariants</rdfs:label>
    <oop:courseId>SKOOP005</oop:courseId>
    <oop:definition>Use __init__ and setter methods to guarantee that object state always satisfies required constraints (e.g. hp is never negative).</oop:definition>
    <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#SKOOP001"/>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP02"/>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP013"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP05">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MethodRole"/>
    <rdfs:label>Static Method</rdfs:label>
    <oop:courseId>MR_OOP05</oop:courseId>
    <oop:definition>A method with no implicit first argument — neither instance nor class. Defined with @staticmethod. Behaves like a plain function that lives in the class namespace.</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP001"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP07">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DesignAbstraction"/>
    <rdfs:label>Global State Problem</rdfs:label>
    <oop:courseId>DA_OOP07</oop:courseId>
    <oop:definition>The anti-pattern where data is scattered across global variables, causing naming collisions, no shared behaviour, and copy-paste for every new feature. OOP solves this by bundling data with methods in a class.</oop:definition>
    <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP012"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na1d7aca5de6e4e1eabb2739676837027">
    <rdf:first rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Method"/>
    <rdf:rest rdf:nodeID="N2ca24ee2ad4942698994149ff8484738"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf33b58bef8734918aa227ccf73d96cce">
    <rdf:first rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Method"/>
    <rdf:rest rdf:nodeID="N7e42466e1bcf462cbe97a9bb557970b0"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#PI_OOP06">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#PythonInternals"/>
    <rdfs:label>__slots__</rdfs:label>
    <oop:courseId>PI_OOP06</oop:courseId>
    <oop:definition>A class attribute that replaces the default __dict__ with a fixed set of allowed instance attribute names. Reduces per-instance memory overhead and prevents dynamic attribute creation.</oop:definition>
    <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#PI_OOP04"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#DesignAbstraction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>DesignAbstraction</rdfs:label>
    <rdfs:comment>A language-agnostic design vocabulary item</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na04076831f6747318cef135468077c23">
    <rdf:first rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#PythonInternals"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MethodRole"/>
    <rdfs:label>Getter Method</rdfs:label>
    <oop:courseId>MR_OOP01</oop:courseId>
    <oop:definition>A public method that safely returns the value of a private attribute. The only sanctioned way to read hidden state.</oop:definition>
    <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP02"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP_ENC"/>
    <oop:enables rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP009"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2776ab950f944aa2b1070a86bf4d8a86">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="N035b1efc36394f639486cc45403568ff"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N76e46ac19f294ddfbf96b9fcf3d03416">
    <rdf:first rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DesignAbstraction"/>
    <rdf:rest rdf:nodeID="Na04076831f6747318cef135468077c23"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#dependsOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label>depends_on</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment>Prerequisite ordering between concepts and skills</rdfs:comment>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#isRequiredBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#CM_OOP03">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#ClassMember"/>
    <rdfs:label>Subclass</rdfs:label>
    <oop:courseId>CM_OOP03</oop:courseId>
    <oop:definition>A class that inherits from one or more parent classes. Can add new attributes/methods or override existing ones via Method Overriding.</oop:definition>
    <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#CM_OOP04"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP013"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#OOPMechanism">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>OOPMechanism</rdfs:label>
    <rdfs:comment>A concrete OOP operational mechanism in Python</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#PI_OOP02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#PythonInternals"/>
    <rdfs:label>Property Object</rdfs:label>
    <oop:courseId>PI_OOP02</oop:courseId>
    <oop:definition>The object created by the @property decorator. Intercepts attribute access (get, set, delete) on an instance, letting you define attribute access as method calls while keeping dot-notation syntax.</oop:definition>
    <oop:enables rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP009"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#COOP_ENC">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
    <rdfs:label>Encapsulation</rdfs:label>
    <oop:courseId>COOP_ENC</oop:courseId>
    <oop:definition>Bundling data and behaviour together inside a class, controlling access to enforce invariants.</oop:definition>
    <oop:cognitiveType>conceptual</oop:cognitiveType>
    <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP001"/>
    <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP009"/>
    <oop:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#LC_OOP_CLASS"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#ClassMember">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ClassMember</rdfs:label>
    <rdfs:comment>A named structural element belonging to a class or hierarchy</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#COOP009">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
    <rdfs:label>Data Hiding</rdfs:label>
    <oop:courseId>COOP009</oop:courseId>
    <oop:definition>The principle of restricting direct access to an object's internal state so that invariants can be enforced. Achieved in Python via name mangling.</oop:definition>
    <oop:cognitiveType>conceptual</oop:cognitiveType>
    <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP03"/>
    <oop:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#E_OOP_ATTR"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1d319fa5d48f48d89cf4b1ca1f4536a3">
    <rdf:first rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DataType"/>
    <rdf:rest rdf:nodeID="N526a948d75294031ad1e009dd7beb9bf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP06">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OOPMechanism"/>
    <rdfs:label>Multiple Inheritance</rdfs:label>
    <oop:courseId>OM_OOP06</oop:courseId>
    <oop:definition>A Python class can inherit from more than one parent class simultaneously, acquiring attributes and methods from all of them. Method Resolution Order (MRO) determines lookup order.</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP013"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP06">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DesignAbstraction"/>
    <rdfs:label>UML Class Diagram</rdfs:label>
    <oop:courseId>DA_OOP06</oop:courseId>
    <oop:definition>A standardised visual notation for class structure: shows classes, attributes, methods, and relationships (inheritance, composition, association) in a language-independent diagram.</oop:definition>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP013"/>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP_ENC"/>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP012"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2ca24ee2ad4942698994149ff8484738">
    <rdf:first rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Skill"/>
    <rdf:rest rdf:nodeID="Ne9e4a8f05f744fe79a73d35b4fa4c7d9"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#MOOP003">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Method"/>
    <rdfs:label>__repr__</rdfs:label>
    <oop:courseId>MOOP003</oop:courseId>
    <oop:definition>Returns an unambiguous developer-facing string representation. Called by repr() and shown in the REPL.</oop:definition>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP07"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP07"/>
    <oop:producesType rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DT_OOP_STR"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#CM_OOP05">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#ClassMember"/>
    <rdfs:label>Method Signature</rdfs:label>
    <oop:courseId>CM_OOP05</oop:courseId>
    <oop:definition>The name and parameter list that define a method's interface contract: what it's called, how many arguments it takes, and what types are expected.</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP001"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#COOP_OBJ_ID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
    <rdfs:label>Object Identity</rdfs:label>
    <oop:courseId>COOP_OBJ_ID</oop:courseId>
    <oop:definition>The distinction between two objects being the same object in memory (is) versus having equal value (==). Without __eq__, == compares identity.</oop:definition>
    <oop:cognitiveType>conceptual</oop:cognitiveType>
    <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP002"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#LanguageConstruct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>LanguageConstruct</rdfs:label>
    <rdfs:comment>A Python syntax element</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#ImplementorType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ImplementorType</rdfs:label>
    <owl:unionOf rdf:nodeID="Nbe2c1d0bce1b4cc0a1dab2f1601d3bdd"/>
    <rdfs:comment>Union of LanguageConstruct, Method, OOPMechanism, and PythonInternals — entity types that can implement a Concept</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf98bb9fcc58b46f4af1e9c146f7c1af0">
