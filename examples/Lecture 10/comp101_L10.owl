        <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP03"/>
      </owl:NamedIndividual>
    </oop:exampleOf>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP02">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MethodRole"/>
    <rdfs:label>Setter Method</rdfs:label>
    <oop:courseId>MR_OOP02</oop:courseId>
    <oop:definition>A public method that safely sets a private attribute with optional validation. Enforces class invariants on mutation.</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#COOP_ENC">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
        <rdfs:label>Encapsulation</rdfs:label>
        <oop:courseId>COOP_ENC</oop:courseId>
        <oop:definition>Bundling data and behaviour together inside a class, controlling access to enforce invariants.</oop:definition>
        <oop:cognitiveType>conceptual</oop:cognitiveType>
        <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP001"/>
        <oop:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#LC_OOP_CLASS"/>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:isRequiredBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP009"/>
        <oop:isRequiredBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP012"/>
        <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#SKOOP005"/>
        <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP06"/>
        <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP05"/>
        <oop:hasPart rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP01"/>
        <oop:hasPart rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP02"/>
        <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP07"/>
      </owl:NamedIndividual>
    </oop:partOf>
    <oop:enables>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#COOP009">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
        <rdfs:label>Data Hiding</rdfs:label>
        <oop:courseId>COOP009</oop:courseId>
        <oop:definition>The principle of restricting direct access to an object's internal state so that invariants can be enforced. In Python this is done by convention with a single leading underscore (_attr, 'internal use, don't touch') and, more strongly, via name mangling with a double leading underscore (__attr).</oop:definition>
        <oop:cognitiveType>conceptual</oop:cognitiveType>
        <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP03"/>
        <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP_ENC"/>
        <oop:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#E_OOP_ATTR"/>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:enabledBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#PI_OOP02"/>
        <oop:enabledBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP01"/>
        <oop:enabledBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP02"/>
        <oop:enabledBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP03"/>
      </owl:NamedIndividual>
    </oop:enables>
    <oop:throwsError>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#E_OOP_VALUE">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#ErrorType"/>
        <rdfs:label>ValueError</rdfs:label>
        <oop:courseId>E_OOP_VALUE</oop:courseId>
        <oop:definition>Raised when an operation receives an argument of the right type but an invalid value, e.g. a setter method rejecting an out-of-range value to enforce a class invariant.</oop:definition>
        <oop:commonCauses>A setter method explicitly raising ValueError after failing its own validation check (e.g. setting hp to a negative number).</oop:commonCauses>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:isThrownBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP02"/>
      </owl:NamedIndividual>
    </oop:throwsError>
    <oop:isUsedBy>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#SKOOP001">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Skill"/>
        <rdfs:label>Implementing Encapsulation</rdfs:label>
        <oop:courseId>SKOOP001</oop:courseId>
        <oop:definition>Apply name mangling to hide internal state and write getter/setter methods that enforce class invariants.</oop:definition>
        <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP03"/>
        <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP01"/>
        <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP02"/>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:isRequiredBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#SKOOP005"/>
      </owl:NamedIndividual>
    </oop:isUsedBy>
    <oop:isUsedBy>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#SKOOP005">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Skill"/>
        <rdfs:label>Enforcing Class Invariants</rdfs:label>
        <oop:courseId>SKOOP005</oop:courseId>
        <oop:definition>Use __init__ and setter methods to guarantee that object state always satisfies required constraints (e.g. hp is never negative).</oop:definition>
        <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#SKOOP001"/>
        <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP02"/>
        <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP_ENC"/>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
      </owl:NamedIndividual>
    </oop:isUsedBy>
    <oop:contrastsWith>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP01">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MethodRole"/>
        <rdfs:label>Getter Method</rdfs:label>
        <oop:courseId>MR_OOP01</oop:courseId>
        <oop:definition>A public method that safely returns the value of a private attribute — one sanctioned way to read hidden state; @property (see Property Object) is the more idiomatic alternative.</oop:definition>
        <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP02"/>
        <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#PI_OOP02"/>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP_ENC"/>
        <oop:enables rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP009"/>
        <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#SKOOP001"/>
      </owl:NamedIndividual>
    </oop:contrastsWith>
    <oop:contrastsWith>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#PI_OOP02">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#PythonInternals"/>
        <rdfs:label>Property Object</rdfs:label>
        <oop:courseId>PI_OOP02</oop:courseId>
        <oop:definition>The object created by the @property decorator. Intercepts attribute access (get, set, delete) on an instance, letting you define attribute access as method calls while keeping dot-notation syntax.</oop:definition>
        <oop:enables rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP009"/>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP01"/>
        <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP02"/>
      </owl:NamedIndividual>
    </oop:contrastsWith>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/oop#producesType">
    <rdfs:label>produces_type</rdfs:label>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#TypeProducer"/>
    <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DataType"/>
    <rdfs:comment>Return type</rdfs:comment>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/oop#isProducedBy">
        <rdfs:label>is_produced_by</rdfs:label>
        <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DataType"/>
        <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#TypeProducer"/>
        <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#producesType"/>
        <rdfs:comment>Inverse of produces_type — this type is produced by a method</rdfs:comment>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP06">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OOPMechanism"/>
    <rdfs:label>Multiple Inheritance</rdfs:label>
    <oop:courseId>OM_OOP06</oop:courseId>
    <oop:definition>A Python class can inherit from more than one parent class simultaneously, acquiring attributes and methods from all of them. Method Resolution Order (MRO) determines lookup order.</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#COOP013">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
        <rdfs:label>Inheritance</rdfs:label>
        <oop:courseId>COOP013</oop:courseId>
        <oop:definition>A mechanism where a child class acquires all attributes and methods of a parent class, enabling code reuse and specialisation.</oop:definition>
        <oop:cognitiveType>conceptual</oop:cognitiveType>
        <oop:bestPractice>Keep parent class logic general; specialise only in the child class.</oop:bestPractice>
        <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP001"/>
        <oop:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#LC_OOP_CLASS"/>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:isRequiredBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP01"/>
        <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#FOOP001"/>
        <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP06"/>
        <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP018"/>
        <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP05"/>
        <oop:enabledBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP05"/>
        <oop:hasPart rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP06"/>
        <oop:hasPart rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#CM_OOP03"/>
        <oop:hasPart rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#CM_OOP04"/>
        <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP02"/>
        <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP03"/>
      </owl:NamedIndividual>
    </oop:partOf>
    <oop:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#E_OOP_TYPE"/>
    <oop:isRequiredBy>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP04">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DesignAbstraction"/>
        <rdfs:label>Mixin</rdfs:label>
        <oop:courseId>DA_OOP04</oop:courseId>
        <oop:definition>A class designed to add a specific behaviour to other classes via multiple inheritance, without being intended as a standalone class. Provides reusable behaviour slices.</oop:definition>
        <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP06"/>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:exampleOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP05"/>
        <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#SKOOP007"/>
      </owl:NamedIndividual>
    </oop:isRequiredBy>
    <oop:isUsedBy>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#PI_OOP05">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#PythonInternals"/>
        <rdfs:label>__mro__</rdfs:label>
        <oop:courseId>PI_OOP05</oop:courseId>
        <oop:definition>The Method Resolution Order tuple on a class. Lists the exact sequence Python searches for attributes and methods when a class uses inheritance, following the C3 linearisation algorithm.</oop:definition>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP06"/>
      </owl:NamedIndividual>
    </oop:isUsedBy>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP05">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DesignAbstraction"/>
    <rdfs:label>Design Pattern</rdfs:label>
    <oop:courseId>DA_OOP05</oop:courseId>
    <oop:definition>A named, reusable solution template for a recurring software design problem. Patterns (Factory, Strategy, Observer, etc.) are language-agnostic blueprints, not code.</oop:definition>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP013"/>
    <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP_ENC"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:hasExample rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP04"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#CM_OOP02">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#ClassMember"/>
    <rdfs:label>Class Attribute</rdfs:label>
    <oop:courseId>CM_OOP02</oop:courseId>
    <oop:definition>An attribute defined on the class body, shared across all instances unless shadowed by an instance attribute of the same name.</oop:definition>
    <oop:contrastsWith>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#CM_OOP01">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#ClassMember"/>
        <rdfs:label>Instance Attribute</rdfs:label>
        <oop:courseId>CM_OOP01</oop:courseId>
        <oop:definition>An attribute bound to a specific object via self (self.hp). Each object has its own independent copy.</oop:definition>
        <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#CM_OOP02"/>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP002"/>
        <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#PI_OOP04"/>
        <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP03"/>
        <oop:enabledBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP02"/>
      </owl:NamedIndividual>
    </oop:contrastsWith>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#COOP001">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
        <rdfs:label>Class</rdfs:label>
        <oop:courseId>COOP001</oop:courseId>
        <oop:definition>A blueprint/template that defines the attributes and methods all objects of that type will have. No instances exist until it is instantiated.</oop:definition>
        <oop:cognitiveType>conceptual</oop:cognitiveType>
        <oop:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#LC_OOP_CLASS"/>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:isRequiredBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP_ENC"/>
        <oop:isRequiredBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP013"/>
        <oop:isRequiredBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP007"/>
        <oop:isRequiredBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP002"/>
        <oop:enabledBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#PI_OOP03"/>
        <oop:hasPart rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP07"/>
        <oop:hasPart rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#CM_OOP05"/>
        <oop:hasPart rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP01"/>
        <oop:hasPart rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP05"/>
        <oop:hasPart rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#CM_OOP02"/>
        <oop:hasPart rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP04"/>
      </owl:NamedIndividual>
    </oop:partOf>
    <oop:usesConcept>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#PI_OOP04">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#PythonInternals"/>
        <rdfs:label>__dict__</rdfs:label>
        <oop:courseId>PI_OOP04</oop:courseId>
        <oop:definition>The dictionary that stores an object's (or class's) attribute namespace. Instance __dict__ holds per-object attributes; class __dict__ holds class-level attributes and methods.</oop:definition>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#CM_OOP01"/>
        <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#CM_OOP02"/>
        <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#PI_OOP06"/>
      </owl:NamedIndividual>
    </oop:usesConcept>
  </owl:NamedIndividual>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/oop#DataType">
    <rdfs:label>DataType</rdfs:label>
    <rdfs:comment>A Python data type</rdfs:comment>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP07">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DesignAbstraction"/>
    <rdfs:label>Global State Problem</rdfs:label>
    <oop:courseId>DA_OOP07</oop:courseId>
    <oop:definition>The anti-pattern where data is scattered across global variables, causing naming collisions, no shared behaviour, and copy-paste for every new feature. OOP solves this by bundling data with methods in a class.</oop:definition>
    <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP_ENC"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#SKOOP002">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Skill"/>
    <rdfs:label>Applying Inheritance</rdfs:label>
    <oop:courseId>SKOOP002</oop:courseId>
    <oop:definition>Create subclasses that extend a parent class, call super().__init__() correctly, and override methods to specialise behaviour.</oop:definition>
    <oop:usesConcept>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#CM_OOP03">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#ClassMember"/>
        <rdfs:label>Subclass</rdfs:label>
        <oop:courseId>CM_OOP03</oop:courseId>
        <oop:definition>A class that inherits from one or more parent classes. Can add new attributes/methods or override existing ones via Method Overriding.</oop:definition>
        <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#CM_OOP04"/>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP013"/>
        <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#SKOOP002"/>
      </owl:NamedIndividual>
    </oop:usesConcept>
    <oop:usesConcept>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP05">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OOPMechanism"/>
        <rdfs:label>super() Call</rdfs:label>
        <oop:courseId>OM_OOP05</oop:courseId>
        <oop:definition>Calling super() inside a method returns a proxy bound to the next class in the MRO, allowing a class to invoke the next implementation up the chain without hardcoding a class name.</oop:definition>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:enables rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP013"/>
        <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#SKOOP002"/>
        <oop:hasExample rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#FOOP001"/>
      </owl:NamedIndividual>
    </oop:usesConcept>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:isRequiredBy>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#SKOOP007">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Skill"/>
        <rdfs:label>Choosing Design Relationships</rdfs:label>
        <oop:courseId>SKOOP007</oop:courseId>
        <oop:definition>Choose between inheritance, composition, and an abstract interface when designing the relationship between two classes, and use mixins for reusable behaviour that doesn't fit a single hierarchy.</oop:definition>
        <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#SKOOP002"/>
        <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#SKOOP006"/>
        <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP01"/>
        <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP02"/>
        <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP03"/>
        <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP04"/>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
      </owl:NamedIndividual>
    </oop:isRequiredBy>
    <oop:isRequiredBy>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#SKOOP006">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Skill"/>
        <rdfs:label>Choosing Method Roles</rdfs:label>
        <oop:courseId>SKOOP006</oop:courseId>
        <oop:definition>Choose the correct method role -- instance method, @classmethod, @staticmethod, or @abstractmethod -- for a given design need, and predict what each is (and isn't) allowed to access.</oop:definition>
        <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#SKOOP002"/>
        <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP03"/>
        <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP04"/>
        <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP05"/>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:isRequiredBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#SKOOP007"/>
      </owl:NamedIndividual>
    </oop:isRequiredBy>
    <oop:isRequiredBy>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#SKOOP003">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Skill"/>
        <rdfs:label>Applying Polymorphism</rdfs:label>
        <oop:courseId>SKOOP003</oop:courseId>
        <oop:definition>Write code that operates on objects of different types through a shared interface, using method overriding and duck typing.</oop:definition>
        <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#SKOOP002"/>
        <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP04"/>
        <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP019"/>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
      </owl:NamedIndividual>
    </oop:isRequiredBy>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/oop#isAcceptedBy">
    <rdfs:label>is_accepted_by</rdfs:label>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DataType"/>
    <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#TypeProducer"/>
    <rdfs:comment>Inverse of accepts_type -- this type is accepted as an argument by the given operation.</rdfs:comment>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/oop#acceptsType">
        <rdfs:label>accepts_type</rdfs:label>
        <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#TypeProducer"/>
        <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DataType"/>
        <rdfs:comment>Performing the subject operation requires/accepts an argument of the given DataType.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#isAcceptedBy"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP04">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OOPMechanism"/>
    <rdfs:label>Method Overriding</rdfs:label>
    <oop:courseId>OM_OOP04</oop:courseId>
    <oop:definition>A subclass redefines a method that already exists in the parent class. The overriding method replaces or extends the parent's behaviour for that specific type.</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:enables>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#COOP018">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Concept"/>
        <rdfs:label>Polymorphism</rdfs:label>
        <oop:courseId>COOP018</oop:courseId>
        <oop:definition>The ability to use the same interface with objects of different types. The correct method is chosen at runtime based on the actual type of the object.</oop:definition>
        <oop:cognitiveType>conceptual</oop:cognitiveType>
        <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP04"/>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP013"/>
        <oop:isRequiredBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP019"/>
        <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#FOOP002"/>
        <oop:enabledBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP04"/>
      </owl:NamedIndividual>
    </oop:enables>
    <oop:isRequiredBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP018"/>
    <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#SKOOP003"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP03">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MethodRole"/>
    <rdfs:label>Abstract Method</rdfs:label>
    <oop:courseId>MR_OOP03</oop:courseId>
    <oop:definition>A method declared in a parent class with no implementation body. Forces every subclass to provide its own implementation. Defined via @abstractmethod.</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:partOf>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP01">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DesignAbstraction"/>
        <rdfs:label>Abstract Class</rdfs:label>
        <oop:courseId>DA_OOP01</oop:courseId>
        <oop:definition>A class that cannot be instantiated directly and contains at least one abstract method. Enforces a contract: all concrete subclasses must implement the abstract methods.</oop:definition>
        <oop:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP013"/>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#E_OOP_TYPE"/>
        <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#SKOOP007"/>
        <oop:hasPart rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP03"/>
      </owl:NamedIndividual>
    </oop:partOf>
    <oop:throwsError>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#E_OOP_NOTIMPL">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#ErrorType"/>
        <rdfs:label>NotImplementedError</rdfs:label>
        <oop:courseId>E_OOP_NOTIMPL</oop:courseId>
        <oop:definition>Raised manually inside a base-class method (before @abstractmethod is introduced) to force every subclass to override it; also raised if an @abstractmethod slips through and is called directly.</oop:definition>
        <oop:commonCauses>Calling a base-class method that a subclass was supposed to override but didn't.</oop:commonCauses>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:isThrownBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MR_OOP03"/>
      </owl:NamedIndividual>
    </oop:throwsError>
    <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#SKOOP006"/>
  </owl:NamedIndividual>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/oop#Lecture">
    <rdfs:label>Lecture</rdfs:label>
    <rdfs:comment>A course lecture unit</rdfs:comment>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#MOOP005">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Method"/>
    <rdfs:label>__len__</rdfs:label>
    <oop:courseId>MOOP005</oop:courseId>
    <oop:definition>Defines the length of an object. Called implicitly by len(). Allows user-defined classes to behave like built-in sequences.</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:producesType>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#DT_OOP_INT">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DataType"/>
        <rdfs:label>int</rdfs:label>
        <oop:courseId>DT_OOP_INT</oop:courseId>
        <oop:definition>Integer — returned by __len__.</oop:definition>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:isProducedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MOOP005"/>
      </owl:NamedIndividual>
    </oop:producesType>
    <oop:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#E_OOP_TYPE"/>
    <oop:exampleOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP07"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#LC_OOP_CLASS">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#LanguageConstruct"/>
    <rdfs:label>class definition</rdfs:label>
    <oop:courseId>LC_OOP_CLASS</oop:courseId>
    <oop:definition>The class keyword syntax. Defines a new class: class Name(Parent):</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:implements rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP_ENC"/>
    <oop:implements rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP001"/>
    <oop:implements rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP013"/>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/oop#partOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label>part_of</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment>Compositional containment — transitive</rdfs:comment>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/oop#hasPart">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label>has_part</rdfs:label>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#partOf"/>
        <rdfs:comment>Inverse of part_of — this entity contains another as a component</rdfs:comment>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#DT_OOP_BOOL">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DataType"/>
    <rdfs:label>bool</rdfs:label>
    <oop:courseId>DT_OOP_BOOL</oop:courseId>
    <oop:definition>Boolean — returned by __eq__ and comparison operators.</oop:definition>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:isProducedBy>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#FOOP003">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#BuiltInFunction"/>
        <rdfs:label>hasattr()</rdfs:label>
        <oop:courseId>FOOP003</oop:courseId>
        <oop:definition>Returns True if an object has a named attribute. Core tool for duck-typing checks: test before you call.</oop:definition>
        <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP019"/>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#E_OOP_ATTR"/>
        <oop:acceptsType rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DT_OOP_STR"/>
        <oop:producesType rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DT_OOP_BOOL"/>
      </owl:NamedIndividual>
    </oop:isProducedBy>
    <oop:isProducedBy>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#MOOP004">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Method"/>
        <rdfs:label>__eq__</rdfs:label>
        <oop:courseId>MOOP004</oop:courseId>
        <oop:definition>Defines equality between two objects. Called implicitly by the == operator. Without it, == compares object identity, not value.</oop:definition>
        <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP_OBJ_ID"/>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:producesType rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DT_OOP_BOOL"/>
        <oop:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#E_OOP_ATTR"/>
        <oop:exampleOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP07"/>
      </owl:NamedIndividual>
    </oop:isProducedBy>
    <oop:isProducedBy>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#FOOP002">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#BuiltInFunction"/>
        <rdfs:label>isinstance()</rdfs:label>
        <oop:courseId>FOOP002</oop:courseId>
        <oop:definition>Returns True if an object is an instance of a class or a subclass. Key tool for type-safe polymorphic code.</oop:definition>
        <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP018"/>
        <oop:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP019"/>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#E_OOP_TYPE"/>
        <oop:producesType rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DT_OOP_BOOL"/>
      </owl:NamedIndividual>
    </oop:isProducedBy>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#MOOP001">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Method"/>
    <rdfs:label>__init__</rdfs:label>
    <oop:courseId>MOOP001</oop:courseId>
    <oop:definition>Constructor dunder method. Called automatically when a new object is created. Initialises all instance attributes via self.</oop:definition>
    <oop:usesConcept>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP02">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OOPMechanism"/>
        <rdfs:label>Self Reference</rdfs:label>
        <oop:courseId>OM_OOP02</oop:courseId>
        <oop:definition>The conventional first parameter (self) in every instance method. Python passes the calling object automatically. Enables methods to read and write the object's own attributes.</oop:definition>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:enables rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#CM_OOP01"/>
        <oop:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#E_OOP_TYPE"/>
        <oop:isUsedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MOOP001"/>
      </owl:NamedIndividual>
    </oop:usesConcept>
    <oop:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#E_OOP_TYPE"/>
    <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
    <oop:exampleOf>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#OM_OOP01">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#OOPMechanism"/>
        <rdfs:label>Constructor</rdfs:label>
        <oop:courseId>OM_OOP01</oop:courseId>
        <oop:definition>The __init__ method called automatically when an object is created. Initialises all instance attributes. Part of every class definition.</oop:definition>
        <oop:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#L10"/>
        <oop:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP001"/>
        <oop:enables rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP007"/>
        <oop:isRequiredBy rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP007"/>
        <oop:hasExample rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#MOOP001"/>
      </owl:NamedIndividual>
    </oop:exampleOf>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/oop#exampleOf">
    <rdfs:label>example_of</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment>Named instance or exemplar of a general concept (e.g. a specific dunder method is an example of the Dunder Method mechanism)</rdfs:comment>
