  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#exampleOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>example_of</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment>Named instance or exemplar of a general concept (e.g. PATH is an example of Environment Variable)</rdfs:comment>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#hasExample"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#MethodRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>MethodRole</rdfs:label>
    <rdfs:comment>A contract role or category a method fulfills within a class</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/oop#DA_OOP03">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#DesignAbstraction"/>
    <rdfs:label>Composition</rdfs:label>
    <oop:courseId>DA_OOP03</oop:courseId>
    <oop:definition>The has-a design principle: building complex objects by containing instances of other objects rather than inheriting from them. Generally preferred over deep inheritance hierarchies.</oop:definition>
    <oop:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#COOP013"/>
  </rdf:Description>
