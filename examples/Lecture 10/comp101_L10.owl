  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#MOOP003">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Method"/>
    <rdfs:label>__repr__</rdfs:label>
    <oop:courseId>MOOP003</oop:courseId>
    <oop:definition>Returns an unambiguous developer-facing string representation. Called by repr() and shown in the REPL.</oop:definition>
    <oop:taughtIn>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/oop#L10">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#Lecture"/>
        <rdfs:label>Object-Oriented Programming</rdfs:label>
        <oop:courseId>L10</oop:courseId>
        <oop:definition>Lecture 10 of COMP101, covering object-oriented programming in Python: classes and objects, encapsulation, inheritance, polymorphism, method roles, dunder methods, and design abstractions.</oop:definition>
        <oop:teaches rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#PI_OOP04"/>
        <oop:teaches rdf:resource="http://comp101.sase.um6p.ma/ontology/oop#PI_OOP06"/>
