@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix oop: <http://comp101.sase.um6p.ma/ontology/oop#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://comp101.sase.um6p.ma/ontology/oop> a owl:Ontology ;
    dc:title "COMP101 OOP — Object-Oriented Programming" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "2.0" .

oop:CM_OOP05 a oop:ClassMember,
        owl:NamedIndividual ;
    rdfs:label "Method Signature" ;
    oop:courseId "CM_OOP05" ;
    oop:definition "The name and parameter list that define a method's interface contract: what it's called, how many arguments it takes, and what types are expected." ;
    oop:partOf oop:COOP001 ;
    oop:taughtIn oop:L10 .

oop:DA_OOP06 a oop:DesignAbstraction,
        owl:NamedIndividual ;
    rdfs:label "UML Class Diagram" ;
    oop:courseId "DA_OOP06" ;
    oop:definition "A standardised visual notation for class structure: shows classes, attributes, methods, and relationships (inheritance, composition, association) in a language-independent diagram." ;
    oop:taughtIn oop:L10 ;
    oop:usesConcept oop:COOP012,
        oop:COOP013,
        oop:COOP_ENC .

oop:DA_OOP07 a oop:DesignAbstraction,
        owl:NamedIndividual ;
    rdfs:label "Global State Problem" ;
    oop:contrastsWith oop:COOP012 ;
    oop:courseId "DA_OOP07" ;
    oop:definition "The anti-pattern where data is scattered across global variables, causing naming collisions, no shared behaviour, and copy-paste for every new feature. OOP solves this by bundling data with methods in a class." .

oop:Encoding a owl:Class ;
    rdfs:label "Encoding" ;
    rdfs:comment "A byte-to-symbol mapping standard" .

oop:FOOP001 a oop:BuiltInFunction,
        owl:NamedIndividual ;
    rdfs:label "super()" ;
    oop:courseId "FOOP001" ;
    oop:definition "Returns a proxy object for the parent class. Used inside a subclass method to call the parent's version of that method without hardcoding the parent class name." ;
    oop:taughtIn oop:L10 ;
    oop:usesConcept oop:COOP013 .

oop:FOOP002 a oop:BuiltInFunction,
        owl:NamedIndividual ;
    rdfs:label "isinstance()" ;
    oop:courseId "FOOP002" ;
    oop:definition "Returns True if an object is an instance of a class or a subclass. Key tool for type-safe polymorphic code." ;
    oop:taughtIn oop:L10 ;
    oop:usesConcept oop:COOP018,
        oop:COOP019 .

oop:FOOP003 a oop:BuiltInFunction,
        owl:NamedIndividual ;
    rdfs:label "hasattr()" ;
    oop:courseId "FOOP003" ;
    oop:definition "Returns True if an object has a named attribute. Core tool for duck-typing checks: test before you call." ;
    oop:taughtIn oop:L10 ;
    oop:usesConcept oop:COOP019 .

oop:MOOP001 a oop:Method,
        owl:NamedIndividual ;
    rdfs:label "__init__" ;
    oop:courseId "MOOP001" ;
    oop:definition "Constructor dunder method. Called automatically when a new object is created. Initialises all instance attributes via self." ;
    oop:partOf oop:OM_OOP01 ;
    oop:taughtIn oop:L10 ;
    oop:throwsError oop:E_OOP_TYPE ;
    oop:usesConcept oop:OM_OOP01,
        oop:OM_OOP02 .

oop:MOOP002 a oop:Method,
        owl:NamedIndividual ;
    rdfs:label "__str__" ;
    oop:courseId "MOOP002" ;
    oop:definition "Returns a human-readable string representation of the object. Called implicitly by print() and str()." ;
    oop:partOf oop:OM_OOP07 ;
    oop:producesType oop:DT_OOP_STR ;
    oop:taughtIn oop:L10 ;
    oop:usesConcept oop:OM_OOP07 .

oop:MOOP003 a oop:Method,
        owl:NamedIndividual ;
    rdfs:label "__repr__" ;
    oop:courseId "MOOP003" ;
    oop:definition "Returns an unambiguous developer-facing string representation. Called by repr() and shown in the REPL." ;
    oop:partOf oop:OM_OOP07 ;
    oop:producesType oop:DT_OOP_STR ;
    oop:taughtIn oop:L10 ;
    oop:usesConcept oop:OM_OOP07 .

oop:MOOP004 a oop:Method,
        owl:NamedIndividual ;
    rdfs:label "__eq__" ;
    oop:courseId "MOOP004" ;
    oop:definition "Defines equality between two objects. Called implicitly by the == operator. Without it, == compares object identity, not value." ;
    oop:partOf oop:OM_OOP07 ;
    oop:producesType oop:DT_OOP_BOOL ;
    oop:taughtIn oop:L10 ;
    oop:usesConcept oop:COOP_OBJ_ID,
        oop:OM_OOP07 .

oop:MOOP005 a oop:Method,
        owl:NamedIndividual ;
    rdfs:label "__len__" ;
    oop:courseId "MOOP005" ;
    oop:definition "Defines the length of an object. Called implicitly by len(). Allows user-defined classes to behave like built-in sequences." ;
    oop:partOf oop:OM_OOP07 ;
    oop:producesType oop:DT_OOP_INT ;
    oop:taughtIn oop:L10 ;
    oop:usesConcept oop:OM_OOP07 .

oop:PI_OOP01 a oop:PythonInternals,
        owl:NamedIndividual ;
    rdfs:label "Decorator" ;
    oop:courseId "PI_OOP01" ;
    oop:definition "A callable that wraps a function or class, modifying its behaviour without changing its source code. Written with @ syntax. Enables aspect-oriented patterns (logging, timing, access control)." ;
    oop:enables oop:COOP012 ;
    oop:taughtIn oop:L10 .

oop:PI_OOP02 a oop:PythonInternals,
        owl:NamedIndividual ;
    rdfs:label "Property Object" ;
    oop:courseId "PI_OOP02" ;
    oop:definition "The object created by the @property decorator. Intercepts attribute access (get, set, delete) on an instance, letting you define attribute access as method calls while keeping dot-notation syntax." ;
    oop:enables oop:COOP009 .

oop:PI_OOP03 a oop:PythonInternals,
        owl:NamedIndividual ;
    rdfs:label "Metaclass" ;
    oop:courseId "PI_OOP03" ;
    oop:definition "The class of a class. In Python every class is itself an object, and its metaclass (default: type) controls how the class is created, what attributes it has, and how subclassing works." ;
    oop:enables oop:COOP001 ;
    oop:taughtIn oop:L10 .

oop:PI_OOP05 a oop:PythonInternals,
        owl:NamedIndividual ;
    rdfs:label "__mro__" ;
    oop:courseId "PI_OOP05" ;
    oop:definition "The Method Resolution Order tuple on a class. Lists the exact sequence Python searches for attributes and methods when a class uses inheritance, following the C3 linearisation algorithm." .

oop:PI_OOP06 a oop:PythonInternals,
        owl:NamedIndividual ;
    rdfs:label "__slots__" ;
    oop:contrastsWith oop:PI_OOP04 ;
    oop:courseId "PI_OOP06" ;
    oop:definition "A class attribute that replaces the default __dict__ with a fixed set of allowed instance attribute names. Reduces per-instance memory overhead and prevents dynamic attribute creation." ;
    oop:taughtIn oop:L10 .

oop:SKOOP003 a oop:Skill,
        owl:NamedIndividual ;
    rdfs:label "Applying Polymorphism" ;
    oop:courseId "SKOOP003" ;
    oop:definition "Write code that operates on objects of different types through a shared interface, using method overriding and duck typing." ;
    oop:dependsOn oop:SKOOP002 ;
    oop:taughtIn oop:L10 ;
    oop:usesConcept oop:COOP019,
        oop:OM_OOP04 .

oop:SKOOP004 a oop:Skill,
        owl:NamedIndividual ;
    rdfs:label "Writing Dunder Methods" ;
    oop:courseId "SKOOP004" ;
    oop:definition "Implement special methods (__str__, __eq__, __len__) to integrate user-defined classes with Python built-in functions and operators." ;
    oop:taughtIn oop:L10 ;
    oop:usesConcept oop:OM_OOP07 .

oop:SKOOP005 a oop:Skill,
        owl:NamedIndividual ;
    rdfs:label "Enforcing Class Invariants" ;
    oop:courseId "SKOOP005" ;
    oop:definition "Use __init__ and setter methods to guarantee that object state always satisfies required constraints (e.g. hp is never negative)." ;
    oop:dependsOn oop:SKOOP001 ;
    oop:taughtIn oop:L10 ;
    oop:usesConcept oop:COOP013,
        oop:MR_OOP02 .

oop:SKOOP007 a oop:Skill,
        owl:NamedIndividual ;
    rdfs:label "Choosing Design Relationships" ;
    oop:courseId "SKOOP007" ;
    oop:definition "Choose between inheritance, composition, and an abstract interface when designing the relationship between two classes, and use mixins for reusable behaviour that doesn't fit a single hierarchy." ;
    oop:dependsOn oop:SKOOP002,
        oop:SKOOP006 ;
    oop:taughtIn oop:L10 ;
    oop:usesConcept oop:DA_OOP01,
        oop:DA_OOP02,
        oop:DA_OOP03,
        oop:DA_OOP04 .

oop:bestPractice a owl:DatatypeProperty ;
    rdfs:label "best_practice" ;
    rdfs:comment "Recommended approach or convention" ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

oop:cognitiveType a owl:DatatypeProperty ;
    rdfs:label "cognitive_type" ;
    rdfs:comment "Cognitive demand type: procedural | conceptual | theoretical" ;
    rdfs:domain oop:Concept ;
    rdfs:range xsd:string .

oop:commonCauses a owl:DatatypeProperty ;
    rdfs:label "common_causes" ;
    rdfs:comment "Common causes that trigger this error" ;
    rdfs:domain oop:ErrorType ;
    rdfs:range xsd:string .

oop:contrastsWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "contrasts_with" ;
    rdfs:comment "Alternatives, opposites, or commonly confused peers" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing .

oop:courseId a owl:DatatypeProperty ;
    rdfs:label "course_id" ;
    rdfs:comment "Original identifier for this entity (e.g. C_OOP01)" ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

oop:definition a owl:DatatypeProperty ;
    rdfs:label "definition" ;
    rdfs:comment "Plain-language definition of the entity" ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

oop:CM_OOP01 a oop:ClassMember,
        owl:NamedIndividual ;
    rdfs:label "Instance Attribute" ;
    oop:contrastsWith oop:CM_OOP02 ;
    oop:courseId "CM_OOP01" ;
    oop:definition "An attribute bound to a specific object via self (self.hp). Each object has its own independent copy." ;
    oop:partOf oop:COOP002 ;
    oop:taughtIn oop:L10 .

oop:CM_OOP02 a oop:ClassMember,
        owl:NamedIndividual ;
    rdfs:label "Class Attribute" ;
    oop:contrastsWith oop:CM_OOP01 ;
    oop:courseId "CM_OOP02" ;
    oop:definition "An attribute defined on the class body, shared across all instances unless shadowed by an instance attribute of the same name." ;
    oop:partOf oop:COOP001 ;
    oop:taughtIn oop:L10 .

oop:CM_OOP04 a oop:ClassMember,
        owl:NamedIndividual ;
    rdfs:label "Superclass" ;
    oop:contrastsWith oop:CM_OOP03 ;
    oop:courseId "CM_OOP04" ;
    oop:definition "The parent class whose attributes and methods are inherited by a subclass. Contains the common shared behaviour that child classes specialise." ;
    oop:partOf oop:COOP013 ;
    oop:taughtIn oop:L10 .

oop:COOP007 a oop:Concept,
        owl:NamedIndividual ;
    rdfs:label "Instantiation" ;
    oop:cognitiveType "procedural" ;
    oop:courseId "COOP007" ;
    oop:definition "The act of creating an object from a class by calling it like a function: Character('Arthur', 100, 15). Triggers __init__ automatically." ;
    oop:dependsOn oop:COOP001,
        oop:OM_OOP01 ;
    oop:taughtIn oop:L10 .

oop:COOP_OBJ_ID a oop:Concept,
        owl:NamedIndividual ;
    rdfs:label "Object Identity" ;
    oop:cognitiveType "conceptual" ;
    oop:courseId "COOP_OBJ_ID" ;
    oop:definition "The distinction between two objects being the same object in memory (is) versus having equal value (==). Without __eq__, == compares identity." ;
    oop:dependsOn oop:COOP002 ;
    oop:taughtIn oop:L10 .

oop:COOP_STATIC a oop:Concept,
        owl:NamedIndividual ;
    rdfs:label "Static Typing" ;
    oop:cognitiveType "conceptual" ;
    oop:contrastsWith oop:COOP019 ;
    oop:courseId "COOP_STATIC" ;
    oop:definition "Type system where variable types are checked at compile time, not runtime. Python uses dynamic typing; static typing languages (Java, C++) contrast with Python's approach." .

oop:DA_OOP02 a oop:DesignAbstraction,
        owl:NamedIndividual ;
    rdfs:label "Interface" ;
    oop:contrastsWith oop:COOP013 ;
    oop:courseId "DA_OOP02" ;
    oop:definition "A design abstraction defining a set of methods a class must implement without providing any implementation. Python achieves this via Abstract Base Classes or duck typing rather than a dedicated keyword." ;
    oop:taughtIn oop:L10 ;
    oop:usesConcept oop:COOP019 .

oop:DA_OOP03 a oop:DesignAbstraction,
        owl:NamedIndividual ;
    rdfs:label "Composition" ;
    oop:contrastsWith oop:COOP013 ;
    oop:courseId "DA_OOP03" ;
    oop:definition "The has-a design principle: building complex objects by containing instances of other objects rather than inheriting from them. Generally preferred over deep inheritance hierarchies." .

oop:DA_OOP04 a oop:DesignAbstraction,
        owl:NamedIndividual ;
    rdfs:label "Mixin" ;
    oop:courseId "DA_OOP04" ;
    oop:definition "A class designed to add a specific behaviour to other classes via multiple inheritance, without being intended as a standalone class. Provides reusable behaviour slices." ;
    oop:dependsOn oop:OM_OOP06 ;
    oop:partOf oop:DA_OOP05 ;
    oop:taughtIn oop:L10 .

oop:DA_OOP05 a oop:DesignAbstraction,
        owl:NamedIndividual ;
    rdfs:label "Design Pattern" ;
    oop:courseId "DA_OOP05" ;
    oop:definition "A named, reusable solution template for a recurring software design problem. Patterns (Factory, Strategy, Observer, etc.) are language-agnostic blueprints, not code." ;
    oop:taughtIn oop:L10 ;
    oop:usesConcept oop:COOP013,
        oop:COOP_ENC .

oop:DT_OOP_BOOL a oop:DataType,
        owl:NamedIndividual ;
    rdfs:label "bool" ;
    oop:courseId "DT_OOP_BOOL" ;
    oop:definition "Boolean — returned by __eq__ and comparison operators." .

oop:DT_OOP_INT a oop:DataType,
        owl:NamedIndividual ;
    rdfs:label "int" ;
    oop:courseId "DT_OOP_INT" ;
    oop:definition "Integer — returned by __len__." .

oop:E_OOP_ATTR a oop:ErrorType,
        owl:NamedIndividual ;
    rdfs:label "AttributeError" ;
    oop:courseId "E_OOP_ATTR" ;
    oop:definition "Raised when accessing an attribute that does not exist, or accessing a name-mangled attribute directly from outside the class." ;
    oop:taughtIn oop:L10 .

oop:E_OOP_TYPE a oop:ErrorType,
        owl:NamedIndividual ;
    rdfs:label "TypeError" ;
    oop:courseId "E_OOP_TYPE" ;
    oop:definition "Raised when wrong number of arguments passed to __init__, or incompatible types used in an operation." ;
    oop:taughtIn oop:L10 .

oop:MR_OOP01 a oop:MethodRole,
        owl:NamedIndividual ;
    rdfs:label "Getter Method" ;
    oop:contrastsWith oop:MR_OOP02 ;
    oop:courseId "MR_OOP01" ;
    oop:definition "A public method that safely returns the value of a private attribute. The only sanctioned way to read hidden state." ;
    oop:enables oop:COOP009 ;
    oop:partOf oop:COOP_ENC ;
    oop:taughtIn oop:L10 .

oop:MR_OOP03 a oop:MethodRole,
        owl:NamedIndividual ;
    rdfs:label "Abstract Method" ;
    oop:courseId "MR_OOP03" ;
    oop:definition "A method declared in a parent class with no implementation body. Forces every subclass to provide its own implementation. Defined via @abstractmethod." ;
    oop:partOf oop:DA_OOP01 ;
    oop:taughtIn oop:L10 .

oop:MR_OOP04 a oop:MethodRole,
        owl:NamedIndividual ;
    rdfs:label "Class Method" ;
    oop:courseId "MR_OOP04" ;
    oop:definition "A method that receives the class itself (not an instance) as its first argument. Defined with @classmethod. Used for alternative constructors or class-level operations." ;
    oop:partOf oop:COOP001 ;
    oop:taughtIn oop:L10 .

oop:MR_OOP05 a oop:MethodRole,
        owl:NamedIndividual ;
    rdfs:label "Static Method" ;
    oop:courseId "MR_OOP05" ;
    oop:definition "A method with no implicit first argument — neither instance nor class. Defined with @staticmethod. Behaves like a plain function that lives in the class namespace." ;
    oop:partOf oop:COOP001 ;
    oop:taughtIn oop:L10 .

oop:OM_OOP02 a oop:OOPMechanism,
        owl:NamedIndividual ;
    rdfs:label "Self Reference" ;
    oop:courseId "OM_OOP02" ;
    oop:definition "The conventional first parameter (self) in every instance method. Python passes the calling object automatically. Enables methods to read and write the object's own attributes." ;
    oop:enables oop:COOP001 ;
    oop:taughtIn oop:L10 .

oop:OM_OOP05 a oop:OOPMechanism,
        owl:NamedIndividual ;
    rdfs:label "super() Call" ;
    oop:courseId "OM_OOP05" ;
    oop:definition "Calling super() inside a subclass method returns a proxy for the parent class, allowing the child to invoke the parent's implementation without hardcoding the parent's name." ;
    oop:enables oop:COOP013 ;
    oop:taughtIn oop:L10 .

oop:OM_OOP06 a oop:OOPMechanism,
        owl:NamedIndividual ;
    rdfs:label "Multiple Inheritance" ;
    oop:courseId "OM_OOP06" ;
    oop:definition "A Python class can inherit from more than one parent class simultaneously, acquiring attributes and methods from all of them. Method Resolution Order (MRO) determines lookup order." ;
    oop:partOf oop:COOP013 ;
    oop:taughtIn oop:L10 .

oop:PI_OOP04 a oop:PythonInternals,
        owl:NamedIndividual ;
    rdfs:label "__dict__" ;
    oop:courseId "PI_OOP04" ;
    oop:definition "The dictionary that stores an object's (or class's) attribute namespace. Instance __dict__ holds per-object attributes; class __dict__ holds class-level attributes and methods." .

oop:SKOOP001 a oop:Skill,
        owl:NamedIndividual ;
    rdfs:label "Implementing Encapsulation" ;
    oop:courseId "SKOOP001" ;
    oop:definition "Apply name mangling to hide internal state and write getter/setter methods that enforce class invariants." ;
    oop:taughtIn oop:L10 ;
    oop:usesConcept oop:MR_OOP01,
        oop:MR_OOP02,
        oop:OM_OOP03 .

oop:SKOOP006 a oop:Skill,
        owl:NamedIndividual ;
    rdfs:label "Choosing Method Roles" ;
    oop:courseId "SKOOP006" ;
    oop:definition "Choose the correct method role -- instance method, @classmethod, @staticmethod, or @abstractmethod -- for a given design need, and predict what each is (and isn't) allowed to access." ;
    oop:dependsOn oop:SKOOP002 ;
    oop:taughtIn oop:L10 ;
    oop:usesConcept oop:MR_OOP03,
        oop:MR_OOP04,
        oop:MR_OOP05 .

oop:dependsOn a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "depends_on" ;
    rdfs:comment "Prerequisite ordering between concepts and skills" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    owl:inverseOf oop:isRequiredBy .

oop:enabledBy a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "enabled_by" ;
    rdfs:comment "Inverse of enables — this concept is made possible by a mechanism" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    owl:inverseOf oop:enables .

oop:enables a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "enables" ;
    rdfs:comment "Mechanism or role that makes this concept possible in Python" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    owl:inverseOf oop:enabledBy .

oop:exampleOf a owl:ObjectProperty ;
    rdfs:label "example_of" ;
    rdfs:comment "Named instance or exemplar of a general concept (e.g. PATH is an example of Environment Variable)" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    owl:inverseOf oop:hasExample .

oop:hasExample a owl:ObjectProperty ;
    rdfs:label "has_example" ;
    rdfs:comment "Inverse of example_of — this concept has the linked entity as a named exemplar" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    owl:inverseOf oop:exampleOf .

oop:hasPart a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has_part" ;
    rdfs:comment "Inverse of part_of — this entity contains another as a component" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    owl:inverseOf oop:partOf .

oop:implementedBy a owl:ObjectProperty ;
    rdfs:label "implemented_by" ;
    rdfs:comment "Concept realised by a language construct, OOP mechanism, or Python internal" ;
    rdfs:domain oop:Concept ;
    rdfs:range oop:ImplementorType ;
    owl:inverseOf oop:implements .

oop:implements a owl:ObjectProperty ;
    rdfs:label "implements" ;
    rdfs:comment "Inverse of implemented_by — this construct or mechanism implements a concept" ;
    rdfs:domain oop:ImplementorType ;
    rdfs:range oop:Concept ;
    owl:inverseOf oop:implementedBy .

oop:isProducedBy a owl:ObjectProperty ;
    rdfs:label "is_produced_by" ;
    rdfs:comment "Inverse of produces_type — this type is produced by a method" ;
    rdfs:domain oop:DataType ;
    rdfs:range oop:Method ;
    owl:inverseOf oop:producesType .

oop:isRequiredBy a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "is_required_by" ;
    rdfs:comment "Inverse of depends_on — this entity is a prerequisite for another" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    owl:inverseOf oop:dependsOn .

oop:isThrownBy a owl:ObjectProperty ;
    rdfs:label "is_thrown_by" ;
    rdfs:comment "Inverse of throws_error — this error is thrown by a concept or mechanism" ;
    rdfs:domain oop:ErrorType ;
    rdfs:range owl:Thing ;
    owl:inverseOf oop:throwsError .

oop:isUsedBy a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "is_used_by" ;
    rdfs:comment "Inverse of uses_concept — this concept is used by another entity" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    owl:inverseOf oop:usesConcept .

oop:partOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "part_of" ;
    rdfs:comment "Compositional containment — transitive" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    owl:inverseOf oop:hasPart .

oop:producesType a owl:ObjectProperty ;
    rdfs:label "produces_type" ;
    rdfs:comment "Return type" ;
    rdfs:domain oop:Method ;
    rdfs:range oop:DataType ;
    owl:inverseOf oop:isProducedBy .

oop:taughtIn a owl:ObjectProperty ;
    rdfs:label "taught_in" ;
    rdfs:comment "First introduced in this lecture" ;
    rdfs:domain owl:Thing ;
    rdfs:range oop:Lecture ;
    owl:inverseOf oop:teaches .

oop:teaches a owl:ObjectProperty ;
    rdfs:label "teaches" ;
    rdfs:comment "Inverse of taught_in — this lecture teaches the linked entity" ;
    rdfs:domain oop:Lecture ;
    rdfs:range owl:Thing ;
    owl:inverseOf oop:taughtIn .

oop:throwsError a owl:ObjectProperty ;
    rdfs:label "throws_error" ;
    rdfs:comment "Misuse causes this error" ;
    rdfs:domain owl:Thing ;
    rdfs:range oop:ErrorType ;
    owl:inverseOf oop:isThrownBy .

oop:usesConcept a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "uses_concept" ;
    rdfs:comment "Entity operationalises or draws on a concept or mechanism" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    owl:inverseOf oop:isUsedBy .

oop:CM_OOP03 a oop:ClassMember,
        owl:NamedIndividual ;
    rdfs:label "Subclass" ;
    oop:contrastsWith oop:CM_OOP04 ;
    oop:courseId "CM_OOP03" ;
    oop:definition "A class that inherits from one or more parent classes. Can add new attributes/methods or override existing ones via Method Overriding." ;
    oop:partOf oop:COOP013 ;
    oop:taughtIn oop:L10 .

oop:COOP002 a oop:Concept,
        owl:NamedIndividual ;
    rdfs:label "Object" ;
    oop:cognitiveType "conceptual" ;
    oop:courseId "COOP002" ;
    oop:definition "An instance of a class — the actual thing created from the blueprint. Each object has its own copy of instance attributes." ;
    oop:dependsOn oop:COOP001 ;
    oop:taughtIn oop:L10 .

oop:DA_OOP01 a oop:DesignAbstraction,
        owl:NamedIndividual ;
    rdfs:label "Abstract Class" ;
    oop:courseId "DA_OOP01" ;
    oop:definition "A class that cannot be instantiated directly and contains at least one abstract method. Enforces a contract: all concrete subclasses must implement the abstract methods." ;
    oop:dependsOn oop:COOP013 ;
    oop:taughtIn oop:L10 .

oop:DT_OOP_STR a oop:DataType,
        owl:NamedIndividual ;
    rdfs:label "str" ;
    oop:courseId "DT_OOP_STR" ;
    oop:definition "Python's text type — returned by __str__ and __repr__." ;
    oop:taughtIn oop:L10 .

oop:ImplementorType a owl:Class ;
    rdfs:label "ImplementorType" ;
    rdfs:comment "Union of LanguageConstruct, Method, OOPMechanism, and PythonInternals — entity types that can implement a Concept" ;
    owl:unionOf ( oop:LanguageConstruct oop:Method oop:OOPMechanism oop:PythonInternals ) .

oop:OM_OOP03 a oop:OOPMechanism,
        owl:NamedIndividual ;
    rdfs:label "Name Mangling" ;
    oop:courseId "OM_OOP03" ;
    oop:definition "The Python convention of prefixing an attribute with __ so it becomes _ClassName__attr internally. Discourages direct access from outside the class." ;
    oop:enables oop:COOP009 ;
    oop:taughtIn oop:L10 .

oop:OM_OOP04 a oop:OOPMechanism,
        owl:NamedIndividual ;
    rdfs:label "Method Overriding" ;
    oop:courseId "OM_OOP04" ;
    oop:definition "A subclass redefines a method that already exists in the parent class. The overriding method replaces or extends the parent's behaviour for that specific type." ;
    oop:enables oop:COOP018 ;
    oop:taughtIn oop:L10 .

oop:COOP012 a oop:Concept,
        owl:NamedIndividual ;
    rdfs:label "Abstraction" ;
    oop:cognitiveType "conceptual" ;
    oop:contrastsWith oop:COOP_ENC ;
    oop:courseId "COOP012" ;
    oop:definition "Simplifying how others use your code by exposing a clean public interface and hiding internal implementation detail. Focus on WHAT is exposed, not HOW it works internally." ;
    oop:dependsOn oop:COOP_ENC ;
    oop:taughtIn oop:L10 .

oop:COOP018 a oop:Concept,
        owl:NamedIndividual ;
    rdfs:label "Polymorphism" ;
    oop:cognitiveType "theoretical" ;
    oop:courseId "COOP018" ;
    oop:definition "The ability to use the same interface with objects of different types. The correct method is chosen at runtime based on the actual type of the object." ;
    oop:dependsOn oop:COOP013,
        oop:OM_OOP04 ;
    oop:taughtIn oop:L10 .

oop:LC_OOP_CLASS a oop:LanguageConstruct,
        owl:NamedIndividual ;
    rdfs:label "class definition" ;
    oop:courseId "LC_OOP_CLASS" ;
    oop:definition "The class keyword syntax. Defines a new class: class Name(Parent):" ;
    oop:partOf oop:COOP001 ;
    oop:taughtIn oop:L10 .

oop:LanguageConstruct a owl:Class ;
    rdfs:label "LanguageConstruct" ;
    rdfs:comment "A Python syntax element" .

oop:MR_OOP02 a oop:MethodRole,
        owl:NamedIndividual ;
    rdfs:label "Setter Method" ;
    oop:courseId "MR_OOP02" ;
    oop:definition "A public method that safely sets a private attribute with optional validation. Enforces class invariants on mutation." ;
    oop:enables oop:COOP009 ;
    oop:partOf oop:COOP_ENC ;
    oop:taughtIn oop:L10 .

oop:OM_OOP01 a oop:OOPMechanism,
        owl:NamedIndividual ;
    rdfs:label "Constructor" ;
    oop:courseId "OM_OOP01" ;
    oop:definition "The __init__ method called automatically when an object is created. Initialises all instance attributes. Part of every class definition." ;
    oop:enables oop:COOP007 ;
    oop:partOf oop:COOP001 ;
    oop:taughtIn oop:L10 .

oop:SKOOP002 a oop:Skill,
        owl:NamedIndividual ;
    rdfs:label "Applying Inheritance" ;
    oop:courseId "SKOOP002" ;
    oop:definition "Create subclasses that extend a parent class, call super().__init__() correctly, and override methods to specialise behaviour." ;
    oop:taughtIn oop:L10 ;
    oop:usesConcept oop:CM_OOP03,
        oop:OM_OOP05 .

oop:BuiltInFunction a owl:Class ;
    rdfs:label "BuiltInFunction" ;
    rdfs:comment "A native Python function" .

oop:Lecture a owl:Class ;
    rdfs:label "Lecture" ;
    rdfs:comment "A course lecture unit" .

oop:COOP009 a oop:Concept,
        owl:NamedIndividual ;
    rdfs:label "Data Hiding" ;
    oop:cognitiveType "conceptual" ;
    oop:courseId "COOP009" ;
    oop:definition "The principle of restricting direct access to an object's internal state so that invariants can be enforced. Achieved in Python via name mangling." ;
    oop:dependsOn oop:OM_OOP03 ;
    oop:taughtIn oop:L10 ;
    oop:throwsError oop:E_OOP_ATTR .

oop:COOP019 a oop:Concept,
        owl:NamedIndividual ;
    rdfs:label "Duck Typing" ;
    oop:cognitiveType "theoretical" ;
    oop:contrastsWith oop:COOP_STATIC ;
    oop:courseId "COOP019" ;
    oop:definition "Python's implicit form of polymorphism: if an object has the required method, it can be used regardless of its class. 'If it walks like a duck and quacks like a duck, it is a duck.'" ;
    oop:dependsOn oop:COOP018,
        oop:OM_OOP07 ;
    oop:taughtIn oop:L10 .

oop:COOP_ENC a oop:Concept,
        owl:NamedIndividual ;
    rdfs:label "Encapsulation" ;
    oop:cognitiveType "conceptual" ;
    oop:courseId "COOP_ENC" ;
    oop:definition "Bundling data and behaviour together inside a class, controlling access to enforce invariants." ;
    oop:dependsOn oop:COOP001,
        oop:COOP009 ;
    oop:implementedBy oop:LC_OOP_CLASS ;
    oop:taughtIn oop:L10 .

oop:ClassMember a owl:Class ;
    rdfs:label "ClassMember" ;
    rdfs:comment "A named structural element belonging to a class or hierarchy" .

oop:DataType a owl:Class ;
    rdfs:label "DataType" ;
    rdfs:comment "A Python data type" .

oop:ErrorType a owl:Class ;
    rdfs:label "ErrorType" ;
    rdfs:comment "A Python exception type" .

oop:MethodRole a owl:Class ;
    rdfs:label "MethodRole" ;
    rdfs:comment "A contract role or category a method fulfills within a class" .

oop:DesignAbstraction a owl:Class ;
    rdfs:label "DesignAbstraction" ;
    rdfs:comment "A language-agnostic design vocabulary item" .

oop:PythonInternals a owl:Class ;
    rdfs:label "PythonInternals" ;
    rdfs:comment "A CPython meta-programming mechanism" .

oop:Skill a owl:Class ;
    rdfs:label "Skill" ;
    rdfs:comment "A transferable cognitive operation" .

oop:Method a owl:Class ;
    rdfs:label "Method" ;
    rdfs:comment "A type-specific callable" .

oop:OOPMechanism a owl:Class ;
    rdfs:label "OOPMechanism" ;
    rdfs:comment "A concrete OOP operational mechanism in Python" .

oop:OM_OOP07 a oop:OOPMechanism,
        owl:NamedIndividual ;
    rdfs:label "Dunder Method" ;
    oop:courseId "OM_OOP07" ;
    oop:definition "Special methods surrounded by double underscores (__init__, __str__, __eq__). Called implicitly by Python operators and built-in functions rather than by direct name." ;
    oop:enables oop:COOP019 ;
    oop:partOf oop:COOP001 ;
    oop:taughtIn oop:L10 .

oop:COOP013 a oop:Concept,
        owl:NamedIndividual ;
    rdfs:label "Inheritance" ;
    oop:bestPractice "Keep parent class logic general; specialise only in the child class." ;
    oop:cognitiveType "conceptual" ;
    oop:courseId "COOP013" ;
    oop:definition "A mechanism where a child class acquires all attributes and methods of a parent class, enabling code reuse and specialisation." ;
    oop:dependsOn oop:COOP001 ;
    oop:implementedBy oop:LC_OOP_CLASS ;
    oop:taughtIn oop:L10 .

oop:COOP001 a oop:Concept,
        owl:NamedIndividual ;
    rdfs:label "Class" ;
    oop:cognitiveType "conceptual" ;
    oop:courseId "COOP001" ;
    oop:definition "A blueprint/template that defines the attributes and methods all objects of that type will have. Does not occupy memory until instantiated." ;
    oop:implementedBy oop:LC_OOP_CLASS ;
    oop:taughtIn oop:L10 .

oop:Concept a owl:Class ;
    rdfs:label "Concept" ;
    rdfs:comment "An abstract theoretical foundation" .

oop:L10 a oop:Lecture,
        owl:NamedIndividual ;
    rdfs:label "Object-Oriented Programming" ;
    oop:courseId "L10" .

[] a owl:AllDisjointClasses ;
    owl:members ( oop:Lecture oop:Concept oop:LanguageConstruct oop:DataType oop:ErrorType oop:BuiltInFunction oop:Method oop:Skill oop:OOPMechanism oop:ClassMember oop:MethodRole oop:DesignAbstraction oop:PythonInternals ) .

