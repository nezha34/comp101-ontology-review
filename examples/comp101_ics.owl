   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SK_ICS02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Skill"/>
    <rdfs:label>Trace Python's full execution pipeline</rdfs:label>
    <ics:courseId>SK_ICS02</ics:courseId>
    <ics:definition>Explain the chain of events when python script.py runs: the OS creates a process with a PID, allocates stack and heap memory, connects stdin/stdout/stderr, the interpreter compiles source to bytecode, the bytecode loop runs, and the garbage collector reclaims objects as references drop to zero.</ics:definition>
    <ics:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SK_ICS01"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#F_ICS01"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#RE_ICS03"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#RE_ICS04"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#RE_ICS05"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS02"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS03"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS04"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SM_ICS01"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SM_ICS03"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SM_ICS06"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SM_ICS08"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SM_ICS09"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SM_ICS10"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SM_ICS11"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SM_ICS12"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SP_ICS01"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#HC_ICS06">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#HardwareComponent"/>
    <rdfs:label>L3 Cache</rdfs:label>
    <ics:courseId>HC_ICS06</ics:courseId>
    <ics:definition>Largest CPU cache, shared across all cores. Last level before RAM in the memory hierarchy.</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#HC_ICS01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#producesType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>produces_type</rdfs:label>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Method"/>
    <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#DataType"/>
    <rdfs:comment>Return type</rdfs:comment>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#isProducedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SP_ICS04">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemProperty"/>
    <rdfs:label>Absolute Path</rdfs:label>
    <ics:courseId>SP_ICS04</ics:courseId>
    <ics:definition>A file path starting from the filesystem root (/ on Unix, C:\ on Windows). Unambiguous regardless of the process's working directory.</ics:definition>
    <ics:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SP_ICS05"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#HC_ICS04">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#HardwareComponent"/>
    <rdfs:label>L1 Cache</rdfs:label>
    <ics:courseId>HC_ICS04</ics:courseId>
    <ics:definition>Smallest, fastest CPU cache — private to each core. Stores recently used instructions and data.</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#HC_ICS02"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#HC_ICS07">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#HardwareComponent"/>
    <rdfs:label>RAM</rdfs:label>
    <ics:courseId>HC_ICS07</ics:courseId>
    <ics:definition>Random Access Memory — fast volatile storage. Holds the running process's code, stack, heap, and OS data.</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:managedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#RuntimeEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>RuntimeEntity</rdfs:label>
    <rdfs:comment>A concrete artifact or agent that exists at runtime</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SK_ICS07">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Skill"/>
    <rdfs:label>Diagnose a bug by tracing it to its layer</rdfs:label>
    <ics:courseId>SK_ICS07</ics:courseId>
    <ics:definition>Given any error or unexpected behaviour, assign it to the correct layer (Python code, Python Runtime, OS, Hardware), explain why patching a different layer cannot fix it, and identify the correct layer-appropriate fix — this is the synthesis of all ICS skills applied to real debugging.</ics:definition>
    <ics:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SK_ICS01"/>
    <ics:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SK_ICS02"/>
    <ics:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SK_ICS03"/>
    <ics:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SK_ICS04"/>
    <ics:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SK_ICS05"/>
    <ics:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SK_ICS06"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS01"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS09"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#HC_ICS05">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#HardwareComponent"/>
    <rdfs:label>L2 Cache</rdfs:label>
    <ics:courseId>HC_ICS05</ics:courseId>
    <ics:definition>Larger, slightly slower cache shared between a few cores. Second level in the cache hierarchy.</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#HC_ICS01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#enables">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label>enables</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment>Mechanism or role that makes this concept possible in Python</rdfs:comment>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#enabledBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS07">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemLayer"/>
    <rdfs:label>Device Driver</rdfs:label>
    <ics:courseId>SL_ICS07</ics:courseId>
    <ics:definition>Software that runs inside the kernel and translates generic OS requests into hardware-specific commands for a particular device (disk, GPU, network card).</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS02"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#commonCauses">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>common_causes</rdfs:label>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#ErrorType"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Common causes that trigger this error</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SM_ICS01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemMechanism"/>
    <rdfs:label>System Call</rdfs:label>
    <ics:courseId>SM_ICS01</ics:courseId>
    <ics:definition>The controlled transition from user space (Ring 3) to kernel space (Ring 0). Every time Python opens a file, prints text, or allocates memory, it issues a system call.</ics:definition>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SM_ICS02"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS06"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:managedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS02"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#teaches">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>teaches</rdfs:label>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Lecture"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#taughtIn"/>
    <rdfs:comment>Inverse of taught_in — this lecture teaches the linked entity</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#ENC_ICS01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Encoding"/>
    <rdfs:label>ASCII</rdfs:label>
    <ics:courseId>ENC_ICS01</ics:courseId>
    <ics:definition>Maps bytes 0–127 to English characters and basic symbols. 1 byte per character. Cannot represent accented, Arabic, or CJK characters.</ics:definition>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS21"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#bestPractice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>best_practice</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Recommended approach or convention</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#HC_ICS08">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#HardwareComponent"/>
    <rdfs:label>SSD / Hard Disk</rdfs:label>
    <ics:courseId>HC_ICS08</ics:courseId>
    <ics:definition>Persistent non-volatile storage. Programs and files live here when not running. Much slower than RAM.</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:managedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#F_ICS01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#BuiltInFunction"/>
    <rdfs:label>os.getpid()</rdfs:label>
    <ics:courseId>F_ICS01</ics:courseId>
    <ics:definition>Returns the integer PID of the current process. Useful for logging, debugging, and process management.</ics:definition>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SP_ICS01"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#RE_ICS01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#RuntimeEntity"/>
    <rdfs:label>Process</rdfs:label>
    <ics:courseId>RE_ICS01</ics:courseId>
    <ics:definition>A running instance of a program, created by the OS. Has its own isolated memory (stack + heap), a PID, open file handles, and its own environment.</ics:definition>
    <ics:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#RE_ICS02"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:managedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#usesConcept">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label>uses_concept</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment>Entity operationalises or draws on a concept or mechanism</rdfs:comment>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#isUsedBy"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7633ef2ccc1744c5967c93758fb8ad94">
    <rdf:first rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemMechanism"/>
    <rdf:rest rdf:nodeID="Ne3f7cee20792481abdec514214339899"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#HC_ICS01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#HardwareComponent"/>
    <rdfs:label>CPU</rdfs:label>
    <ics:courseId>HC_ICS01</ics:courseId>
    <ics:definition>Central Processing Unit — executes instructions. Contains cores, registers, and cache levels.</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:managedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#cognitiveType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>cognitive_type</rdfs:label>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Concept"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Cognitive demand type: procedural | conceptual | theoretical</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS05">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemLayer"/>
    <rdfs:label>JIT Compiler</rdfs:label>
    <ics:courseId>SL_ICS05</ics:courseId>
    <ics:definition>Just-In-Time compiler: compiles frequently-run code to native machine code at runtime rather than interpreting bytecode. Used in PyPy, Numba, and other Python implementations.</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS03"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#C_ICS09">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Concept"/>
    <rdfs:label>Wrong Layer Bug</rdfs:label>
    <ics:courseId>C_ICS09</ics:courseId>
    <ics:definition>A debugging anti-pattern: changing Python code to fix a bug that actually lives in the OS layer (wrong path, wrong permission, wrong encoding). The fix is at a different layer than where the symptom appears.</ics:definition>
    <ics:cognitiveType>conceptual</ics:cognitiveType>
    <ics:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS01"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#ENC_ICS02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Encoding"/>
    <rdfs:label>UTF-8</rdfs:label>
    <ics:courseId>ENC_ICS02</ics:courseId>
    <ics:definition>Variable-length encoding for (almost) all written human languages. Uses 1–4 bytes per character. Keeps ASCII unchanged (bytes 0–127 are identical), making it the universal default for the web and modern file systems.</ics:definition>
    <ics:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#ENC_ICS01"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS21"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SM_ICS07">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemMechanism"/>
    <rdfs:label>Memory Page</rdfs:label>
    <ics:courseId>SM_ICS07</ics:courseId>
    <ics:definition>The unit of virtual memory management (typically 4 KB). The OS moves pages between RAM and disk; a page fault stalls the process until the page is loaded.</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SM_ICS06"/>
    <ics:managedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#HC_ICS03">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#HardwareComponent"/>
    <rdfs:label>CPU Register</rdfs:label>
    <ics:courseId>HC_ICS03</ics:courseId>
    <ics:definition>The fastest storage in the memory hierarchy, inside the CPU core. Holds the values the CPU is actively computing on.</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#HC_ICS02"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SM_ICS12">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemMechanism"/>
    <rdfs:label>stderr</rdfs:label>
    <ics:courseId>SM_ICS12</ics:courseId>
    <ics:definition>Standard error stream — the process's output channel for error messages and tracebacks. Separate from stdout so errors can be filtered independently.</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#RE_ICS01"/>
    <ics:managedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SK_ICS05">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Skill"/>
    <rdfs:label>Convert between bytes and text with explicit encoding</rdfs:label>
    <ics:courseId>SK_ICS05</ics:courseId>
    <ics:definition>Know that the OS delivers raw bytes and Python must decode them to str; apply str.encode() and bytes.decode() with an explicit encoding, always specify encoding= when opening text files, and diagnose UnicodeDecodeError as a mismatch between the bytes on disk and the codec applied.</ics:definition>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS21"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS22"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#ENC_ICS01"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#ENC_ICS02"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#M_ICS01"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#M_ICS02"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#DT_ICS01"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#DT_ICS02"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#enabledBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label>enabled_by</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#enables"/>
    <rdfs:comment>Inverse of enables — this concept is made possible by a mechanism</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#HC_ICS02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#HardwareComponent"/>
    <rdfs:label>CPU Core</rdfs:label>
    <ics:courseId>HC_ICS02</ics:courseId>
    <ics:definition>An independent processing unit within the CPU. Modern CPUs have multiple cores running threads in parallel.</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#HC_ICS01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#C_ICS22">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Concept"/>
    <rdfs:label>str vs bytes Distinction</rdfs:label>
    <ics:courseId>C_ICS22</ics:courseId>
    <ics:definition>Python's fundamental text/data duality: str is decoded text carrying meaning; bytes is raw binary data. The OS reads/writes bytes; Python converts between them via an encoding.</ics:definition>
    <ics:cognitiveType>conceptual</ics:cognitiveType>
    <ics:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS21"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#C_ICS01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Concept"/>
    <rdfs:label>Layer Model</rdfs:label>
    <ics:courseId>C_ICS01</ics:courseId>
    <ics:definition>The four-layer abstraction stack that every running Python program sits inside: Your Python Code → Python Runtime → Operating System → Hardware. Bugs at one layer cannot be fixed by changing a different layer.</ics:definition>
    <ics:cognitiveType>conceptual</ics:cognitiveType>
    <ics:bestPractice>Identify which layer a bug lives in before touching code — most 'mysterious' bugs are OS-level (paths, permissions, encodings).</ics:bestPractice>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#isUsedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label>is_used_by</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#usesConcept"/>
    <rdfs:comment>Inverse of uses_concept — this concept is used by another entity</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#throwsError">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>throws_error</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#ErrorType"/>
    <rdfs:comment>Misuse causes this error</rdfs:comment>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#isThrownBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#isProducedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>is_produced_by</rdfs:label>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#DataType"/>
    <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Method"/>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#producesType"/>
    <rdfs:comment>Inverse of produces_type — this type is produced by a method</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#implementedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>implemented_by</rdfs:label>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Concept"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment>Concept realised by a language construct, OOP mechanism, or Python internal</rdfs:comment>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#implements"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#RE_ICS04">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#RuntimeEntity"/>
    <rdfs:label>Bytecode</rdfs:label>
    <ics:courseId>RE_ICS04</ics:courseId>
    <ics:definition>The intermediate representation Python compiles your source code into before execution. Machine-independent; interpreted by CPython's bytecode loop.</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:managedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS04"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SP_ICS03">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemProperty"/>
    <rdfs:label>PATH</rdfs:label>
    <ics:courseId>SP_ICS03</ics:courseId>
    <ics:definition>The environment variable listing directories the OS searches when you type a command. Determines whether `python` resolves to the right executable.</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SP_ICS02"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ncdacf8251abf4929932be31103ff022e">
    <rdf:first rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Method"/>
    <rdf:rest rdf:nodeID="Nd030bea34a644fabbe9e985c793b8ab3"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#courseId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>course_id</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Original identifier for this entity (e.g. C_OOP01)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N8aee02b228d54a1580bb4053b9dc3e12">
    <rdf:first rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#HardwareComponent"/>
    <rdf:rest rdf:nodeID="N1ceae9fee5b14b92b726ae7a4ca6d1a9"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SK_ICS01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Skill"/>
    <rdfs:label>Understand a process as the OS unit of execution</rdfs:label>
    <ics:courseId>SK_ICS01</ics:courseId>
    <ics:definition>Distinguish a program (static file on disk) from a process (running instance created by the OS), explain that each process runs in isolation with its own memory space, and identify the OS as the entity that creates, schedules, and destroys processes.</ics:definition>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#HC_ICS01"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#HC_ICS07"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#RE_ICS01"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#RE_ICS02"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS01"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS06"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#C_ICS14">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Concept"/>
    <rdfs:label>Working Directory</rdfs:label>
    <ics:courseId>C_ICS14</ics:courseId>
    <ics:definition>The current working directory (CWD) — the folder a process uses as its base for resolving relative file paths. A script that works on one machine can fail with FileNotFoundError on another if launched from a different CWD.</ics:definition>
    <ics:cognitiveType>procedural</ics:cognitiveType>
    <ics:bestPractice>Always use absolute paths or explicitly set the CWD when writing scripts that read/write files.</ics:bestPractice>
    <ics:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#RE_ICS01"/>
    <ics:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SP_ICS05"/>
    <ics:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#E_ICS02"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SM_ICS05">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemMechanism"/>
    <rdfs:label>File System</rdfs:label>
    <ics:courseId>SM_ICS05</ics:courseId>
    <ics:definition>The OS abstraction that organises persistent storage into files and directories. Mediates all disk reads/writes and enforces permissions.</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:managedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#partOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label>part_of</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment>Compositional containment — transitive</rdfs:comment>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#hasPart"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#hasPart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label>has_part</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#partOf"/>
    <rdfs:comment>Inverse of part_of — this entity contains another as a component</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS06">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemLayer"/>
    <rdfs:label>Hardware Layer</rdfs:label>
    <ics:courseId>SL_ICS06</ics:courseId>
    <ics:definition>The named bottom layer of the execution stack in the ICS layer model: physical CPU, memory, and devices. Everything runs on this layer.</ics:definition>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS01"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemLayer"/>
    <rdfs:label>Operating System</rdfs:label>
    <ics:courseId>SL_ICS01</ics:courseId>
    <ics:definition>The software system that manages all hardware and provides services to applications. Python never talks to hardware directly — it asks the OS.</ics:definition>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS01"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N0ad93724146546299124cc6de2a4dcf3">
    <rdf:first rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#BuiltInFunction"/>
    <rdf:rest rdf:nodeID="Ncdacf8251abf4929932be31103ff022e"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N3339c6da9c6b4c9b93184fa349e8d301">
    <rdf:first rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#LanguageConstruct"/>
    <rdf:rest rdf:nodeID="N3381e8e728204b5ca4a9bc06c69b0bd3"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#manages">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>manages</rdfs:label>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemLayer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#managedBy"/>
    <rdfs:comment>Inverse of managed_by — this system layer manages the entity</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#Concept">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Concept</rdfs:label>
    <rdfs:comment>An abstract theoretical foundation</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#RE_ICS05">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#RuntimeEntity"/>
    <rdfs:label>Garbage Collection</rdfs:label>
    <ics:courseId>RE_ICS05</ics:courseId>
    <ics:definition>Python's automatic memory reclamation process. Tracks reference counts for all heap objects; frees objects when their count drops to zero. A cyclic collector handles reference cycles.</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:managedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS03"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SP_ICS05">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemProperty"/>
    <rdfs:label>Relative Path</rdfs:label>
    <ics:courseId>SP_ICS05</ics:courseId>
    <ics:definition>A file path interpreted relative to the process's current working directory. The same relative path resolves to different files depending on where the process was launched.</ics:definition>
    <ics:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SP_ICS04"/>
    <ics:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#E_ICS02"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SK_ICS04">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Skill"/>
    <rdfs:label>Read and inject configuration through environment variables</rdfs:label>
    <ics:courseId>SK_ICS04</ics:courseId>
    <ics:definition>Use os.getenv() to read runtime configuration (API keys, debug flags, paths) from the process environment, understand PATH as the OS executable search list, and avoid hardcoding configuration in source code.</ics:definition>
    <ics:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SK_ICS01"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SP_ICS02"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SP_ICS03"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#F_ICS03"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#E_ICS03">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#ErrorType"/>
    <rdfs:label>PermissionError</rdfs:label>
    <ics:courseId>E_ICS03</ics:courseId>
    <ics:definition>Raised when the OS refuses a file or directory operation because the process does not have the required read/write/execute permission for that resource.</ics:definition>
    <ics:commonCauses>Trying to write to a read-only file | Accessing a directory without execute permission | Running as a non-admin user on a system file</ics:commonCauses>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#F_ICS02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#BuiltInFunction"/>
    <rdfs:label>os.getcwd()</rdfs:label>
    <ics:courseId>F_ICS02</ics:courseId>
    <ics:definition>Returns the current working directory of the process as a string. First thing to check when FileNotFoundError appears for a file you believe exists.</ics:definition>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS14"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SP_ICS04"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SP_ICS05"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemLayer"/>
    <rdfs:label>Kernel</rdfs:label>
    <ics:courseId>SL_ICS02</ics:courseId>
    <ics:definition>The privileged core of the OS running at Ring 0. Has direct hardware access and enforces all security policies. Device drivers run inside the kernel.</ics:definition>
    <ics:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS06"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#Encoding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Encoding</rdfs:label>
    <rdfs:comment>A byte-to-symbol mapping standard</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#Method">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Method</rdfs:label>
    <rdfs:comment>A type-specific callable</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS04">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemLayer"/>
    <rdfs:label>Python Interpreter (CPython)</rdfs:label>
    <ics:courseId>SL_ICS04</ics:courseId>
    <ics:definition>The reference implementation of Python in C. Compiles .py files to bytecode and executes them in a bytecode interpreter loop.</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS03"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#C_ICS19">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Concept"/>
    <rdfs:label>Bit</rdfs:label>
    <ics:courseId>C_ICS19</ics:courseId>
    <ics:definition>The smallest unit of information in a computer: a 0 or a 1. All data — numbers, text, images, code — is ultimately stored as sequences of bits.</ics:definition>
    <ics:cognitiveType>theoretical</ics:cognitiveType>
    <ics:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS06"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SM_ICS03">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemMechanism"/>
    <rdfs:label>CPU Scheduling</rdfs:label>
    <ics:courseId>SM_ICS03</ics:courseId>
    <ics:definition>The OS mechanism that allocates CPU time slices to competing processes and threads. Your Python process can be slowed by other processes consuming CPU time.</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:managedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#E_ICS02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#ErrorType"/>
    <rdfs:label>FileNotFoundError</rdfs:label>
    <ics:courseId>E_ICS02</ics:courseId>
    <ics:definition>Raised when the OS cannot locate the requested file path. Often a wrong-layer bug: the path is correct relative to the developer's CWD but not the CWD where the script is actually launched.</ics:definition>
    <ics:commonCauses>Using a relative path while the CWD is different from the script's directory | Typo in file name or extension | File on a different machine or removed</ics:commonCauses>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#isThrownBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>is_thrown_by</rdfs:label>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#ErrorType"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#throwsError"/>
    <rdfs:comment>Inverse of throws_error — this error is thrown by a concept or mechanism</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N11040b8b570545ccb3e6ef068dc493e2">
    <rdf:first rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#ErrorType"/>
    <rdf:rest rdf:nodeID="N0ad93724146546299124cc6de2a4dcf3"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#ErrorType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ErrorType</rdfs:label>
    <rdfs:comment>A Python exception type</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SM_ICS09">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemMechanism"/>
    <rdfs:label>Heap Memory</rdfs:label>
    <ics:courseId>SM_ICS09</ics:courseId>
    <ics:definition>Memory region for dynamically created objects (the Python object heap). Managed automatically by Python's Garbage Collector — objects live here until no references remain; no manual allocation or freeing by the programmer.</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#RE_ICS01"/>
    <ics:managedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS03"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#F_ICS03">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#BuiltInFunction"/>
    <rdfs:label>os.getenv()</rdfs:label>
    <ics:courseId>F_ICS03</ics:courseId>
    <ics:definition>Returns the value of an environment variable (e.g. PATH). Useful for understanding how the OS locates executables and for reading configuration.</ics:definition>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SP_ICS02"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#M_ICS02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Method"/>
    <rdfs:label>bytes.decode()</rdfs:label>
    <ics:courseId>M_ICS02</ics:courseId>
    <ics:definition>Converts raw bytes to a Python str using a specified encoding (default: utf-8). Used when reading text from disk or network, which deliver raw bytes.</ics:definition>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS21"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS22"/>
    <ics:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#E_ICS01"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:producesType rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#DT_ICS01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SM_ICS04">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemMechanism"/>
    <rdfs:label>File Permission</rdfs:label>
    <ics:courseId>SM_ICS04</ics:courseId>
    <ics:definition>OS access control on files: read/write/execute bits per user/group/other. Enforced by the kernel; Python cannot bypass them. Violation raises PermissionError.</ics:definition>
    <ics:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#E_ICS03"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:managedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS02"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SM_ICS11">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemMechanism"/>
    <rdfs:label>stdout</rdfs:label>
    <ics:courseId>SM_ICS11</ics:courseId>
    <ics:definition>Standard output stream — the process's default destination for print(). Connected to the terminal by default; can be redirected to a file or pipe.</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#RE_ICS01"/>
    <ics:managedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SystemProperty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>SystemProperty</rdfs:label>
    <rdfs:comment>A named inspectable value attached to a running process</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SM_ICS08">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemMechanism"/>
    <rdfs:label>Stack Memory</rdfs:label>
    <ics:courseId>SM_ICS08</ics:courseId>
    <ics:definition>Memory region holding function call frames, local variables, and return addresses. Automatically managed: grows on function call, shrinks on return. Fixed maximum size per thread.</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#RE_ICS01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SK_ICS06">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Skill"/>
    <rdfs:label>Predict and fix floating-point representation errors</rdfs:label>
    <ics:courseId>SK_ICS06</ics:courseId>
    <ics:definition>Explain why most decimal fractions cannot be represented exactly in IEEE 754 binary floating-point, predict when rounding errors occur (e.g. 0.1 + 0.2 ≠ 0.3), compare floats with a tolerance instead of ==, and recognise when Python's Decimal type is needed for exact results.</ics:definition>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS23"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#ENC_ICS03"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS19"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS20"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1ceae9fee5b14b92b726ae7a4ca6d1a9">
    <rdf:first rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemLayer"/>
    <rdf:rest rdf:nodeID="N1fc1738df1964ca186677fbfb52a0ec9"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#C_ICS24">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Concept"/>
    <rdfs:label>Memory Hierarchy</rdfs:label>
    <ics:courseId>C_ICS24</ics:courseId>
    <ics:definition>The multi-level storage pyramid in hardware: CPU registers (fastest, bytes) → L1/L2/L3 cache (very fast, KB–MB) → RAM (fast, GB) → SSD/disk (slow, TB). Data must move up the hierarchy to be processed; cache misses cause slowdowns.</ics:definition>
    <ics:cognitiveType>theoretical</ics:cognitiveType>
    <ics:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS06"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS19"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS20"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#RE_ICS03">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#RuntimeEntity"/>
    <rdfs:label>Thread</rdfs:label>
    <ics:courseId>RE_ICS03</ics:courseId>
    <ics:definition>A unit of CPU execution within a process. Multiple threads share the same memory space but each has its own stack and register state.</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#RE_ICS01"/>
    <ics:managedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#M_ICS01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Method"/>
    <rdfs:label>str.encode()</rdfs:label>
    <ics:courseId>M_ICS01</ics:courseId>
    <ics:definition>Converts a Python str to bytes using a specified encoding (default: utf-8). Used when writing text to disk or network, which require raw bytes.</ics:definition>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS21"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS22"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:producesType rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#DT_ICS02"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#definition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>definition</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Plain-language definition of the entity</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#L11">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Lecture"/>
    <rdfs:label>Introduction to Computer Systems</rdfs:label>
    <ics:courseId>L11</ics:courseId>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#ENC_ICS03">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Encoding"/>
    <rdfs:label>IEEE 754</rdfs:label>
    <ics:courseId>ENC_ICS03</ics:courseId>
    <ics:definition>Binary standard for floating-point numbers. Uses sign (1 bit), exponent, and mantissa fields. Determines the precision and range of float values and is the reason float arithmetic produces rounding errors.</ics:definition>
    <ics:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS23"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS23"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#BuiltInFunction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>BuiltInFunction</rdfs:label>
    <rdfs:comment>A native Python function</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SM_ICS10">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemMechanism"/>
    <rdfs:label>stdin</rdfs:label>
    <ics:courseId>SM_ICS10</ics:courseId>
    <ics:definition>Standard input stream — the process's default source for keyboard input. Connected to the terminal by default; can be redirected.</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#RE_ICS01"/>
    <ics:managedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SystemLayer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>SystemLayer</rdfs:label>
    <rdfs:comment>An autonomous software/firmware layer in the execution stack</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#C_ICS21">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Concept"/>
    <rdfs:label>Character Encoding</rdfs:label>
    <ics:courseId>C_ICS21</ics:courseId>
    <ics:definition>A rule that maps byte sequences to human-readable text characters. The same sequence of bytes produces different text depending on which encoding is used to interpret it. Files are bytes — text is an interpretation.</ics:definition>
    <ics:cognitiveType>theoretical</ics:cognitiveType>
    <ics:bestPractice>Always specify the encoding explicitly when opening files: open('file.txt', encoding='utf-8').</ics:bestPractice>
    <ics:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS20"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#DT_ICS02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#DataType"/>
    <rdfs:label>bytes</rdfs:label>
    <ics:courseId>DT_ICS02</ics:courseId>
    <ics:definition>Python's raw binary data type. What the OS actually reads/writes. Immutable sequence of integers 0–255. Must be decoded to str to be treated as text.</ics:definition>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS22"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#C_ICS06">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Concept"/>
    <rdfs:label>User Space</rdfs:label>
    <ics:courseId>C_ICS06</ics:courseId>
    <ics:definition>The memory region where normal applications (Ring 3, least privileged) run. Your Python process lives here. User space code must ask the kernel for any privileged operation.</ics:definition>
    <ics:cognitiveType>conceptual</ics:cognitiveType>
    <ics:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SM_ICS02"/>
    <ics:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS02"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#C_ICS23">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Concept"/>
    <rdfs:label>Floating-point Representation</rdfs:label>
    <ics:courseId>C_ICS23</ics:courseId>
    <ics:definition>The IEEE 754 method of storing real numbers in binary using sign, exponent, and mantissa. Most decimals cannot be represented exactly in binary, producing rounding errors (e.g. 0.1 + 0.2 != 0.3).</ics:definition>
    <ics:cognitiveType>theoretical</ics:cognitiveType>
    <ics:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS20"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1fc1738df1964ca186677fbfb52a0ec9">
    <rdf:first rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#RuntimeEntity"/>
    <rdf:rest rdf:nodeID="N7633ef2ccc1744c5967c93758fb8ad94"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#Skill">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Skill</rdfs:label>
    <rdfs:comment>A transferable cognitive operation</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SK_ICS03">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Skill"/>
    <rdfs:label>Resolve file paths using the process working directory</rdfs:label>
    <ics:courseId>SK_ICS03</ics:courseId>
    <ics:definition>Predict what file a relative path resolves to given a known CWD, diagnose FileNotFoundError caused by a mismatched working directory, and fix it by using absolute paths or inspecting the current directory with os.getcwd().</ics:definition>
    <ics:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SK_ICS01"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS14"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#F_ICS02"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SM_ICS04"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SM_ICS05"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SP_ICS04"/>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SP_ICS05"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SM_ICS06">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemMechanism"/>
    <rdfs:label>Virtual Memory</rdfs:label>
    <ics:courseId>SM_ICS06</ics:courseId>
    <ics:definition>OS illusion that each process has its own large private address space. The OS maps virtual addresses to physical RAM pages; pages not in RAM cause page faults.</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:managedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#dependsOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label>depends_on</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment>Prerequisite ordering between concepts and skills</rdfs:comment>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#isRequiredBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#taughtIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>taught_in</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Lecture"/>
    <rdfs:comment>First introduced in this lecture</rdfs:comment>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#teaches"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#RE_ICS02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#RuntimeEntity"/>
    <rdfs:label>Program</rdfs:label>
    <ics:courseId>RE_ICS02</ics:courseId>
    <ics:definition>A file on disk containing executable instructions. Static — does not use memory or CPU until the OS creates a process from it.</ics:definition>
    <ics:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#RE_ICS01"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N41c5bc822bdb4237b36beb22ce66fc7d">
    <rdf:first rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Lecture"/>
    <rdf:rest rdf:nodeID="N7560e13787c142ea80f8cbfdd90a0854"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SP_ICS02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemProperty"/>
    <rdfs:label>Environment Variable</rdfs:label>
    <ics:courseId>SP_ICS02</ics:courseId>
    <ics:definition>A named string value in the process environment, inherited from the parent process. Configures runtime behaviour without changing source code (e.g. API keys, locale, debug flags).</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#RE_ICS01"/>
    <ics:managedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#isRequiredBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label>is_required_by</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#dependsOn"/>
    <rdfs:comment>Inverse of depends_on — this entity is a prerequisite for another</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#DataType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>DataType</rdfs:label>
    <rdfs:comment>A Python data type</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#E_ICS01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#ErrorType"/>
    <rdfs:label>UnicodeDecodeError</rdfs:label>
    <ics:courseId>E_ICS01</ics:courseId>
    <ics:definition>Raised when a byte sequence cannot be decoded using the specified encoding. Almost always means wrong bytes (file saved in a different encoding) or wrong decoding rule (encoding= argument mismatch).</ics:definition>
    <ics:commonCauses>Opening a Latin-1 encoded file with encoding='utf-8' | Reading a binary file as text | Missing encoding= argument so Python uses the system default</ics:commonCauses>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#implements">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>implements</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Concept"/>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#implementedBy"/>
    <rdfs:comment>Inverse of implemented_by — this construct or mechanism implements a concept</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne3f7cee20792481abdec514214339899">
    <rdf:first rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemProperty"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SM_ICS02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemMechanism"/>
    <rdfs:label>Privilege Ring</rdfs:label>
    <ics:courseId>SM_ICS02</ics:courseId>
    <ics:definition>CPU hardware mechanism enforcing four privilege levels (Ring 0–3). Kernel runs at Ring 0; Python at Ring 3. Hardware prevents user-space code from accessing Ring 0 operations.</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:managedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS02"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#DT_ICS01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#DataType"/>
    <rdfs:label>str</rdfs:label>
    <ics:courseId>DT_ICS01</ics:courseId>
    <ics:definition>Python's Unicode text type. Carries meaning — a decoded sequence of characters. The OS never sees str directly; Python encodes it to bytes before writing to disk or network.</ics:definition>
    <ics:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS22"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nca52a23afb52443f956e3978c323885f">
    <rdf:first rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#DataType"/>
    <rdf:rest rdf:nodeID="N11040b8b570545ccb3e6ef068dc493e2"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dc:title>COMP101 ICS — Introduction to Computer Systems</dc:title>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <owl:versionInfo>2.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#HC_ICS09">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#HardwareComponent"/>
    <rdfs:label>GPU</rdfs:label>
    <ics:courseId>HC_ICS09</ics:courseId>
    <ics:definition>Graphics Processing Unit — optimised for massively parallel computation. Runs code differently from the CPU; requires special programming models (CUDA, OpenCL).</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:managedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#C_ICS20">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#Concept"/>
    <rdfs:label>Byte</rdfs:label>
    <ics:courseId>C_ICS20</ics:courseId>
    <ics:definition>Eight bits grouped together. Represents a value from 0 to 255. The fundamental unit of file storage, network transfer, and memory addressing.</ics:definition>
    <ics:cognitiveType>theoretical</ics:cognitiveType>
    <ics:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#C_ICS19"/>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS03">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemLayer"/>
    <rdfs:label>Python Runtime</rdfs:label>
    <ics:courseId>SL_ICS03</ics:courseId>
    <ics:definition>The execution environment that runs your Python code: parses source, compiles to bytecode, executes it, manages memory, and mediates OS requests.</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:managedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SL_ICS01"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2be92f9df5a04a0e94f79f43253f0463">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="N41c5bc822bdb4237b36beb22ce66fc7d"/>
  </rdf:Description>
