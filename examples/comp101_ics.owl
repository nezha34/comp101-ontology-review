  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SystemMechanism">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>SystemMechanism</rdfs:label>
    <rdfs:comment>An OS/hardware operational policy or procedure</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/ics#SP_ICS01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#SystemProperty"/>
    <rdfs:label>Process ID</rdfs:label>
    <ics:courseId>SP_ICS01</ics:courseId>
    <ics:definition>Unique integer (PID) the OS assigns to each running process. Used to track, signal, or kill the process. Readable via os.getpid().</ics:definition>
    <ics:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#L11"/>
    <ics:partOf rdf:resource="http://comp101.sase.um6p.ma/ontology/ics#RE_ICS01"/>
  </rdf:Description>
