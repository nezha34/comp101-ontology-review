@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ics: <http://comp101.sase.um6p.ma/ontology/ics#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://comp101.sase.um6p.ma/ontology/ics> a owl:Ontology ;
    dc:title "COMP101 ICS — Introduction to Computer Systems" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "2.0" .

ics:C_ICS24 a ics:Concept,
        owl:NamedIndividual ;
    rdfs:label "Memory Hierarchy" ;
    ics:cognitiveType "theoretical" ;
    ics:courseId "C_ICS24" ;
    ics:definition "The multi-level storage pyramid in hardware: CPU registers (fastest, bytes) → L1/L2/L3 cache (very fast, KB–MB) → RAM (fast, GB) → SSD/disk (slow, TB). Data must move up the hierarchy to be processed; cache misses cause slowdowns." ;
    ics:partOf ics:SL_ICS06 ;
    ics:taughtIn ics:L11 .

ics:HC_ICS03 a ics:HardwareComponent,
        owl:NamedIndividual ;
    rdfs:label "CPU Register" ;
    ics:courseId "HC_ICS03" ;
    ics:definition "The fastest storage in the memory hierarchy, inside the CPU core. Holds the values the CPU is actively computing on." ;
    ics:partOf ics:HC_ICS02 ;
    ics:taughtIn ics:L11 .

ics:HC_ICS04 a ics:HardwareComponent,
        owl:NamedIndividual ;
    rdfs:label "L1 Cache" ;
    ics:courseId "HC_ICS04" ;
    ics:definition "Smallest, fastest CPU cache — private to each core. Stores recently used instructions and data." ;
    ics:partOf ics:HC_ICS02 ;
    ics:taughtIn ics:L11 .

ics:HC_ICS05 a ics:HardwareComponent,
        owl:NamedIndividual ;
    rdfs:label "L2 Cache" ;
    ics:courseId "HC_ICS05" ;
    ics:definition "Larger, slightly slower cache shared between a few cores. Second level in the cache hierarchy." ;
    ics:partOf ics:HC_ICS01 ;
    ics:taughtIn ics:L11 .

ics:HC_ICS06 a ics:HardwareComponent,
        owl:NamedIndividual ;
    rdfs:label "L3 Cache" ;
    ics:courseId "HC_ICS06" ;
    ics:definition "Largest CPU cache, shared across all cores. Last level before RAM in the memory hierarchy." ;
    ics:partOf ics:HC_ICS01 ;
    ics:taughtIn ics:L11 .

ics:HC_ICS08 a ics:HardwareComponent,
        owl:NamedIndividual ;
    rdfs:label "SSD / Hard Disk" ;
    ics:courseId "HC_ICS08" ;
    ics:definition "Persistent non-volatile storage. Programs and files live here when not running. Much slower than RAM." ;
    ics:managedBy ics:SL_ICS01 ;
    ics:taughtIn ics:L11 .

ics:HC_ICS09 a ics:HardwareComponent,
        owl:NamedIndividual ;
    rdfs:label "GPU" ;
    ics:courseId "HC_ICS09" ;
    ics:definition "Graphics Processing Unit — optimised for massively parallel computation. Runs code differently from the CPU; requires special programming models (CUDA, OpenCL)." ;
    ics:managedBy ics:SL_ICS01 ;
    ics:taughtIn ics:L11 .

ics:M_ICS01 a ics:Method,
        owl:NamedIndividual ;
    rdfs:label "str.encode()" ;
    ics:courseId "M_ICS01" ;
    ics:definition "Converts a Python str to bytes using a specified encoding (default: utf-8). Used when writing text to disk or network, which require raw bytes." ;
    ics:producesType ics:DT_ICS02 ;
    ics:taughtIn ics:L11 ;
    ics:usesConcept ics:C_ICS21,
        ics:C_ICS22 .

ics:M_ICS02 a ics:Method,
        owl:NamedIndividual ;
    rdfs:label "bytes.decode()" ;
    ics:courseId "M_ICS02" ;
    ics:definition "Converts raw bytes to a Python str using a specified encoding (default: utf-8). Used when reading text from disk or network, which deliver raw bytes." ;
    ics:producesType ics:DT_ICS01 ;
    ics:taughtIn ics:L11 ;
    ics:throwsError ics:E_ICS01 ;
    ics:usesConcept ics:C_ICS21,
        ics:C_ICS22 .

ics:SK_ICS07 a ics:Skill,
        owl:NamedIndividual ;
    rdfs:label "Diagnose a bug by tracing it to its layer" ;
    ics:courseId "SK_ICS07" ;
    ics:definition "Given any error or unexpected behaviour, assign it to the correct layer (Python code, Python Runtime, OS, Hardware), explain why patching a different layer cannot fix it, and identify the correct layer-appropriate fix — this is the synthesis of all ICS skills applied to real debugging." ;
    ics:dependsOn ics:SK_ICS01,
        ics:SK_ICS02,
        ics:SK_ICS03,
        ics:SK_ICS04,
        ics:SK_ICS05,
        ics:SK_ICS06 ;
    ics:taughtIn ics:L11 ;
    ics:usesConcept ics:C_ICS01,
        ics:C_ICS09 .

ics:SL_ICS05 a ics:SystemLayer,
        owl:NamedIndividual ;
    rdfs:label "JIT Compiler" ;
    ics:contrastsWith ics:SL_ICS04 ;
    ics:courseId "SL_ICS05" ;
    ics:definition "Just-In-Time compiler: compiles frequently-run code to native machine code at runtime rather than interpreting bytecode. Used in PyPy, Numba, and other Python implementations." ;
    ics:taughtIn ics:L11 .

ics:SL_ICS07 a ics:SystemLayer,
        owl:NamedIndividual ;
    rdfs:label "Device Driver" ;
    ics:courseId "SL_ICS07" ;
    ics:definition "Software that runs inside the kernel and translates generic OS requests into hardware-specific commands for a particular device (disk, GPU, network card)." ;
    ics:partOf ics:SL_ICS02 ;
    ics:taughtIn ics:L11 .

ics:SM_ICS03 a ics:SystemMechanism,
        owl:NamedIndividual ;
    rdfs:label "CPU Scheduling" ;
    ics:courseId "SM_ICS03" ;
    ics:definition "The OS mechanism that allocates CPU time slices to competing processes and threads. Your Python process can be slowed by other processes consuming CPU time." ;
    ics:managedBy ics:SL_ICS01 ;
    ics:taughtIn ics:L11 .

ics:SM_ICS04 a ics:SystemMechanism,
        owl:NamedIndividual ;
    rdfs:label "File Permission" ;
    ics:courseId "SM_ICS04" ;
    ics:definition "OS access control on files: read/write/execute bits per user/group/other. Enforced by the kernel; Python cannot bypass them. Violation raises PermissionError." ;
    ics:managedBy ics:SL_ICS02 ;
    ics:taughtIn ics:L11 ;
    ics:throwsError ics:E_ICS03 .

ics:SM_ICS07 a ics:SystemMechanism,
        owl:NamedIndividual ;
    rdfs:label "Memory Page" ;
    ics:courseId "SM_ICS07" ;
    ics:definition "The unit of virtual memory management (typically 4 KB). The OS moves pages between RAM and disk; a page fault stalls the process until the page is loaded." ;
    ics:managedBy ics:SL_ICS01 ;
    ics:partOf ics:SM_ICS06 ;
    ics:taughtIn ics:L11 .

ics:bestPractice a owl:DatatypeProperty ;
    rdfs:label "best_practice" ;
    rdfs:comment "Recommended approach or convention" ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

ics:cognitiveType a owl:DatatypeProperty ;
    rdfs:label "cognitive_type" ;
    rdfs:comment "Cognitive demand type: procedural | conceptual | theoretical" ;
    rdfs:domain ics:Concept ;
    rdfs:range xsd:string .

ics:commonCauses a owl:DatatypeProperty ;
    rdfs:label "common_causes" ;
    rdfs:comment "Common causes that trigger this error" ;
    rdfs:domain ics:ErrorType ;
    rdfs:range xsd:string .

ics:contrastsWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "contrasts_with" ;
    rdfs:comment "Alternatives, opposites, or commonly confused peers" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing .

ics:courseId a owl:DatatypeProperty ;
    rdfs:label "course_id" ;
    rdfs:comment "Original identifier for this entity (e.g. C_OOP01)" ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

ics:definition a owl:DatatypeProperty ;
    rdfs:label "definition" ;
    rdfs:comment "Plain-language definition of the entity" ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

ics:C_ICS09 a ics:Concept,
        owl:NamedIndividual ;
    rdfs:label "Wrong Layer Bug" ;
    ics:cognitiveType "conceptual" ;
    ics:courseId "C_ICS09" ;
    ics:definition "A debugging anti-pattern: changing Python code to fix a bug that actually lives in the OS layer (wrong path, wrong permission, wrong encoding). The fix is at a different layer than where the symptom appears." ;
    ics:dependsOn ics:C_ICS01 ;
    ics:taughtIn ics:L11 .

ics:ENC_ICS02 a ics:Encoding,
        owl:NamedIndividual ;
    rdfs:label "UTF-8" ;
    ics:courseId "ENC_ICS02" ;
    ics:definition "Variable-length encoding for (almost) all written human languages. Uses 1–4 bytes per character. Keeps ASCII unchanged (bytes 0–127 are identical), making it the universal default for the web and modern file systems." ;
    ics:dependsOn ics:ENC_ICS01 ;
    ics:taughtIn ics:L11 .

ics:ENC_ICS03 a ics:Encoding,
        owl:NamedIndividual ;
    rdfs:label "IEEE 754" ;
    ics:courseId "ENC_ICS03" ;
    ics:definition "Binary standard for floating-point numbers. Uses sign (1 bit), exponent, and mantissa fields. Determines the precision and range of float values and is the reason float arithmetic produces rounding errors." ;
    ics:dependsOn ics:C_ICS23 ;
    ics:taughtIn ics:L11 .

ics:E_ICS01 a ics:ErrorType,
        owl:NamedIndividual ;
    rdfs:label "UnicodeDecodeError" ;
    ics:commonCauses "Opening a Latin-1 encoded file with encoding='utf-8' | Reading a binary file as text | Missing encoding= argument so Python uses the system default" ;
    ics:courseId "E_ICS01" ;
    ics:definition "Raised when a byte sequence cannot be decoded using the specified encoding. Almost always means wrong bytes (file saved in a different encoding) or wrong decoding rule (encoding= argument mismatch)." ;
    ics:taughtIn ics:L11 .

ics:E_ICS02 a ics:ErrorType,
        owl:NamedIndividual ;
    rdfs:label "FileNotFoundError" ;
    ics:commonCauses "Using a relative path while the CWD is different from the script's directory | Typo in file name or extension | File on a different machine or removed" ;
    ics:courseId "E_ICS02" ;
    ics:definition "Raised when the OS cannot locate the requested file path. Often a wrong-layer bug: the path is correct relative to the developer's CWD but not the CWD where the script is actually launched." ;
    ics:taughtIn ics:L11 .

ics:E_ICS03 a ics:ErrorType,
        owl:NamedIndividual ;
    rdfs:label "PermissionError" ;
    ics:commonCauses "Trying to write to a read-only file | Accessing a directory without execute permission | Running as a non-admin user on a system file" ;
    ics:courseId "E_ICS03" ;
    ics:definition "Raised when the OS refuses a file or directory operation because the process does not have the required read/write/execute permission for that resource." ;
    ics:taughtIn ics:L11 .

ics:F_ICS01 a ics:BuiltInFunction,
        owl:NamedIndividual ;
    rdfs:label "os.getpid()" ;
    ics:courseId "F_ICS01" ;
    ics:definition "Returns the integer PID of the current process. Useful for logging, debugging, and process management." ;
    ics:taughtIn ics:L11 ;
    ics:usesConcept ics:SP_ICS01 .

ics:F_ICS02 a ics:BuiltInFunction,
        owl:NamedIndividual ;
    rdfs:label "os.getcwd()" ;
    ics:courseId "F_ICS02" ;
    ics:definition "Returns the current working directory of the process as a string. First thing to check when FileNotFoundError appears for a file you believe exists." ;
    ics:taughtIn ics:L11 ;
    ics:usesConcept ics:C_ICS14,
        ics:SP_ICS04 .

ics:F_ICS03 a ics:BuiltInFunction,
        owl:NamedIndividual ;
    rdfs:label "os.getenv()" ;
    ics:courseId "F_ICS03" ;
    ics:definition "Returns the value of an environment variable (e.g. PATH). Useful for understanding how the OS locates executables and for reading configuration." ;
    ics:taughtIn ics:L11 ;
    ics:usesConcept ics:SP_ICS02 .

ics:HC_ICS07 a ics:HardwareComponent,
        owl:NamedIndividual ;
    rdfs:label "RAM" ;
    ics:courseId "HC_ICS07" ;
    ics:definition "Random Access Memory — fast volatile storage. Holds the running process's code, stack, heap, and OS data." ;
    ics:managedBy ics:SL_ICS01 ;
    ics:taughtIn ics:L11 .

ics:LanguageConstruct a owl:Class ;
    rdfs:label "LanguageConstruct" ;
    rdfs:comment "A Python syntax element" .

ics:RE_ICS03 a ics:RuntimeEntity,
        owl:NamedIndividual ;
    rdfs:label "Thread" ;
    ics:courseId "RE_ICS03" ;
    ics:definition "A unit of CPU execution within a process. Multiple threads share the same memory space but each has its own stack and register state." ;
    ics:managedBy ics:SL_ICS01 ;
    ics:partOf ics:RE_ICS01 ;
    ics:taughtIn ics:L11 .

ics:RE_ICS04 a ics:RuntimeEntity,
        owl:NamedIndividual ;
    rdfs:label "Bytecode" ;
    ics:courseId "RE_ICS04" ;
    ics:definition "The intermediate representation Python compiles your source code into before execution. Machine-independent; interpreted by CPython's bytecode loop." ;
    ics:managedBy ics:SL_ICS04 ;
    ics:taughtIn ics:L11 .

ics:RE_ICS05 a ics:RuntimeEntity,
        owl:NamedIndividual ;
    rdfs:label "Garbage Collection" ;
    ics:courseId "RE_ICS05" ;
    ics:definition "Python's automatic memory reclamation process. Tracks reference counts for all heap objects; frees objects when their count drops to zero. A cyclic collector handles reference cycles." ;
    ics:managedBy ics:SL_ICS03 ;
    ics:taughtIn ics:L11 .

ics:SK_ICS02 a ics:Skill,
        owl:NamedIndividual ;
    rdfs:label "Trace Python's full execution pipeline" ;
    ics:courseId "SK_ICS02" ;
    ics:definition "Explain the chain of events when python script.py runs: the OS creates a process with a PID, allocates stack and heap memory, connects stdin/stdout/stderr, the interpreter compiles source to bytecode, the bytecode loop runs, and the garbage collector reclaims objects as references drop to zero." ;
    ics:dependsOn ics:SK_ICS01 ;
    ics:taughtIn ics:L11 ;
    ics:usesConcept ics:F_ICS01,
        ics:RE_ICS03,
        ics:RE_ICS04,
        ics:RE_ICS05,
        ics:SL_ICS02,
        ics:SL_ICS03,
        ics:SL_ICS04,
        ics:SM_ICS01,
        ics:SM_ICS08,
        ics:SM_ICS09,
        ics:SM_ICS10,
        ics:SM_ICS11,
        ics:SM_ICS12,
        ics:SP_ICS01 .

ics:SK_ICS03 a ics:Skill,
        owl:NamedIndividual ;
    rdfs:label "Resolve file paths using the process working directory" ;
    ics:courseId "SK_ICS03" ;
    ics:definition "Predict what file a relative path resolves to given a known CWD, diagnose FileNotFoundError caused by a mismatched working directory, and fix it by using absolute paths or inspecting the current directory with os.getcwd()." ;
    ics:dependsOn ics:SK_ICS01 ;
    ics:taughtIn ics:L11 ;
    ics:usesConcept ics:C_ICS14,
        ics:F_ICS02,
        ics:SM_ICS05,
        ics:SP_ICS04,
        ics:SP_ICS05 .

ics:SK_ICS04 a ics:Skill,
        owl:NamedIndividual ;
    rdfs:label "Read and inject configuration through environment variables" ;
    ics:courseId "SK_ICS04" ;
    ics:definition "Use os.getenv() to read runtime configuration (API keys, debug flags, paths) from the process environment, understand PATH as the OS executable search list, and avoid hardcoding configuration in source code." ;
    ics:dependsOn ics:SK_ICS01 ;
    ics:taughtIn ics:L11 ;
    ics:usesConcept ics:F_ICS03,
        ics:SP_ICS02,
        ics:SP_ICS03 .

ics:SK_ICS05 a ics:Skill,
        owl:NamedIndividual ;
    rdfs:label "Convert between bytes and text with explicit encoding" ;
    ics:courseId "SK_ICS05" ;
    ics:definition "Know that the OS delivers raw bytes and Python must decode them to str; apply str.encode() and bytes.decode() with an explicit encoding, always specify encoding= when opening text files, and diagnose UnicodeDecodeError as a mismatch between the bytes on disk and the codec applied." ;
    ics:taughtIn ics:L11 ;
    ics:usesConcept ics:C_ICS21,
        ics:C_ICS22,
        ics:DT_ICS01,
        ics:DT_ICS02,
        ics:ENC_ICS01,
        ics:ENC_ICS02 .

ics:SK_ICS06 a ics:Skill,
        owl:NamedIndividual ;
    rdfs:label "Predict and fix floating-point representation errors" ;
    ics:courseId "SK_ICS06" ;
    ics:definition "Explain why most decimal fractions cannot be represented exactly in IEEE 754 binary floating-point, predict when rounding errors occur (e.g. 0.1 + 0.2 ≠ 0.3), compare floats with a tolerance instead of ==, and recognise when Python's Decimal type is needed for exact results." ;
    ics:taughtIn ics:L11 ;
    ics:usesConcept ics:C_ICS19,
        ics:C_ICS23,
        ics:ENC_ICS03 .

ics:SL_ICS06 a ics:SystemLayer,
        owl:NamedIndividual ;
    rdfs:label "Hardware Layer" ;
    ics:courseId "SL_ICS06" ;
    ics:definition "The named bottom layer of the execution stack in the ICS layer model: physical CPU, memory, and devices. Everything runs on this layer." ;
    ics:taughtIn ics:L11 ;
    ics:usesConcept ics:C_ICS01 .

ics:SM_ICS01 a ics:SystemMechanism,
        owl:NamedIndividual ;
    rdfs:label "System Call" ;
    ics:courseId "SM_ICS01" ;
    ics:definition "The controlled transition from user space (Ring 3) to kernel space (Ring 0). Every time Python opens a file, prints text, or allocates memory, it issues a system call." ;
    ics:managedBy ics:SL_ICS02 ;
    ics:taughtIn ics:L11 ;
    ics:usesConcept ics:C_ICS06,
        ics:SM_ICS02 .

ics:SM_ICS05 a ics:SystemMechanism,
        owl:NamedIndividual ;
    rdfs:label "File System" ;
    ics:courseId "SM_ICS05" ;
    ics:definition "The OS abstraction that organises persistent storage into files and directories. Mediates all disk reads/writes and enforces permissions." ;
    ics:managedBy ics:SL_ICS01 ;
    ics:taughtIn ics:L11 .

ics:SM_ICS06 a ics:SystemMechanism,
        owl:NamedIndividual ;
    rdfs:label "Virtual Memory" ;
    ics:courseId "SM_ICS06" ;
    ics:definition "OS illusion that each process has its own large private address space. The OS maps virtual addresses to physical RAM pages; pages not in RAM cause page faults." ;
    ics:managedBy ics:SL_ICS01 ;
    ics:taughtIn ics:L11 .

ics:SM_ICS08 a ics:SystemMechanism,
        owl:NamedIndividual ;
    rdfs:label "Stack Memory" ;
    ics:courseId "SM_ICS08" ;
    ics:definition "Memory region holding function call frames, local variables, and return addresses. Automatically managed: grows on function call, shrinks on return. Fixed maximum size per thread." ;
    ics:partOf ics:RE_ICS01 ;
    ics:taughtIn ics:L11 .

ics:SM_ICS09 a ics:SystemMechanism,
        owl:NamedIndividual ;
    rdfs:label "Heap Memory" ;
    ics:courseId "SM_ICS09" ;
    ics:definition "Memory region for dynamically created objects (the Python object heap). Managed automatically by Python's Garbage Collector — objects live here until no references remain; no manual allocation or freeing by the programmer." ;
    ics:managedBy ics:SL_ICS03 ;
    ics:partOf ics:RE_ICS01 ;
    ics:taughtIn ics:L11 .

ics:SM_ICS10 a ics:SystemMechanism,
        owl:NamedIndividual ;
    rdfs:label "stdin" ;
    ics:courseId "SM_ICS10" ;
    ics:definition "Standard input stream — the process's default source for keyboard input. Connected to the terminal by default; can be redirected." ;
    ics:managedBy ics:SL_ICS01 ;
    ics:taughtIn ics:L11 .

ics:SM_ICS11 a ics:SystemMechanism,
        owl:NamedIndividual ;
    rdfs:label "stdout" ;
    ics:courseId "SM_ICS11" ;
    ics:definition "Standard output stream — the process's default destination for print(). Connected to the terminal by default; can be redirected to a file or pipe." ;
    ics:managedBy ics:SL_ICS01 ;
    ics:partOf ics:RE_ICS01 ;
    ics:taughtIn ics:L11 .

ics:SM_ICS12 a ics:SystemMechanism,
        owl:NamedIndividual ;
    rdfs:label "stderr" ;
    ics:courseId "SM_ICS12" ;
    ics:definition "Standard error stream — the process's output channel for error messages and tracebacks. Separate from stdout so errors can be filtered independently." ;
    ics:managedBy ics:SL_ICS01 ;
    ics:partOf ics:RE_ICS01 ;
    ics:taughtIn ics:L11 .

ics:SP_ICS03 a ics:SystemProperty,
        owl:NamedIndividual ;
    rdfs:label "PATH" ;
    ics:courseId "SP_ICS03" ;
    ics:definition "The environment variable listing directories the OS searches when you type a command. Determines whether `python` resolves to the right executable." ;
    ics:exampleOf ics:SP_ICS02 ;
    ics:taughtIn ics:L11 .

ics:dependsOn a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "depends_on" ;
    rdfs:comment "Prerequisite ordering between concepts and skills" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    owl:inverseOf ics:isRequiredBy .

ics:enabledBy a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "enabled_by" ;
    rdfs:comment "Inverse of enables — this concept is made possible by a mechanism" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    owl:inverseOf ics:enables .

ics:enables a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "enables" ;
    rdfs:comment "Mechanism or role that makes this concept possible in Python" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    owl:inverseOf ics:enabledBy .

ics:exampleOf a owl:ObjectProperty ;
    rdfs:label "example_of" ;
    rdfs:comment "Named instance or exemplar of a general concept (e.g. PATH is an example of Environment Variable)" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    owl:inverseOf ics:hasExample .

ics:hasExample a owl:ObjectProperty ;
    rdfs:label "has_example" ;
    rdfs:comment "Inverse of example_of — this concept has the linked entity as a named exemplar" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    owl:inverseOf ics:exampleOf .

ics:hasPart a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has_part" ;
    rdfs:comment "Inverse of part_of — this entity contains another as a component" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    owl:inverseOf ics:partOf .

ics:implementedBy a owl:ObjectProperty ;
    rdfs:label "implemented_by" ;
    rdfs:comment "Concept realised by a language construct, OOP mechanism, or Python internal" ;
    rdfs:domain ics:Concept ;
    rdfs:range owl:Thing ;
    owl:inverseOf ics:implements .

ics:implements a owl:ObjectProperty ;
    rdfs:label "implements" ;
    rdfs:comment "Inverse of implemented_by — this construct or mechanism implements a concept" ;
    rdfs:domain owl:Thing ;
    rdfs:range ics:Concept ;
    owl:inverseOf ics:implementedBy .

ics:isProducedBy a owl:ObjectProperty ;
    rdfs:label "is_produced_by" ;
    rdfs:comment "Inverse of produces_type — this type is produced by a method" ;
    rdfs:domain ics:DataType ;
    rdfs:range ics:Method ;
    owl:inverseOf ics:producesType .

ics:isRequiredBy a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "is_required_by" ;
    rdfs:comment "Inverse of depends_on — this entity is a prerequisite for another" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    owl:inverseOf ics:dependsOn .

ics:isThrownBy a owl:ObjectProperty ;
    rdfs:label "is_thrown_by" ;
    rdfs:comment "Inverse of throws_error — this error is thrown by a concept or mechanism" ;
    rdfs:domain ics:ErrorType ;
    rdfs:range owl:Thing ;
    owl:inverseOf ics:throwsError .

ics:isUsedBy a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "is_used_by" ;
    rdfs:comment "Inverse of uses_concept — this concept is used by another entity" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    owl:inverseOf ics:usesConcept .

ics:managedBy a owl:ObjectProperty ;
    rdfs:label "managed_by" ;
    rdfs:comment "Operationally controlled or scheduled by a system layer" ;
    rdfs:domain owl:Thing ;
    rdfs:range ics:SystemLayer ;
    owl:inverseOf ics:manages .

ics:manages a owl:ObjectProperty ;
    rdfs:label "manages" ;
    rdfs:comment "Inverse of managed_by — this system layer manages the entity" ;
    rdfs:domain ics:SystemLayer ;
    rdfs:range owl:Thing ;
    owl:inverseOf ics:managedBy .

ics:partOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "part_of" ;
    rdfs:comment "Compositional containment — transitive" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    owl:inverseOf ics:hasPart .

ics:producesType a owl:ObjectProperty ;
    rdfs:label "produces_type" ;
    rdfs:comment "Return type" ;
    rdfs:domain ics:Method ;
    rdfs:range ics:DataType ;
    owl:inverseOf ics:isProducedBy .

ics:taughtIn a owl:ObjectProperty ;
    rdfs:label "taught_in" ;
    rdfs:comment "First introduced in this lecture" ;
    rdfs:domain owl:Thing ;
    rdfs:range ics:Lecture ;
    owl:inverseOf ics:teaches .

ics:teaches a owl:ObjectProperty ;
    rdfs:label "teaches" ;
    rdfs:comment "Inverse of taught_in — this lecture teaches the linked entity" ;
    rdfs:domain ics:Lecture ;
    rdfs:range owl:Thing ;
    owl:inverseOf ics:taughtIn .

ics:throwsError a owl:ObjectProperty ;
    rdfs:label "throws_error" ;
    rdfs:comment "Misuse causes this error" ;
    rdfs:domain owl:Thing ;
    rdfs:range ics:ErrorType ;
    owl:inverseOf ics:isThrownBy .

ics:usesConcept a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "uses_concept" ;
    rdfs:comment "Entity operationalises or draws on a concept or mechanism" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    owl:inverseOf ics:isUsedBy .

ics:C_ICS06 a ics:Concept,
        owl:NamedIndividual ;
    rdfs:label "User Space" ;
    ics:cognitiveType "conceptual" ;
    ics:contrastsWith ics:SL_ICS02 ;
    ics:courseId "C_ICS06" ;
    ics:definition "The memory region where normal applications (Ring 3, least privileged) run. Your Python process lives here. User space code must ask the kernel for any privileged operation." ;
    ics:dependsOn ics:SM_ICS02 ;
    ics:taughtIn ics:L11 .

ics:C_ICS19 a ics:Concept,
        owl:NamedIndividual ;
    rdfs:label "Bit" ;
    ics:cognitiveType "theoretical" ;
    ics:courseId "C_ICS19" ;
    ics:definition "The smallest unit of information in a computer: a 0 or a 1. All data — numbers, text, images, code — is ultimately stored as sequences of bits." ;
    ics:taughtIn ics:L11 .

ics:C_ICS20 a ics:Concept,
        owl:NamedIndividual ;
    rdfs:label "Byte" ;
    ics:cognitiveType "theoretical" ;
    ics:courseId "C_ICS20" ;
    ics:definition "Eight bits grouped together. Represents a value from 0 to 255. The fundamental unit of file storage, network transfer, and memory addressing." ;
    ics:dependsOn ics:C_ICS19 ;
    ics:taughtIn ics:L11 .

ics:C_ICS23 a ics:Concept,
        owl:NamedIndividual ;
    rdfs:label "Floating-point Representation" ;
    ics:cognitiveType "theoretical" ;
    ics:courseId "C_ICS23" ;
    ics:definition "The IEEE 754 method of storing real numbers in binary using sign, exponent, and mantissa. Most decimals cannot be represented exactly in binary, producing rounding errors (e.g. 0.1 + 0.2 != 0.3)." ;
    ics:dependsOn ics:C_ICS20 ;
    ics:taughtIn ics:L11 .

ics:DT_ICS01 a ics:DataType,
        owl:NamedIndividual ;
    rdfs:label "str" ;
    ics:courseId "DT_ICS01" ;
    ics:definition "Python's Unicode text type. Carries meaning — a decoded sequence of characters. The OS never sees str directly; Python encodes it to bytes before writing to disk or network." ;
    ics:taughtIn ics:L11 .

ics:DT_ICS02 a ics:DataType,
        owl:NamedIndividual ;
    rdfs:label "bytes" ;
    ics:courseId "DT_ICS02" ;
    ics:definition "Python's raw binary data type. What the OS actually reads/writes. Immutable sequence of integers 0–255. Must be decoded to str to be treated as text." ;
    ics:taughtIn ics:L11 .

ics:ENC_ICS01 a ics:Encoding,
        owl:NamedIndividual ;
    rdfs:label "ASCII" ;
    ics:courseId "ENC_ICS01" ;
    ics:definition "Maps bytes 0–127 to English characters and basic symbols. 1 byte per character. Cannot represent accented, Arabic, or CJK characters." ;
    ics:taughtIn ics:L11 .

ics:HC_ICS02 a ics:HardwareComponent,
        owl:NamedIndividual ;
    rdfs:label "CPU Core" ;
    ics:courseId "HC_ICS02" ;
    ics:definition "An independent processing unit within the CPU. Modern CPUs have multiple cores running threads in parallel." ;
    ics:partOf ics:HC_ICS01 ;
    ics:taughtIn ics:L11 .

ics:RE_ICS02 a ics:RuntimeEntity,
        owl:NamedIndividual ;
    rdfs:label "Program" ;
    ics:contrastsWith ics:RE_ICS01 ;
    ics:courseId "RE_ICS02" ;
    ics:definition "A file on disk containing executable instructions. Static — does not use memory or CPU until the OS creates a process from it." ;
    ics:taughtIn ics:L11 .

ics:SP_ICS01 a ics:SystemProperty,
        owl:NamedIndividual ;
    rdfs:label "Process ID" ;
    ics:courseId "SP_ICS01" ;
    ics:definition "Unique integer (PID) the OS assigns to each running process. Used to track, signal, or kill the process. Readable via os.getpid()." ;
    ics:taughtIn ics:L11 .

ics:SP_ICS05 a ics:SystemProperty,
        owl:NamedIndividual ;
    rdfs:label "Relative Path" ;
    ics:contrastsWith ics:SP_ICS04 ;
    ics:courseId "SP_ICS05" ;
    ics:definition "A file path interpreted relative to the process's current working directory. The same relative path resolves to different files depending on where the process was launched." ;
    ics:dependsOn ics:C_ICS14 ;
    ics:taughtIn ics:L11 ;
    ics:throwsError ics:E_ICS02 .

ics:C_ICS01 a ics:Concept,
        owl:NamedIndividual ;
    rdfs:label "Layer Model" ;
    ics:bestPractice "Identify which layer a bug lives in before touching code — most 'mysterious' bugs are OS-level (paths, permissions, encodings)." ;
    ics:cognitiveType "conceptual" ;
    ics:courseId "C_ICS01" ;
    ics:definition "The four-layer abstraction stack that every running Python program sits inside: Your Python Code → Python Runtime → Operating System → Hardware. Bugs at one layer cannot be fixed by changing a different layer." ;
    ics:taughtIn ics:L11 .

ics:C_ICS14 a ics:Concept,
        owl:NamedIndividual ;
    rdfs:label "Working Directory" ;
    ics:bestPractice "Always use absolute paths or explicitly set the CWD when writing scripts that read/write files." ;
    ics:cognitiveType "procedural" ;
    ics:courseId "C_ICS14" ;
    ics:definition "The current working directory (CWD) — the folder a process uses as its base for resolving relative file paths. A script that works on one machine can fail with FileNotFoundError on another if launched from a different CWD." ;
    ics:dependsOn ics:RE_ICS01 ;
    ics:taughtIn ics:L11 .

ics:C_ICS22 a ics:Concept,
        owl:NamedIndividual ;
    rdfs:label "str vs bytes Distinction" ;
    ics:cognitiveType "conceptual" ;
    ics:courseId "C_ICS22" ;
    ics:definition "Python's fundamental text/data duality: str is decoded text carrying meaning; bytes is raw binary data. The OS reads/writes bytes; Python converts between them via an encoding." ;
    ics:dependsOn ics:C_ICS21 ;
    ics:taughtIn ics:L11 .

ics:SL_ICS04 a ics:SystemLayer,
        owl:NamedIndividual ;
    rdfs:label "Python Interpreter (CPython)" ;
    ics:courseId "SL_ICS04" ;
    ics:definition "The reference implementation of Python in C. Compiles .py files to bytecode and executes them in a bytecode interpreter loop." ;
    ics:partOf ics:SL_ICS03 ;
    ics:taughtIn ics:L11 .

ics:SM_ICS02 a ics:SystemMechanism,
        owl:NamedIndividual ;
    rdfs:label "Privilege Ring" ;
    ics:courseId "SM_ICS02" ;
    ics:definition "CPU hardware mechanism enforcing four privilege levels (Ring 0–3). Kernel runs at Ring 0; Python at Ring 3. Hardware prevents user-space code from accessing Ring 0 operations." ;
    ics:taughtIn ics:L11 .

ics:SP_ICS02 a ics:SystemProperty,
        owl:NamedIndividual ;
    rdfs:label "Environment Variable" ;
    ics:courseId "SP_ICS02" ;
    ics:definition "A named string value in the process environment, inherited from the parent process. Configures runtime behaviour without changing source code (e.g. API keys, locale, debug flags)." ;
    ics:managedBy ics:SL_ICS01 ;
    ics:taughtIn ics:L11 .

ics:SP_ICS04 a ics:SystemProperty,
        owl:NamedIndividual ;
    rdfs:label "Absolute Path" ;
    ics:contrastsWith ics:SP_ICS05 ;
    ics:courseId "SP_ICS04" ;
    ics:definition "A file path starting from the filesystem root (/ on Unix, C:\\ on Windows). Unambiguous regardless of the process's working directory." ;
    ics:taughtIn ics:L11 .

ics:BuiltInFunction a owl:Class ;
    rdfs:label "BuiltInFunction" ;
    rdfs:comment "A native Python function" .

ics:C_ICS21 a ics:Concept,
        owl:NamedIndividual ;
    rdfs:label "Character Encoding" ;
    ics:bestPractice "Always specify the encoding explicitly when opening files: open('file.txt', encoding='utf-8')." ;
    ics:cognitiveType "theoretical" ;
    ics:courseId "C_ICS21" ;
    ics:definition "A rule that maps byte sequences to human-readable text characters. The same sequence of bytes produces different text depending on which encoding is used to interpret it. Files are bytes — text is an interpretation." ;
    ics:dependsOn ics:C_ICS20 ;
    ics:taughtIn ics:L11 .

ics:Encoding a owl:Class ;
    rdfs:label "Encoding" ;
    rdfs:comment "A byte-to-symbol mapping standard" .

ics:HC_ICS01 a ics:HardwareComponent,
        owl:NamedIndividual ;
    rdfs:label "CPU" ;
    ics:courseId "HC_ICS01" ;
    ics:definition "Central Processing Unit — executes instructions. Contains cores, registers, and cache levels." ;
    ics:managedBy ics:SL_ICS01 ;
    ics:taughtIn ics:L11 .

ics:Lecture a owl:Class ;
    rdfs:label "Lecture" ;
    rdfs:comment "A course lecture unit" .

ics:SK_ICS01 a ics:Skill,
        owl:NamedIndividual ;
    rdfs:label "Understand a process as the OS unit of execution" ;
    ics:courseId "SK_ICS01" ;
    ics:definition "Distinguish a program (static file on disk) from a process (running instance created by the OS), explain that each process runs in isolation with its own memory space, and identify the OS as the entity that creates, schedules, and destroys processes." ;
    ics:taughtIn ics:L11 ;
    ics:usesConcept ics:HC_ICS01,
        ics:HC_ICS07,
        ics:RE_ICS01,
        ics:RE_ICS02,
        ics:SL_ICS01 .

ics:SL_ICS03 a ics:SystemLayer,
        owl:NamedIndividual ;
    rdfs:label "Python Runtime" ;
    ics:courseId "SL_ICS03" ;
    ics:definition "The execution environment that runs your Python code: parses source, compiles to bytecode, executes it, manages memory, and mediates OS requests." ;
    ics:managedBy ics:SL_ICS01 ;
    ics:taughtIn ics:L11 .

ics:DataType a owl:Class ;
    rdfs:label "DataType" ;
    rdfs:comment "A Python data type" .

ics:Method a owl:Class ;
    rdfs:label "Method" ;
    rdfs:comment "A type-specific callable" .

ics:SL_ICS02 a ics:SystemLayer,
        owl:NamedIndividual ;
    rdfs:label "Kernel" ;
    ics:contrastsWith ics:C_ICS06 ;
    ics:courseId "SL_ICS02" ;
    ics:definition "The privileged core of the OS running at Ring 0. Has direct hardware access and enforces all security policies. Device drivers run inside the kernel." ;
    ics:partOf ics:SL_ICS01 ;
    ics:taughtIn ics:L11 ;
    ics:usesConcept ics:SM_ICS02 .

ics:RuntimeEntity a owl:Class ;
    rdfs:label "RuntimeEntity" ;
    rdfs:comment "A concrete artifact or agent that exists at runtime" .

ics:SystemProperty a owl:Class ;
    rdfs:label "SystemProperty" ;
    rdfs:comment "A named inspectable value attached to a running process" .

ics:ErrorType a owl:Class ;
    rdfs:label "ErrorType" ;
    rdfs:comment "A Python exception type" .

ics:RE_ICS01 a ics:RuntimeEntity,
        owl:NamedIndividual ;
    rdfs:label "Process" ;
    ics:contrastsWith ics:RE_ICS02 ;
    ics:courseId "RE_ICS01" ;
    ics:definition "A running instance of a program, created by the OS. Has its own isolated memory (stack + heap), a PID, open file handles, and its own environment." ;
    ics:managedBy ics:SL_ICS01 ;
    ics:taughtIn ics:L11 .

ics:Skill a owl:Class ;
    rdfs:label "Skill" ;
    rdfs:comment "A transferable cognitive operation" .

ics:HardwareComponent a owl:Class ;
    rdfs:label "HardwareComponent" ;
    rdfs:comment "A physical computing component" .

ics:SystemLayer a owl:Class ;
    rdfs:label "SystemLayer" ;
    rdfs:comment "An autonomous software/firmware layer in the execution stack" .

ics:SystemMechanism a owl:Class ;
    rdfs:label "SystemMechanism" ;
    rdfs:comment "An OS/hardware operational policy or procedure" .

ics:Concept a owl:Class ;
    rdfs:label "Concept" ;
    rdfs:comment "An abstract theoretical foundation" .

ics:SL_ICS01 a ics:SystemLayer,
        owl:NamedIndividual ;
    rdfs:label "Operating System" ;
    ics:courseId "SL_ICS01" ;
    ics:definition "The software system that manages all hardware and provides services to applications. Python never talks to hardware directly — it asks the OS." ;
    ics:taughtIn ics:L11 .

ics:L11 a ics:Lecture,
        owl:NamedIndividual ;
    rdfs:label "Introduction to Computer Systems" ;
    ics:courseId "L11" .

[] a owl:AllDisjointClasses ;
    owl:members ( ics:Lecture ics:Concept ics:LanguageConstruct ics:Encoding ics:DataType ics:ErrorType ics:BuiltInFunction ics:Method ics:Skill ics:HardwareComponent ics:SystemLayer ics:RuntimeEntity ics:SystemMechanism ics:SystemProperty ) .

