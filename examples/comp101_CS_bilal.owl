  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL17">
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL11"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ctrl:bestPractice>Use membership testing instead of multiple equality comparisons whenever checking whether a value belongs to a collection.</ctrl:bestPractice>
    <ctrl:definition>Determining whether a value belongs to a sequence or iterable. Membership testing is commonly used to guide conditional execution and iteration.</ctrl:definition>
    <ctrl:courseId>C_CTRL17</ctrl:courseId>
    <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL03"/>
    <rdfs:label>Membership Testing</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL05">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
    <ctrl:courseId>C_CTRL05</ctrl:courseId>
    <rdfs:label>Loop Body</rdfs:label>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:definition>The block of statements executed during each iteration of a loop. The loop body usually updates variables, performs computations, or produces output.</ctrl:definition>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL04"/>
  </rdf:Description>
