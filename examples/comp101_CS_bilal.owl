    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:courseId>DT_CTRL02</ctrl:courseId>
    <ctrl:definition>Boolean type containing only True and False.</ctrl:definition>
    <rdfs:label>bool</rdfs:label>
  </rdf:Description>
