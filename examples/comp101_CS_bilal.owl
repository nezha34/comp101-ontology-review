  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#A_CTRL01">
    <ctrl:solvesProblem>Determine whether an integer is prime.</ctrl:solvesProblem>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Algorithm"/>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL18"/>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL03"/>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL17"/>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL07"/>
    <rdfs:label>Prime Number Test</rdfs:label>
    <ctrl:courseId>A_CTRL01</ctrl:courseId>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL04"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL06"/>
    <ctrl:definition>Determines whether a positive integer is prime by testing divisibility using a loop and stopping as soon as a divisor is found.</ctrl:definition>
    <ctrl:timeComplexity>O(n)</ctrl:timeComplexity>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#A_CTRL04">
    <ctrl:solvesProblem>Print a right triangle pattern of stars.</ctrl:solvesProblem>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Algorithm"/>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL05"/>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL07"/>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL16"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL04"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#F_CTRL03"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:courseId>A_CTRL04</ctrl:courseId>
    <rdfs:label>Pattern Printer</rdfs:label>
    <ctrl:definition>Prints a right triangle of stars using nested for loops.</ctrl:definition>
    <ctrl:timeComplexity>O(n²)</ctrl:timeComplexity>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL03">
    <rdfs:label>Boolean Condition</rdfs:label>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL02"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL03"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL08"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL05"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL09"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL01"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL06"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL07"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL04"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ctrl:courseId>C_CTRL03</ctrl:courseId>
    <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
    <ctrl:definition>A Boolean expression whose evaluation determines whether a branch executes or whether a loop continues. Boolean conditions are the decision-making mechanism of control structures.</ctrl:definition>
    <ctrl:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#E_CTRL03"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nfaf27cd75b964647a6ed981c5a4fea6c">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Skill"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#implementedBy">
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <rdfs:label>implemented_by</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment>Indicates the Python language construct that realizes or expresses a programming concept.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#dependsOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label>depends_on</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment>Indicates that understanding one educational entity requires prior understanding of another.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL06">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:bestPractice>Choose meaningful loop variable names that reflect the role of the variable.</ctrl:bestPractice>
    <rdfs:label>Loop Variable</rdfs:label>
    <ctrl:courseId>C_CTRL06</ctrl:courseId>
    <ctrl:definition>A variable whose value changes from one iteration to another and represents the current progress of a loop. The loop variable often determines which element is currently being processed.</ctrl:definition>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL07"/>
    <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
    <ctrl:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#E_CTRL02"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL06">
    <rdfs:label>&gt;=</rdfs:label>
    <ctrl:definition>Tests whether the left operand is greater than or equal to the right operand.</ctrl:definition>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Operator"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ctrl:courseId>O_CTRL06</ctrl:courseId>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL18">
    <ctrl:bestPractice>Use break only when continuing the loop serves no useful purpose.</ctrl:bestPractice>
    <ctrl:definition>Ending the execution of a loop before its normal termination condition has been reached because the desired result has already been obtained.</ctrl:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <rdfs:label>Early Loop Termination</rdfs:label>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL13"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL06"/>
    <ctrl:courseId>C_CTRL18</ctrl:courseId>
    <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
    <ctrl:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL19"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL20">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
    <ctrl:courseId>C_CTRL20</ctrl:courseId>
    <rdfs:label>Accumulator Pattern</rdfs:label>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:definition>
        A programming pattern where a variable is updated during each iteration to accumulate a running total, count, or similar value.
    </ctrl:definition>
    <ctrl:bestPractice>
        Initialize the accumulator before the loop and update it consistently during every iteration.
    </ctrl:bestPractice>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL04"/>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL12"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N588e24d4a65c49c88e10e97050d6b55e">
    <rdf:rest rdf:nodeID="Ne1f14637ff204662ae44dd45e6b210b8"/>
    <rdf:first rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DataType"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#cognitiveType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>cognitive_type</rdfs:label>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <rdfs:comment>Indicates the nature of the knowledge represented by a concept, such as conceptual, procedural, or theoretical.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL07">
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label>Definite Iteration</rdfs:label>
    <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL04"/>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL08"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL04"/>
    <ctrl:definition>A form of iteration in which the sequence of values to visit is known before execution begins. In Python, definite iteration is naturally expressed using a for loop over an iterable.</ctrl:definition>
    <ctrl:bestPractice>Prefer a for loop whenever iterating over a known sequence or iterable.</ctrl:bestPractice>
    <ctrl:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL11"/>
    <ctrl:courseId>C_CTRL07</ctrl:courseId>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#isThrownBy">
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#ErrorType"/>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#throwsError"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Inverse of throws_error.</rdfs:comment>
    <rdfs:label>is_thrown_by</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#F_CTRL01">
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#BuiltInFunction"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ctrl:producesType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL04"/>
    <ctrl:acceptsType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL01"/>
    <ctrl:courseId>F_CTRL01</ctrl:courseId>
    <rdfs:label>range()</rdfs:label>
    <ctrl:definition>Produces a sequence of integers for definite iteration.</ctrl:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#isProducedBy">
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#producesType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DataType"/>
    <rdfs:label>is_produced_by</rdfs:label>
    <rdfs:comment>Inverse of produces_type.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL02">
    <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL03"/>
    <ctrl:definition>Executing a block of statements only when a Boolean condition evaluates to True. Conditional execution enables programs to make decisions based on data or user input.</ctrl:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <ctrl:courseId>C_CTRL02</ctrl:courseId>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL01"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL02"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL03"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <rdfs:label>Conditional Execution</rdfs:label>
    <ctrl:bestPractice>Keep Boolean conditions simple and readable.</ctrl:bestPractice>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL11">
    <ctrl:definition>Tests whether a value belongs to a sequence or iterable.</ctrl:definition>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Operator"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL03"/>
    <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL04"/>
    <rdfs:label>in</rdfs:label>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:courseId>O_CTRL11</ctrl:courseId>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#A_CTRL03">
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL13"/>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL11"/>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL12"/>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL06"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL05"/>
    <ctrl:solvesProblem>Convert an integer into binary representation.</ctrl:solvesProblem>
    <rdfs:label>Repeated Division Binary Conversion</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Algorithm"/>
    <ctrl:definition>Converts an integer into its binary representation by repeatedly dividing by two and recording the remainders.</ctrl:definition>
    <ctrl:courseId>A_CTRL03</ctrl:courseId>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL04">
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:courseId>LC_CTRL04</ctrl:courseId>
    <rdfs:label>for loop</rdfs:label>
    <ctrl:definition>Executes a block once for each value produced by an iterable.</ctrl:definition>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LanguageConstruct"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ctrl:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#E_CTRL01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#SK_CTRL01">
    <ctrl:courseId>SK_CTRL01</ctrl:courseId>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL01"/>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL11"/>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL04"/>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL07"/>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL02"/>
    <rdfs:label>Control Program Execution</rdfs:label>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Skill"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:definition>Design programs whose execution follows different paths or performs repeated actions by combining conditionals and loops appropriately.</ctrl:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#isRequiredBy">
    <rdfs:comment>Inverse of depends_on.</rdfs:comment>
    <rdfs:label>is_required_by</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#dependsOn"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#Concept">
    <rdfs:label>Concept</rdfs:label>
    <rdfs:comment>An abstract programming concept</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL19">
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL07"/>
    <ctrl:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL18"/>
    <ctrl:bestPractice>Use continue sparingly because excessive use can make loop logic harder to understand.</ctrl:bestPractice>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <rdfs:label>Iteration Skipping</rdfs:label>
    <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
    <ctrl:definition>Skipping the remainder of the current iteration while allowing the loop to continue with the next iteration.</ctrl:definition>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL04"/>
    <ctrl:courseId>C_CTRL19</ctrl:courseId>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL12">
    <ctrl:courseId>C_CTRL12</ctrl:courseId>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:bestPractice>Ensure that every iteration modifies the loop state so that the loop eventually terminates.</ctrl:bestPractice>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL11"/>
    <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
    <rdfs:label>Loop State</rdfs:label>
    <ctrl:definition>The collection of variables whose values determine the current progress and future behaviour of a loop. Updating the loop state correctly is essential for correct execution.</ctrl:definition>
    <ctrl:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#E_CTRL02"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#E_CTRL02">
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:definition>Raised when a variable or identifier has not been defined.</ctrl:definition>
    <ctrl:commonCauses>Using a variable before assignment | Typographical error in a variable name</ctrl:commonCauses>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#ErrorType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label>NameError</rdfs:label>
    <ctrl:courseId>E_CTRL02</ctrl:courseId>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL14">
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL12"/>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL13"/>
    <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
    <ctrl:bestPractice>Always verify that variables controlling the loop are modified appropriately.</ctrl:bestPractice>
    <rdfs:label>Infinite Loop</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <ctrl:definition>A loop that never reaches its termination condition because the loop state is not updated correctly or because the stopping condition can never become False.</ctrl:definition>
    <ctrl:courseId>C_CTRL14</ctrl:courseId>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL10">
    <ctrl:courseId>C_CTRL10</ctrl:courseId>
    <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
    <ctrl:definition>Traversal performed by iterating over the numerical positions of a sequence rather than directly over its elements.</ctrl:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <rdfs:label>Index Traversal</rdfs:label>
    <ctrl:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL08"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL08"/>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL09"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#LanguageConstruct">
    <rdfs:label>LanguageConstruct</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A Python language construct</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#ErrorType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ErrorType</rdfs:label>
    <rdfs:comment>A Python exception type</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#throwsError">
    <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#ErrorType"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Associates a language construct, function, method, or concept with an error that may result from its incorrect use.</rdfs:comment>
    <rdfs:label>throws_error</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL05">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Operator"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ctrl:definition>Tests whether the left operand is greater than the right operand.</ctrl:definition>
    <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL01"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <rdfs:label>&gt;</rdfs:label>
    <ctrl:courseId>O_CTRL05</ctrl:courseId>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf3f2d2782885497584df5af3333bbd31">
    <rdf:first rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Operator"/>
    <rdf:rest rdf:nodeID="N588e24d4a65c49c88e10e97050d6b55e"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL01"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL04"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL05"/>
    <ctrl:definition>A programming construct that changes the normal sequential execution of a program by allowing decisions or repetition. Control structures enable programs to adapt their behaviour without duplicating code.</ctrl:definition>
    <rdfs:label>Control Structure</rdfs:label>
    <ctrl:courseId>C_CTRL01</ctrl:courseId>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#definition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label>definition</rdfs:label>
    <rdfs:comment>Provides the pedagogical definition of an ontology entity.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#courseId">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>course_id</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Stores the unique identifier assigned to an entity within the COMP101 ontology.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL10">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Operator"/>
    <rdfs:label>%</rdfs:label>
    <ctrl:courseId>O_CTRL10</ctrl:courseId>
    <ctrl:definition>Returns the remainder after integer division.</ctrl:definition>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#methodOf">
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#hasMethods"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>method_of</rdfs:label>
    <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DataType"/>
    <rdfs:comment>This method belongs to a data type.</rdfs:comment>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Method"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#E_CTRL04">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#ErrorType"/>
    <ctrl:courseId>E_CTRL04</ctrl:courseId>
    <rdfs:label>ValueError</rdfs:label>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:commonCauses>Calling int() with a string that does not represent an integer</ctrl:commonCauses>
    <ctrl:definition>Raised when a value has the correct type but an inappropriate value.</ctrl:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#E_CTRL05">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#ErrorType"/>
    <ctrl:courseId>E_CTRL05</ctrl:courseId>
    <rdfs:label>IndexError</rdfs:label>
    <ctrl:definition>
        Raised when an index is outside the valid range of a sequence.
    </ctrl:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#E_CTRL06">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#ErrorType"/>
    <ctrl:courseId>E_CTRL06</ctrl:courseId>
    <rdfs:label>ZeroDivisionError</rdfs:label>
    <ctrl:definition>
        Raised when division or modulo is attempted using zero as the divisor.
    </ctrl:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#Operator">
    <rdfs:label>Operator</rdfs:label>
    <rdfs:comment>A Python operator</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL15">
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <rdfs:label>Nested Conditional</rdfs:label>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL01"/>
    <ctrl:definition>A conditional statement placed inside another conditional or loop. Nested conditionals allow decisions to be refined by evaluating additional conditions.</ctrl:definition>
    <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
    <ctrl:courseId>C_CTRL15</ctrl:courseId>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL02"/>
    <ctrl:bestPractice>Avoid excessive nesting by combining related Boolean conditions when possible.</ctrl:bestPractice>
    <ctrl:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL16"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL01">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LanguageConstruct"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ctrl:definition>Executes a block only when a Boolean condition evaluates to True.</ctrl:definition>
    <ctrl:courseId>LC_CTRL01</ctrl:courseId>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <rdfs:label>if statement</rdfs:label>
    <ctrl:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#E_CTRL01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#timeComplexity">
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label>time_complexity</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Specifies the asymptotic time complexity of an algorithm.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#contrastsWith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label>contrasts_with</rdfs:label>
    <rdfs:comment>Relates two concepts that represent alternative, opposite, or commonly confused ideas.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL07">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LanguageConstruct"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:definition>Skips the remainder of the current iteration and starts the next one.</ctrl:definition>
    <rdfs:label>continue statement</rdfs:label>
    <ctrl:courseId>LC_CTRL07</ctrl:courseId>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL08">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LanguageConstruct"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:courseId>LC_CTRL08</ctrl:courseId>
    <rdfs:label>enumerate()</rdfs:label>
    <ctrl:definition>
        Iterates over an iterable while providing both the index and the corresponding value.
    </ctrl:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL11">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <ctrl:courseId>C_CTRL11</ctrl:courseId>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL03"/>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL04"/>
    <ctrl:bestPractice>Use a while loop only when the stopping condition depends on values that change during execution.</ctrl:bestPractice>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL07"/>
    <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
    <ctrl:definition>Iteration whose continuation depends on the repeated evaluation of a Boolean condition. The total number of iterations is not known before execution begins.</ctrl:definition>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL05"/>
    <rdfs:label>Condition-Controlled Iteration</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#DataType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A Python data type</rdfs:comment>
    <rdfs:label>DataType</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL05">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LanguageConstruct"/>
    <ctrl:courseId>LC_CTRL05</ctrl:courseId>
    <ctrl:definition>Repeats execution while a Boolean condition remains True.</ctrl:definition>
    <rdfs:label>while loop</rdfs:label>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#E_CTRL01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#SK_CTRL03">
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL12"/>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL14"/>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL04"/>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL13"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Skill"/>
    <ctrl:definition>Predict and explain the execution of programs containing conditionals and loops by following the evolution of variables and control flow.</ctrl:definition>
    <ctrl:courseId>SK_CTRL03</ctrl:courseId>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <rdfs:label>Trace Program Execution</rdfs:label>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#SK_CTRL01"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#Lecture">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Lecture</rdfs:label>
    <rdfs:comment>A COMP101 lecture</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL01">
    <ctrl:courseId>DT_CTRL01</ctrl:courseId>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DataType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label>int</rdfs:label>
    <ctrl:definition>Integer numeric type.</ctrl:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL04">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DataType"/>
    <ctrl:courseId>DT_CTRL04</ctrl:courseId>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:definition>An immutable iterable sequence of integers produced by range().</ctrl:definition>
    <rdfs:label>range</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL01">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Operator"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL03"/>
