  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL02">
    <rdfs:label>!=</rdfs:label>
    <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL01"/>
    <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL02"/>
    <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL03"/>
