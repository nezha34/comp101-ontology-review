    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#ErrorType"/>
    <ctrl:definition>Raised when Python encounters invalid syntax.</ctrl:definition>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <rdfs:label>SyntaxError</rdfs:label>
    <ctrl:courseId>E_CTRL01</ctrl:courseId>
    <ctrl:commonCauses>Missing ':' after if, for or while | Incorrect indentation | Invalid Python syntax</ctrl:commonCauses>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#SK_CTRL02">
