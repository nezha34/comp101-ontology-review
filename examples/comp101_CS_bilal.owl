  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures">
    <owl:versionInfo>2.0</owl:versionInfo>
    <dc:title>COMP101 Control Structures Ontology</dc:title>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL07">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Operator"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL02"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:courseId>O_CTRL07</ctrl:courseId>
    <rdfs:label>and</rdfs:label>
    <ctrl:definition>Logical conjunction returning True only if both operands are True.</ctrl:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL09">
    <ctrl:courseId>C_CTRL09</ctrl:courseId>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label>Traversal</rdfs:label>
    <ctrl:bestPractice>Iterate directly over elements instead of indices whenever the index itself is not required.</ctrl:bestPractice>
    <ctrl:definition>The systematic process of visiting each element of a sequence exactly once in order to inspect, process, or analyse its contents.</ctrl:definition>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL07"/>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL08"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL04"/>
    <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#F_CTRL02">
    <ctrl:producesType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL01"/>
    <ctrl:acceptsType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL03"/>
    <ctrl:acceptsType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL04"/>
    <rdfs:label>len()</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#BuiltInFunction"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:courseId>F_CTRL02</ctrl:courseId>
    <ctrl:definition>Returns the number of elements contained in a sequence.</ctrl:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL02">
    <ctrl:courseId>LC_CTRL02</ctrl:courseId>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LanguageConstruct"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:definition>Evaluates an additional condition when all previous conditions are False.</ctrl:definition>
    <rdfs:label>elif clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#producesType">
    <rdfs:comment>Returns this data type.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label>produces_type</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#isProducedBy"/>
    <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DataType"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL08">
    <ctrl:definition>Logical disjunction returning True if at least one operand is True.</ctrl:definition>
    <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL02"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:courseId>O_CTRL08</ctrl:courseId>
    <rdfs:label>or</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Operator"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL08">
    <rdfs:label>Iterable</rdfs:label>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL03"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL04"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
    <ctrl:courseId>C_CTRL08</ctrl:courseId>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:definition>An object capable of producing its elements one after another during iteration. Strings and range objects are examples of iterables introduced in this lecture.</ctrl:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL13">
    <ctrl:definition>The mechanism by which a loop stops executing. A loop terminates when its continuation condition becomes False or when execution is interrupted explicitly.</ctrl:definition>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL12"/>
    <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
    <ctrl:bestPractice>Design every loop so that its termination condition will eventually be satisfied.</ctrl:bestPractice>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:courseId>C_CTRL13</ctrl:courseId>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL06"/>
    <rdfs:label>Loop Termination</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL16">
    <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL04"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <ctrl:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL15"/>
    <ctrl:definition>A loop placed inside another loop. During each iteration of the outer loop, the inner loop executes completely.</ctrl:definition>
    <ctrl:bestPractice>Keep nested loops as shallow as possible to improve readability and reduce unnecessary computation.</ctrl:bestPractice>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL04"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL05"/>
    <ctrl:courseId>C_CTRL16</ctrl:courseId>
    <rdfs:label>Nested Loop</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL04">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL01"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL04"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL05"/>
    <ctrl:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL02"/>
    <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
    <ctrl:courseId>C_CTRL04</ctrl:courseId>
    <ctrl:definition>The repeated execution of the same block of statements. Each repetition, called an iteration, allows repetitive tasks to be performed while progressively changing the program state.</ctrl:definition>
    <rdfs:label>Iteration</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#L03">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Lecture"/>
    <ctrl:courseId>L03</ctrl:courseId>
    <rdfs:label>Control Structures</rdfs:label>
    <ctrl:definition>Conditionals and Loops</ctrl:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#E_CTRL03">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#ErrorType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ctrl:courseId>E_CTRL03</ctrl:courseId>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <rdfs:label>TypeError</rdfs:label>
    <ctrl:definition>Raised when an operation is applied to an object of an inappropriate type.</ctrl:definition>
    <ctrl:commonCauses>Comparing incompatible types | Invalid operand types for an operator</ctrl:commonCauses>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N675a740e3f214c639d8038ffe6d1064d">
    <rdf:rest rdf:nodeID="Nd62d860f293147148859f89ff11ebbd2"/>
    <rdf:first rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
