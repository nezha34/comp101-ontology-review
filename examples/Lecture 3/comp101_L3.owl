    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:acceptsType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL01"/>
    <ctrl:acceptsType>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL02">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DataType"/>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
        <ctrl:courseId>DT_CTRL02</ctrl:courseId>
        <ctrl:definition>Boolean type containing only True and False.</ctrl:definition>
        <rdfs:label>bool</rdfs:label>
      </owl:NamedIndividual>
    </ctrl:acceptsType>
    <ctrl:acceptsType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL03"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL15">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <rdfs:label>Nested Conditional</rdfs:label>
    <ctrl:implementedBy>
      <ctrl:LanguageConstruct rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL01">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ctrl:definition>Executes a block only when a Boolean condition evaluates to True.</ctrl:definition>
        <ctrl:courseId>LC_CTRL01</ctrl:courseId>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
        <rdfs:label>if statement</rdfs:label>
        <ctrl:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#E_CTRL01"/>
      </ctrl:LanguageConstruct>
    </ctrl:implementedBy>
    <ctrl:definition>A conditional statement placed inside another conditional or loop. Nested conditionals allow decisions to be refined by evaluating additional conditions.</ctrl:definition>
    <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
    <ctrl:courseId>C_CTRL15</ctrl:courseId>
    <ctrl:dependsOn>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL02">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
        <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
        <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL03"/>
        <ctrl:definition>Executing a block of statements only when a Boolean condition evaluates to True. Conditional execution enables programs to make decisions based on data or user input.</ctrl:definition>
        <ctrl:courseId>C_CTRL02</ctrl:courseId>
        <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL01"/>
        <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL02"/>
        <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL03"/>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
        <rdfs:label>Conditional Execution</rdfs:label>
        <ctrl:bestPractice>Keep Boolean conditions simple and readable.</ctrl:bestPractice>
      </owl:NamedIndividual>
    </ctrl:dependsOn>
    <ctrl:bestPractice>Avoid excessive nesting by combining related Boolean conditions when possible.</ctrl:bestPractice>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL05">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
    <ctrl:courseId>C_CTRL05</ctrl:courseId>
    <rdfs:label>Loop Body</rdfs:label>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:definition>The block of statements executed during each iteration of a loop. The loop body usually updates variables, performs computations, or produces output.</ctrl:definition>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL04"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#SK_CTRL03">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Skill"/>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL12"/>
    <ctrl:usesConcept>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL14">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
        <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL12"/>
        <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL13"/>
        <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
        <ctrl:bestPractice>Always verify that variables controlling the loop are modified appropriately.</ctrl:bestPractice>
        <rdfs:label>Infinite Loop</rdfs:label>
        <ctrl:definition>A loop that never reaches its termination condition because the loop state is not updated correctly or because the stopping condition can never become False.</ctrl:definition>
        <ctrl:courseId>C_CTRL14</ctrl:courseId>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
      </owl:NamedIndividual>
    </ctrl:usesConcept>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL04"/>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL13"/>
    <ctrl:definition>Predict and explain the execution of programs containing conditionals and loops by following the evolution of variables and control flow.</ctrl:definition>
    <ctrl:courseId>SK_CTRL03</ctrl:courseId>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <rdfs:label>Trace Program Execution</rdfs:label>
    <ctrl:dependsOn>
      <ctrl:Skill rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#SK_CTRL01">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ctrl:courseId>SK_CTRL01</ctrl:courseId>
        <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL01"/>
        <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL11"/>
        <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL04"/>
        <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL07"/>
        <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL02"/>
        <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#P_CTRL03"/>
        <rdfs:label>Control Program Execution</rdfs:label>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
        <ctrl:definition>Design programs whose execution follows different paths or performs repeated actions by combining conditionals and loops appropriately.</ctrl:definition>
        <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#SK_CTRL02"/>
      </ctrl:Skill>
    </ctrl:dependsOn>
  </owl:NamedIndividual>
