    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Specifies the asymptotic time complexity of an algorithm.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL03">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LanguageConstruct"/>
    <ctrl:definition>Executes when none of the previous conditions evaluate to True.</ctrl:definition>
    <ctrl:courseId>LC_CTRL03</ctrl:courseId>
    <rdfs:label>else clause</rdfs:label>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
  </owl:NamedIndividual>
  <ctrl:Operator rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL06">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label>&gt;=</rdfs:label>
    <ctrl:definition>Tests whether the left operand is greater than or equal to the right operand.</ctrl:definition>
    <ctrl:courseId>O_CTRL06</ctrl:courseId>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL01"/>
  </ctrl:Operator>
  <ctrl:Operator rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL11">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ctrl:definition>Tests whether a value belongs to a sequence or iterable.</ctrl:definition>
    <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL03"/>
    <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL04"/>
    <rdfs:label>in</rdfs:label>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:courseId>O_CTRL11</ctrl:courseId>
    <ctrl:contrastsWith>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL12">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Operator"/>
        <rdfs:label>not in</rdfs:label>
        <ctrl:courseId>O_CTRL12</ctrl:courseId>
        <ctrl:definition>Tests whether a value does not belong to a sequence or iterable.</ctrl:definition>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
        <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL03"/>
        <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL04"/>
        <ctrl:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL11"/>
      </owl:NamedIndividual>
    </ctrl:contrastsWith>
  </ctrl:Operator>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#Concept">
    <rdfs:label>Concept</rdfs:label>
    <rdfs:comment>An abstract programming concept</rdfs:comment>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL08">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <rdfs:label>Iterable</rdfs:label>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL03"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL04"/>
    <ctrl:implementedBy>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL05">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DataType"/>
        <rdfs:label>enumerate</rdfs:label>
        <ctrl:courseId>DT_CTRL05</ctrl:courseId>
        <ctrl:definition>An iterable of (index, element) pairs produced by enumerate().</ctrl:definition>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
      </owl:NamedIndividual>
    </ctrl:implementedBy>
    <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
    <ctrl:courseId>C_CTRL08</ctrl:courseId>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:definition>An object capable of producing its elements one after another during iteration. Strings and range objects are examples of iterables introduced in this lecture.</ctrl:definition>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#methodOf">
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#hasMethods">
        <rdfs:label>has_methods</rdfs:label>
        <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DataType"/>
        <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Method"/>
        <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#methodOf"/>
        <rdfs:comment>Inverse of method_of.</rdfs:comment>
      </owl:ObjectProperty>
    </owl:inverseOf>
    <rdfs:label>method_of</rdfs:label>
    <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DataType"/>
    <rdfs:comment>This method belongs to a data type.</rdfs:comment>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Method"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL03">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Operator"/>
    <ctrl:courseId>O_CTRL03</ctrl:courseId>
    <ctrl:definition>Tests whether the left operand is smaller than the right operand.</ctrl:definition>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <rdfs:label>&lt;</rdfs:label>
    <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL01"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL19">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <ctrl:implementedBy>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL07">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LanguageConstruct"/>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
        <ctrl:definition>Skips the remainder of the current iteration and starts the next one.</ctrl:definition>
        <rdfs:label>continue statement</rdfs:label>
        <ctrl:courseId>LC_CTRL07</ctrl:courseId>
      </owl:NamedIndividual>
    </ctrl:implementedBy>
    <ctrl:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL18"/>
    <ctrl:bestPractice>Use continue sparingly because excessive use can make loop logic harder to understand.</ctrl:bestPractice>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <rdfs:label>Iteration Skipping</rdfs:label>
    <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
    <ctrl:definition>Skipping the remainder of the current iteration while allowing the loop to continue with the next iteration.</ctrl:definition>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL04"/>
    <ctrl:courseId>C_CTRL19</ctrl:courseId>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#implementedBy">
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <rdfs:label>implemented_by</rdfs:label>
    <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#ConceptCarrier"/>
    <rdfs:comment>Concept is realized/expressed by this ConceptCarrier (language construct, operator, builtin, or data type). Inverse of implementsConcept. Domain is Concept only (not Algorithm).</rdfs:comment>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#implementsConcept">
        <rdfs:label>implements_concept</rdfs:label>
        <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#ConceptCarrier"/>
        <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
        <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#implementedBy"/>
        <rdfs:comment>Inverse of implementedBy: a ConceptCarrier realizes or expresses this Concept. A-Box may assert only implementedBy; reasoners can infer this direction.</rdfs:comment>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <ctrl:Operator rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL03"/>
    <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL02"/>
    <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL01"/>
    <ctrl:courseId>O_CTRL01</ctrl:courseId>
    <ctrl:definition>Compares two values for equality.</ctrl:definition>
    <rdfs:label>==</rdfs:label>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
  </ctrl:Operator>
  <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#operatesOnType">
    <rdfs:label>operates_on_type</rdfs:label>
    <rdfs:domain>
      <rdf:Description rdf:nodeID="Nb1232947ea0a4d2cabbf6409c498186a">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#Operator"/>
          <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
        </owl:unionOf>
      </rdf:Description>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DataType"/>
    <rdfs:comment>Subject works on / iterates using values of the object DataType. Used for Operators and for pedagogical Concepts such as Index Traversal or Element Traversal.</rdfs:comment>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#operatedOnBy">
        <rdfs:label>operated_on_by</rdfs:label>
        <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DataType"/>
        <rdfs:range>
          <rdf:Description rdf:nodeID="N772fb1723ec14bfbaa97269dbab9c595">
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#Operator"/>
              <rdf:Description rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
            </owl:unionOf>
          </rdf:Description>
        </rdfs:range>
        <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#operatesOnType"/>
        <rdfs:comment>Inverse of operatesOnType.</rdfs:comment>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <ctrl:Operator rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL05">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ctrl:definition>Tests whether the left operand is greater than the right operand.</ctrl:definition>
    <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL01"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <rdfs:label>&gt;</rdfs:label>
    <ctrl:courseId>O_CTRL05</ctrl:courseId>
  </ctrl:Operator>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL08">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Operator"/>
    <ctrl:definition>Logical disjunction returning True if at least one operand is True.</ctrl:definition>
    <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL02"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:courseId>O_CTRL08</ctrl:courseId>
    <rdfs:label>or</rdfs:label>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL09">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Operator"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL02"/>
    <ctrl:definition>Logical negation that reverses a Boolean value.</ctrl:definition>
    <ctrl:courseId>O_CTRL09</ctrl:courseId>
    <rdfs:label>not</rdfs:label>
  </owl:NamedIndividual>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#LanguageConstruct">
    <rdfs:label>LanguageConstruct</rdfs:label>
    <rdfs:comment>A Python language construct</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#ConceptCarrier"/>
  </owl:Class>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#Algorithm">
    <rdfs:label>Algorithm</rdfs:label>
    <rdfs:comment>A programming algorithm taught during the lecture</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </owl:Class>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#ErrorType">
    <rdfs:label>ErrorType</rdfs:label>
    <rdfs:comment>A Python exception type</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#Method">
    <rdfs:comment>A type-specific Python method</rdfs:comment>
    <rdfs:label>Method</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#Operator">
    <rdfs:label>Operator</rdfs:label>
    <rdfs:comment>A Python operator</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#ConceptCarrier"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#E_CTRL01">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#ErrorType"/>
    <ctrl:definition>Raised when Python encounters invalid syntax.</ctrl:definition>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <rdfs:label>SyntaxError</rdfs:label>
    <ctrl:courseId>E_CTRL01</ctrl:courseId>
    <ctrl:commonCauses>Missing ':' after if, for or while | Incorrect indentation | Invalid Python syntax</ctrl:commonCauses>
  </owl:NamedIndividual>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#BuiltInFunction">
    <rdfs:comment>A native Python function</rdfs:comment>
    <rdfs:label>BuiltInFunction</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#ConceptCarrier"/>
  </owl:Class>
  <ctrl:ErrorType rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#E_CTRL02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:definition>Raised when a variable or identifier has not been defined.</ctrl:definition>
    <ctrl:commonCauses>Using a variable before assignment | Typographical error in a variable name</ctrl:commonCauses>
    <rdfs:label>NameError</rdfs:label>
    <ctrl:courseId>E_CTRL02</ctrl:courseId>
  </ctrl:ErrorType>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#P_CTRL03">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Pattern"/>
    <rdfs:label>Sentinel-Controlled Loop Pattern</rdfs:label>
    <ctrl:courseId>P_CTRL03</ctrl:courseId>
    <ctrl:definition>A while-loop recipe that continues processing until a special end value (sentinel) appears, updating loop state each iteration and stopping when the sentinel is detected.</ctrl:definition>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL11"/>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL12"/>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL13"/>
    <ctrl:cognitiveType>procedural</ctrl:cognitiveType>
  </owl:NamedIndividual>
  <ctrl:Skill rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#SK_CTRL02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label>Evaluate Boolean Conditions</rdfs:label>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL03"/>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL17"/>
    <ctrl:courseId>SK_CTRL02</ctrl:courseId>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:definition>Construct, interpret, and combine Boolean conditions that correctly control decisions and repetition.</ctrl:definition>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#SK_CTRL01"/>
  </ctrl:Skill>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#ConceptCarrier">
    <rdfs:label>ConceptCarrier</rdfs:label>
    <rdfs:comment>Python surface that can realize or carry curriculum concepts (language constructs, operators, builtins, data types). Organizational superclass used as domain/range of realization and algorithm-construct properties.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL01">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL01"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL04"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL05"/>
    <ctrl:definition>A programming construct that changes the normal sequential execution of a program by allowing decisions or repetition. Control structures enable programs to adapt their behaviour without duplicating code.</ctrl:definition>
    <rdfs:label>Control Structure</rdfs:label>
    <ctrl:courseId>C_CTRL01</ctrl:courseId>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL02">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LanguageConstruct"/>
    <ctrl:courseId>LC_CTRL02</ctrl:courseId>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:definition>Evaluates an additional condition when all previous conditions are False.</ctrl:definition>
    <rdfs:label>elif clause</rdfs:label>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#constructUsedBy">
    <rdfs:label>construct_used_by</rdfs:label>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#ConceptCarrier"/>
    <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Algorithm"/>
    <rdfs:comment>Inverse of usesConstruct: this ConceptCarrier is employed by the object Algorithm. A-Box may assert only usesConstruct; reasoners can infer this direction.</rdfs:comment>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#usesConstruct">
        <rdfs:label>uses_construct</rdfs:label>
        <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Algorithm"/>
        <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#ConceptCarrier"/>
        <rdfs:comment>Algorithm is coded with / employs this ConceptCarrier (language construct, operator, builtin, or data type). Distinct from implementedBy (Concept → carrier realization). Inverse of constructUsedBy.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#constructUsedBy"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#acceptedBy">
    <rdfs:label>accepted_by</rdfs:label>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DataType"/>
    <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#BuiltInFunction"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#acceptsType">
        <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#BuiltInFunction"/>
        <rdfs:label>accepts_type</rdfs:label>
        <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DataType"/>
        <rdfs:comment>A function accepts this data type as input.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#acceptedBy"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
    <rdfs:comment>Inverse of accepts_type.</rdfs:comment>
  </owl:ObjectProperty>
  <ctrl:ErrorType rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#E_CTRL03">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ctrl:courseId>E_CTRL03</ctrl:courseId>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <rdfs:label>TypeError</rdfs:label>
    <ctrl:definition>Raised when an operation is applied to an object of an inappropriate type.</ctrl:definition>
    <ctrl:commonCauses>Comparing incompatible types | Invalid operand types for an operator</ctrl:commonCauses>
  </ctrl:ErrorType>
  <ctrl:Operator rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL07">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL02"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:courseId>O_CTRL07</ctrl:courseId>
    <rdfs:label>and</rdfs:label>
    <ctrl:definition>Logical conjunction returning True only if both operands are True.</ctrl:definition>
  </ctrl:Operator>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL10">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <ctrl:courseId>C_CTRL10</ctrl:courseId>
    <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
    <ctrl:definition>Traversal performed by iterating over the numerical positions of a sequence rather than directly over its elements.</ctrl:definition>
    <rdfs:label>Index Traversal</rdfs:label>
    <ctrl:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL21"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#F_CTRL06"/>
    <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL09"/>
    <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL05"/>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#isProducedBy">
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#producesType">
        <rdfs:comment>Returns this data type.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>produces_type</rdfs:label>
        <owl:inverseOf rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#isProducedBy"/>
        <rdfs:range rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DataType"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DataType"/>
    <rdfs:label>is_produced_by</rdfs:label>
    <rdfs:comment>Inverse of produces_type.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </owl:ObjectProperty>
  <ctrl:Operator rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label>!=</rdfs:label>
    <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL01"/>
    <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL02"/>
    <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL03"/>
    <ctrl:courseId>O_CTRL02</ctrl:courseId>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:definition>Compares two values for inequality.</ctrl:definition>
  </ctrl:Operator>
  <ctrl:Operator rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL04">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label>&lt;=</rdfs:label>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:definition>Tests whether the left operand is smaller than or equal to the right operand.</ctrl:definition>
    <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL01"/>
    <ctrl:courseId>O_CTRL04</ctrl:courseId>
  </ctrl:Operator>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#Pattern">
    <rdfs:label>Pattern</rdfs:label>
    <rdfs:comment>A reusable pedagogical programming pattern taught in this lecture (e.g. accumulator during iteration).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#DataType">
    <rdfs:comment>A Python data type</rdfs:comment>
    <rdfs:label>DataType</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#ConceptCarrier"/>
  </owl:Class>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#Skill">
    <rdfs:label>Skill</rdfs:label>
    <rdfs:comment>A transferable programming competency</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </owl:Class>
  <owl:Class rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#Lecture">
    <rdfs:label>Lecture</rdfs:label>
    <rdfs:comment>A COMP101 lecture</rdfs:comment>
  </owl:Class>
</rdf:RDF>
