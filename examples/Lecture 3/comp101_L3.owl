<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:ctrl="http://comp101.sase.um6p.ma/ontology/control-structures#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:dc="http://purl.org/dc/elements/1.1/"
>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL16">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
    <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
    <ctrl:dependsOn>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL04">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
        <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL01"/>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
        <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL04"/>
        <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL05"/>
        <ctrl:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL02"/>
        <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
        <ctrl:courseId>C_CTRL04</ctrl:courseId>
        <ctrl:definition>The repeated execution of the same block of statements. Each repetition, called an iteration, allows repetitive tasks to be performed while progressively changing the program state.</ctrl:definition>
        <rdfs:label>Iteration</rdfs:label>
      </owl:NamedIndividual>
    </ctrl:dependsOn>
    <ctrl:definition>A loop placed inside another loop. During each iteration of the outer loop, the inner loop executes completely.</ctrl:definition>
    <ctrl:bestPractice>Keep nested loops as shallow as possible to improve readability and reduce unnecessary computation.</ctrl:bestPractice>
    <ctrl:taughtIn>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#L03">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Lecture"/>
        <ctrl:courseId>L03</ctrl:courseId>
        <rdfs:label>Control Structures</rdfs:label>
        <ctrl:definition>Conditionals and Loops</ctrl:definition>
      </owl:NamedIndividual>
    </ctrl:taughtIn>
    <ctrl:implementedBy>
      <ctrl:LanguageConstruct rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL04">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
        <ctrl:courseId>LC_CTRL04</ctrl:courseId>
        <rdfs:label>for loop</rdfs:label>
        <ctrl:definition>Executes a block once for each value produced by an iterable.</ctrl:definition>
        <ctrl:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#E_CTRL01"/>
      </ctrl:LanguageConstruct>
    </ctrl:implementedBy>
    <ctrl:implementedBy>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL05">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LanguageConstruct"/>
        <ctrl:courseId>LC_CTRL05</ctrl:courseId>
        <ctrl:definition>Repeats execution while a Boolean condition remains True.</ctrl:definition>
        <rdfs:label>while loop</rdfs:label>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
        <ctrl:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#E_CTRL01"/>
      </owl:NamedIndividual>
    </ctrl:implementedBy>
    <ctrl:courseId>C_CTRL16</ctrl:courseId>
    <rdfs:label>Nested Loop</rdfs:label>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#F_CTRL05">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#BuiltInFunction"/>
    <ctrl:definition>Converts a value into an integer when possible.</ctrl:definition>
    <rdfs:label>int()</rdfs:label>
    <ctrl:courseId>F_CTRL05</ctrl:courseId>
    <ctrl:acceptsType>
      <ctrl:DataType rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL01">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ctrl:courseId>DT_CTRL01</ctrl:courseId>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
        <rdfs:label>int</rdfs:label>
        <ctrl:definition>Integer numeric type.</ctrl:definition>
      </ctrl:DataType>
    </ctrl:acceptsType>
    <ctrl:acceptsType>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL03">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DataType"/>
        <ctrl:courseId>DT_CTRL03</ctrl:courseId>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
        <ctrl:definition>Sequence of Unicode characters.</ctrl:definition>
        <rdfs:label>str</rdfs:label>
      </owl:NamedIndividual>
    </ctrl:acceptsType>
    <ctrl:producesType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL01"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:throwsError>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#E_CTRL04">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#ErrorType"/>
        <ctrl:courseId>E_CTRL04</ctrl:courseId>
        <rdfs:label>ValueError</rdfs:label>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
        <ctrl:commonCauses>Calling int() with a string that does not represent an integer</ctrl:commonCauses>
        <ctrl:definition>Raised when a value has the correct type but an inappropriate value.</ctrl:definition>
      </owl:NamedIndividual>
    </ctrl:throwsError>
  </owl:NamedIndividual>
  <ctrl:Algorithm rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#A_CTRL02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ctrl:usesConcept>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL11">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
        <ctrl:courseId>C_CTRL11</ctrl:courseId>
        <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL03"/>
        <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL04"/>
        <ctrl:bestPractice>Use a while loop only when the stopping condition depends on values that change during execution.</ctrl:bestPractice>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
        <ctrl:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL07"/>
        <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
        <ctrl:definition>Iteration whose continuation depends on the repeated evaluation of a Boolean condition. The total number of iterations is not known before execution begins.</ctrl:definition>
        <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL05"/>
        <rdfs:label>Condition-Controlled Iteration</rdfs:label>
      </owl:NamedIndividual>
    </ctrl:usesConcept>
    <ctrl:usesConcept>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL12">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
        <ctrl:courseId>C_CTRL12</ctrl:courseId>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
        <ctrl:bestPractice>Ensure that every iteration modifies the loop state so that the loop eventually terminates.</ctrl:bestPractice>
        <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL11"/>
        <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
        <rdfs:label>Loop State</rdfs:label>
        <ctrl:definition>The collection of variables whose values determine the current progress and future behaviour of a loop. Updating the loop state correctly is essential for correct execution.</ctrl:definition>
        <ctrl:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#E_CTRL02"/>
      </owl:NamedIndividual>
    </ctrl:usesConcept>
    <ctrl:usesConcept>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL13">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
        <ctrl:definition>The mechanism by which a loop stops executing. A loop terminates when its continuation condition becomes False or when execution is interrupted explicitly.</ctrl:definition>
        <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL12"/>
        <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
        <ctrl:bestPractice>Design every loop so that its termination condition will eventually be satisfied.</ctrl:bestPractice>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
        <ctrl:courseId>C_CTRL13</ctrl:courseId>
        <rdfs:label>Loop Termination</rdfs:label>
      </owl:NamedIndividual>
    </ctrl:usesConcept>
    <ctrl:usesConcept>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL06">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
        <ctrl:bestPractice>Choose meaningful loop variable names that reflect the role of the variable.</ctrl:bestPractice>
        <rdfs:label>Loop Variable</rdfs:label>
        <ctrl:courseId>C_CTRL06</ctrl:courseId>
        <ctrl:definition>A variable whose value changes from one iteration to another and represents the current progress of a loop. The loop variable often determines which element is currently being processed.</ctrl:definition>
        <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL07"/>
        <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
        <ctrl:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#E_CTRL02"/>
      </owl:NamedIndividual>
    </ctrl:usesConcept>
    <ctrl:timeComplexity>O(log min(a, b))</ctrl:timeComplexity>
    <ctrl:solvesProblem>Compute gcd(a, b) for two non-negative integers using Euclidean remainder updates.</ctrl:solvesProblem>
    <ctrl:definition>Compute the greatest common divisor of two integers by repeated remainder updates (Euclidean algorithm) in a while loop until the remainder becomes 0.</ctrl:definition>
    <ctrl:courseId>A_CTRL02</ctrl:courseId>
    <rdfs:label>Euclidean GCD</rdfs:label>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:usesConstruct rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL05"/>
    <ctrl:usesConstruct>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL10">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Operator"/>
        <rdfs:label>%</rdfs:label>
        <ctrl:courseId>O_CTRL10</ctrl:courseId>
        <ctrl:definition>Returns the remainder after integer division.</ctrl:definition>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
        <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL01"/>
      </owl:NamedIndividual>
    </ctrl:usesConstruct>
  </ctrl:Algorithm>
  <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#isRequiredBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:comment>Inverse of depends_on.</rdfs:comment>
    <rdfs:label>is_required_by</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#dependsOn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label>depends_on</rdfs:label>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>Indicates that understanding one educational entity requires prior understanding of another.</rdfs:comment>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#A_CTRL01">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Algorithm"/>
    <ctrl:solvesProblem>Determine whether an integer is prime.</ctrl:solvesProblem>
    <ctrl:usesConcept>
      <ctrl:Concept rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL07">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
        <rdfs:label>Definite Iteration</rdfs:label>
        <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
        <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL04"/>
        <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL08"/>
        <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL04"/>
        <ctrl:definition>A form of iteration in which the sequence of values to visit is known before execution begins. In Python, definite iteration is naturally expressed using a for loop over an iterable.</ctrl:definition>
        <ctrl:bestPractice>Prefer a for loop whenever iterating over a known sequence or iterable.</ctrl:bestPractice>
        <ctrl:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL11"/>
        <ctrl:courseId>C_CTRL07</ctrl:courseId>
      </ctrl:Concept>
    </ctrl:usesConcept>
    <ctrl:usesConcept>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL18">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
        <ctrl:bestPractice>Use break only when continuing the loop serves no useful purpose.</ctrl:bestPractice>
        <ctrl:definition>Ending the execution of a loop before its normal termination condition has been reached because the desired result has already been obtained.</ctrl:definition>
        <rdfs:label>Early Loop Termination</rdfs:label>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
        <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL13"/>
        <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL06"/>
        <ctrl:courseId>C_CTRL18</ctrl:courseId>
        <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
        <ctrl:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL19"/>
      </owl:NamedIndividual>
    </ctrl:usesConcept>
    <ctrl:usesConcept>
      <ctrl:Concept rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL03">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label>Boolean Condition</rdfs:label>
        <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL02"/>
        <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL03"/>
        <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL08"/>
        <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL05"/>
        <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL09"/>
        <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL01"/>
        <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL06"/>
        <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL07"/>
        <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL04"/>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
        <ctrl:courseId>C_CTRL03</ctrl:courseId>
        <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
        <ctrl:definition>A Boolean expression whose evaluation determines whether a branch executes or whether a loop continues. Boolean conditions are the decision-making mechanism of control structures.</ctrl:definition>
        <ctrl:throwsError rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#E_CTRL03"/>
      </ctrl:Concept>
    </ctrl:usesConcept>
    <ctrl:usesConcept>
      <ctrl:Concept rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL17">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL11"/>
        <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL12"/>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
        <ctrl:bestPractice>Use membership testing instead of multiple equality comparisons whenever checking whether a value belongs to a collection.</ctrl:bestPractice>
        <ctrl:definition>Determining whether a value belongs to a sequence or iterable. Membership testing is commonly used to guide conditional execution and iteration.</ctrl:definition>
        <ctrl:courseId>C_CTRL17</ctrl:courseId>
        <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
        <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL03"/>
        <rdfs:label>Membership Testing</rdfs:label>
      </ctrl:Concept>
    </ctrl:usesConcept>
    <ctrl:usesConcept>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#P_CTRL02">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Pattern"/>
        <rdfs:label>Early-Exit Loop Pattern</rdfs:label>
        <ctrl:courseId>P_CTRL02</ctrl:courseId>
        <ctrl:definition>A loop that stops as soon as the answer is known by using break (or an equivalent early exit), instead of always running to the natural end of the iteration space.</ctrl:definition>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
        <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL18"/>
        <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL04"/>
        <ctrl:cognitiveType>procedural</ctrl:cognitiveType>
      </owl:NamedIndividual>
    </ctrl:usesConcept>
    <rdfs:label>Trial Division Primality Test</rdfs:label>
    <ctrl:courseId>A_CTRL01</ctrl:courseId>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:definition>Decide whether a positive integer n is prime by testing divisibility by candidates in range(2, n) and stopping early with break when a divisor is found (trial division).</ctrl:definition>
    <ctrl:timeComplexity>O(n)</ctrl:timeComplexity>
    <ctrl:usesConstruct rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL04"/>
    <ctrl:usesConstruct>
      <ctrl:LanguageConstruct rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL06">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ctrl:courseId>LC_CTRL06</ctrl:courseId>
        <ctrl:definition>Immediately terminates the nearest enclosing loop.</ctrl:definition>
        <rdfs:label>break statement</rdfs:label>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
      </ctrl:LanguageConstruct>
    </ctrl:usesConstruct>
    <ctrl:usesConstruct rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL10"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#A_CTRL04">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Algorithm"/>
    <ctrl:solvesProblem>Find the first occurrence of a target value in a sequence (linear search).</ctrl:solvesProblem>
    <ctrl:usesConcept>
      <ctrl:Concept rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL09">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <ctrl:courseId>C_CTRL09</ctrl:courseId>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
        <rdfs:label>Traversal</rdfs:label>
        <ctrl:bestPractice>Iterate directly over elements instead of indices whenever the index itself is not required.</ctrl:bestPractice>
        <ctrl:definition>The systematic process of visiting each element of a sequence exactly once in order to inspect, process, or analyse its contents.</ctrl:definition>
        <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL07"/>
        <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL08"/>
        <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL04"/>
        <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
      </ctrl:Concept>
    </ctrl:usesConcept>
    <ctrl:usesConcept>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL21">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Concept"/>
        <rdfs:label>Element Traversal</rdfs:label>
        <ctrl:courseId>C_CTRL21</ctrl:courseId>
        <ctrl:definition>Traversal performed by iterating directly over the elements of a sequence rather than over numerical positions.</ctrl:definition>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
        <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL09"/>
        <ctrl:implementedBy rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL04"/>
        <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
        <ctrl:contrastsWith rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL10"/>
        <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL03"/>
        <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL04"/>
        <ctrl:operatesOnType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL05"/>
      </owl:NamedIndividual>
    </ctrl:usesConcept>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL18"/>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL03"/>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL17"/>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#P_CTRL02"/>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:courseId>A_CTRL04</ctrl:courseId>
    <rdfs:label>Linear Search</rdfs:label>
    <ctrl:definition>Search for the first occurrence of a target value in a sequence by traversing elements (or index/value pairs with enumerate) and terminating early with break when a match is found.</ctrl:definition>
    <ctrl:timeComplexity>O(n)</ctrl:timeComplexity>
    <ctrl:usesConstruct rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL04"/>
    <ctrl:usesConstruct rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL06"/>
    <ctrl:usesConstruct>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#F_CTRL06">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#BuiltInFunction"/>
        <rdfs:label>enumerate()</rdfs:label>
        <ctrl:courseId>F_CTRL06</ctrl:courseId>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
        <ctrl:definition>Built-in that iterates over an iterable while yielding both the index and the corresponding value.</ctrl:definition>
        <ctrl:acceptsType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL03"/>
        <ctrl:acceptsType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL04"/>
        <ctrl:producesType rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#DT_CTRL05"/>
      </owl:NamedIndividual>
    </ctrl:usesConstruct>
  </owl:NamedIndividual>
