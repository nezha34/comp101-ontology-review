  <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#isThrownBy">
    <rdfs:domain rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#ErrorType"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#throwsError">
