    <rdfs:comment>Week 3 / Lecture 3 (COMP101): Control Structures — conditionals and loops.</rdfs:comment>
  </owl:Ontology>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#E_CTRL05">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#ErrorType"/>
    <ctrl:courseId>E_CTRL05</ctrl:courseId>
    <rdfs:label>IndexError</rdfs:label>
    <ctrl:definition>
        Raised when an index is outside the valid range of a sequence.
    </ctrl:definition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#A_CTRL03">
    <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Algorithm"/>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL13"/>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL11"/>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL12"/>
    <ctrl:usesConcept rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL06"/>
    <ctrl:usesConcept>
      <owl:NamedIndividual rdf:about="http://comp101.sase.um6p.ma/ontology/control-structures#P_CTRL01">
        <rdf:type rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#Pattern"/>
        <ctrl:bestPractice>
        Initialize the accumulator before the loop and update it consistently during every iteration.
    </ctrl:bestPractice>
        <ctrl:courseId>P_CTRL01</ctrl:courseId>
        <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
        <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL04"/>
        <ctrl:dependsOn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#C_CTRL12"/>
        <ctrl:definition>A programming pattern where a variable is updated during each iteration to accumulate a running total, count, or similar value.</ctrl:definition>
        <rdfs:label>Accumulator Pattern</rdfs:label>
        <ctrl:cognitiveType>conceptual</ctrl:cognitiveType>
      </owl:NamedIndividual>
    </ctrl:usesConcept>
    <ctrl:taughtIn rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#L03"/>
    <ctrl:solvesProblem>Convert an integer into binary representation.</ctrl:solvesProblem>
    <rdfs:label>Repeated Division Binary Conversion</rdfs:label>
    <ctrl:definition>Convert a positive integer to its binary representation by repeatedly dividing by 2, recording remainders until the quotient becomes 0.</ctrl:definition>
    <ctrl:courseId>A_CTRL03</ctrl:courseId>
    <ctrl:usesConstruct rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#LC_CTRL05"/>
    <ctrl:usesConstruct rdf:resource="http://comp101.sase.um6p.ma/ontology/control-structures#O_CTRL10"/>
  </owl:NamedIndividual>
