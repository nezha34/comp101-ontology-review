<?xml version="1.0"?>
<rdf:RDF xmlns="http://gnosis.local/ontologies/comp101#"
     xml:base="http://gnosis.local/ontologies/comp101"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
    <owl:Ontology rdf:about="http://gnosis.local/ontologies/comp101">
        <owl:versionInfo>2025.20</owl:versionInfo>
        <rdfs:label>COMP101 course ontology</rdfs:label>
        <rdfs:comment>Static curriculum ontology for the COMP101 intro programming course: lectures, concepts, Python data types, methods, errors, and skills. Cross-cutting concepts are tagged shared for merge with other course modules. Student misconceptions, symptoms, remediations, and evidence are modelled separately in the dynamic ontology (http://gnosis.local/ontologies/comp101-dynamic), which imports this one and references these ids. Pedagogy metadata (definition, cognitiveType, bestPractice) is populated incrementally on high-value targets; empty instances inherit schema from the OOP module for future merge.</rdfs:comment>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    </owl:Ontology>

    <!-- Classes -->
    <owl:Class rdf:about="http://gnosis.local/ontologies/comp101#Lecture">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Lecture</rdfs:label>
        <rdfs:comment>A week or unit in the course schedule.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://gnosis.local/ontologies/comp101#Concept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Concept</rdfs:label>
        <rdfs:comment>An idea to understand, not a keyword (e.g. Indexing).</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://gnosis.local/ontologies/comp101#Pattern">
        <rdfs:subClassOf rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Pattern</rdfs:label>
        <rdfs:comment>A common loop or problem-solving pattern (e.g. Accumulator).</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://gnosis.local/ontologies/comp101#ConceptCarrier">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>ConceptCarrier</rdfs:label>
        <rdfs:comment>Python surface that can implement or use curriculum concepts (syntax, methods, builtins). Groups LanguageConstruct with invokables for T-box connectivity.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://gnosis.local/ontologies/comp101#Invokable">
        <rdfs:subClassOf rdf:resource="http://gnosis.local/ontologies/comp101#ConceptCarrier"/>
        <rdfs:label>Invokable</rdfs:label>
        <rdfs:comment>Callable Python API: type-bound methods and global built-in functions.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://gnosis.local/ontologies/comp101#DataType">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>DataType</rdfs:label>
        <rdfs:comment>A Python built-in type used in code (e.g. list, dict).</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://gnosis.local/ontologies/comp101#ErrorType">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>ErrorType</rdfs:label>
        <rdfs:comment>An exception students may encounter (e.g. IndexError).</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://gnosis.local/ontologies/comp101#LanguageConstruct">
        <rdfs:subClassOf rdf:resource="http://gnosis.local/ontologies/comp101#ConceptCarrier"/>
        <rdfs:label>LanguageConstruct</rdfs:label>
        <rdfs:comment>Python syntax such as a for loop or the [] operator.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://gnosis.local/ontologies/comp101#Method">
        <rdfs:subClassOf rdf:resource="http://gnosis.local/ontologies/comp101#Invokable"/>
        <rdfs:label>Method</rdfs:label>
        <rdfs:comment>A function bound to a data type (e.g. list.append()).</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://gnosis.local/ontologies/comp101#BuiltInFunction">
        <rdfs:subClassOf rdf:resource="http://gnosis.local/ontologies/comp101#Invokable"/>
        <rdfs:label>BuiltInFunction</rdfs:label>
        <rdfs:comment>A global built-in function such as len() or sorted() (adopted from the shared OOP T-Box; cleaner than modelling these as LanguageConstructs).</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://gnosis.local/ontologies/comp101#Skill">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Skill</rdfs:label>
        <rdfs:comment>A learning outcome the student should achieve.</rdfs:comment>
    </owl:Class>

    <!-- Disjoint classes -->
    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#Lecture"/>
            <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#Concept"/>
            <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#DataType"/>
            <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#ErrorType"/>
            <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#LanguageConstruct"/>
            <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#Method"/>
            <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#BuiltInFunction"/>
            <rdf:Description rdf:about="http://gnosis.local/ontologies/comp101#Skill"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <!-- Object properties -->
    <owl:ObjectProperty rdf:about="http://gnosis.local/ontologies/comp101#taughtIn">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://gnosis.local/ontologies/comp101#Lecture"/>
        <rdfs:label>taughtIn</rdfs:label>
        <rdfs:comment>Week where an entity is first introduced (primary teaching). Use revisitedIn for reinforcement in a later week.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://gnosis.local/ontologies/comp101#revisitedIn">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://gnosis.local/ontologies/comp101#Lecture"/>
        <rdfs:label>revisitedIn</rdfs:label>
        <rdfs:comment>Week where a concept introduced earlier is reinforced in a new context — not first taught here.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://gnosis.local/ontologies/comp101#dependsOn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>dependsOn</rdfs:label>
        <rdfs:comment>Strict prerequisite: the source should be learned after the target. Transitive, so prerequisite chains close automatically (adopted from the OOP T-Box).</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://gnosis.local/ontologies/comp101#recommendedBefore">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>recommendedBefore</rdfs:label>
        <rdfs:comment>Pedagogical soft ordering: the source is usually taught before the target. Non-transitive; skippable when the learner has already mastered the target.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://gnosis.local/ontologies/comp101#implementsConcept">
        <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#ConceptCarrier"/>
        <rdfs:range rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>implementsConcept</rdfs:label>
        <rdfs:comment>Syntax-level coding of a concept (LanguageConstruct). BuiltInFunctions use usesConcept instead — do not attach implementsConcept to builtins.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://gnosis.local/ontologies/comp101#usesConcept">
        <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#ConceptCarrier"/>
        <rdfs:range rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>usesConcept</rdfs:label>
        <rdfs:comment>A method, construct, or built-in function relies on / carries out a concept or abstract operation (create, access, remove, ...). Shared name with the OOP module (replaces the earlier performsOperation).</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://gnosis.local/ontologies/comp101#producesType">
        <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#Invokable"/>
        <rdfs:range rdf:resource="http://gnosis.local/ontologies/comp101#DataType"/>
        <rdfs:label>producesType</rdfs:label>
        <rdfs:comment>The data type a method or built-in function returns (adopted from the OOP module; richer than the returnsNone boolean, which is kept as a shortcut).</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://gnosis.local/ontologies/comp101#contrastsWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>contrastsWith</rdfs:label>
        <rdfs:comment>Two entities that students often confuse and should compare (e.g. list vs tuple, shallow vs deep copy). Symmetric; shared with the OOP module.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://gnosis.local/ontologies/comp101#methodOf">
        <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>methodOf</rdfs:label>
        <rdfs:comment>A method belongs to a type or class. Range widened to owl:Thing to also cover user-defined classes in the OOP module.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://gnosis.local/ontologies/comp101#throwsError">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://gnosis.local/ontologies/comp101#ErrorType"/>
        <rdfs:label>throwsError</rdfs:label>
        <rdfs:comment>An entity can raise this error type.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://gnosis.local/ontologies/comp101#requiresConcept">
        <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#Skill"/>
        <rdfs:range rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>requiresConcept</rdfs:label>
        <rdfs:comment>A skill requires understanding of a concept.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://gnosis.local/ontologies/comp101#teaches">
        <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#Lecture"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>teaches</rdfs:label>
        <owl:inverseOf rdf:resource="http://gnosis.local/ontologies/comp101#taughtIn"/>
        <rdfs:comment>Inverse of taughtIn: a lecture first introduces this entity.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://gnosis.local/ontologies/comp101#revisits">
        <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#Lecture"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>revisits</rdfs:label>
        <owl:inverseOf rdf:resource="http://gnosis.local/ontologies/comp101#revisitedIn"/>
        <rdfs:comment>Inverse of revisitedIn: a lecture reinforces this entity from an earlier week.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://gnosis.local/ontologies/comp101#enables">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>enables</rdfs:label>
        <owl:inverseOf rdf:resource="http://gnosis.local/ontologies/comp101#dependsOn"/>
        <rdfs:comment>Inverse of dependsOn: the source is a prerequisite that enables the target.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://gnosis.local/ontologies/comp101#precedes">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>precedes</rdfs:label>
        <owl:inverseOf rdf:resource="http://gnosis.local/ontologies/comp101#recommendedBefore"/>
        <rdfs:comment>Inverse of recommendedBefore: the source normally comes later in the teaching sequence.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://gnosis.local/ontologies/comp101#implementedBy">
        <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:range rdf:resource="http://gnosis.local/ontologies/comp101#ConceptCarrier"/>
        <rdfs:label>implementedBy</rdfs:label>
        <owl:inverseOf rdf:resource="http://gnosis.local/ontologies/comp101#implementsConcept"/>
        <rdfs:comment>Inverse of implementsConcept: a concept is coded by this language construct, method, or built-in.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://gnosis.local/ontologies/comp101#isUsedBy">
        <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:range rdf:resource="http://gnosis.local/ontologies/comp101#ConceptCarrier"/>
        <rdfs:label>isUsedBy</rdfs:label>
        <owl:inverseOf rdf:resource="http://gnosis.local/ontologies/comp101#usesConcept"/>
        <rdfs:comment>Inverse of usesConcept: this concept/operation is used by the given method, construct, or built-in function.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://gnosis.local/ontologies/comp101#isProducedBy">
        <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#DataType"/>
        <rdfs:range rdf:resource="http://gnosis.local/ontologies/comp101#Invokable"/>
        <rdfs:label>isProducedBy</rdfs:label>
        <owl:inverseOf rdf:resource="http://gnosis.local/ontologies/comp101#producesType"/>
        <rdfs:comment>Inverse of producesType: this data type is produced by the given method or built-in function.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://gnosis.local/ontologies/comp101#hasMethod">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
        <rdfs:label>hasMethod</rdfs:label>
        <owl:inverseOf rdf:resource="http://gnosis.local/ontologies/comp101#methodOf"/>
        <rdfs:comment>Inverse of methodOf: a type or class has this method.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://gnosis.local/ontologies/comp101#raisedBy">
        <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#ErrorType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>raisedBy</rdfs:label>
        <owl:inverseOf rdf:resource="http://gnosis.local/ontologies/comp101#throwsError"/>
        <rdfs:comment>Inverse of throwsError: this error is raised by the given entity.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://gnosis.local/ontologies/comp101#requiredBy">
        <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:range rdf:resource="http://gnosis.local/ontologies/comp101#Skill"/>
        <rdfs:label>requiredBy</rdfs:label>
        <owl:inverseOf rdf:resource="http://gnosis.local/ontologies/comp101#requiresConcept"/>
        <rdfs:comment>Inverse of requiresConcept: this concept is required by the given skill.</rdfs:comment>
    </owl:ObjectProperty>

    <!-- Data properties -->
    <owl:DatatypeProperty rdf:about="http://gnosis.local/ontologies/comp101#difficulty">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>difficulty</rdfs:label>
        <rdfs:comment>Author pacing hint. Enum: difficulty (low | medium | high). Enum difficulty: low | medium | high.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://gnosis.local/ontologies/comp101#isOrdered">
        <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#DataType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>isOrdered</rdfs:label>
        <rdfs:comment>Whether the type preserves a positional order of elements.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://gnosis.local/ontologies/comp101#isMutable">
        <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#DataType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>isMutable</rdfs:label>
        <rdfs:comment>Whether the type can be changed in place after creation.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://gnosis.local/ontologies/comp101#isHashable">
        <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#DataType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>isHashable</rdfs:label>
        <rdfs:comment>Whether instances can be used as dict keys or set members.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://gnosis.local/ontologies/comp101#isIndexed">
        <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#DataType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>isIndexed</rdfs:label>
        <rdfs:comment>Whether elements are accessed by integer position.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://gnosis.local/ontologies/comp101#isIterable">
        <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#DataType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>isIterable</rdfs:label>
        <rdfs:comment>Whether the type can be looped over.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://gnosis.local/ontologies/comp101#allowsDuplicates">
        <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#DataType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>allowsDuplicates</rdfs:label>
        <rdfs:comment>Whether the type may contain repeated elements (keys, for dict).</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://gnosis.local/ontologies/comp101#returnsNone">
        <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#Method"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>returnsNone</rdfs:label>
        <rdfs:comment>True if the method mutates in place and evaluates to None (e.g. list.append); false if it returns a useful value (e.g. list.pop). Kept as a shortcut alongside producesType.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://gnosis.local/ontologies/comp101#definition">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>definition</rdfs:label>
        <rdfs:comment>Short plain-language definition of the entity (shared pedagogy metadata; from the OOP module).</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://gnosis.local/ontologies/comp101#cognitiveType">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>cognitiveType</rdfs:label>
        <rdfs:comment>Bloom cognitive level. Enum: cognitive_type (remember | understand | apply | analyze | evaluate | create); short aliases rem/und/app/ana/eva/cre accepted in CI. Enum cognitive_type: remember | understand | apply | analyze | evaluate | create.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://gnosis.local/ontologies/comp101#bestPractice">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>bestPractice</rdfs:label>
        <rdfs:comment>A recommended practice or idiom the tutor can reinforce (shared pedagogy metadata; from the OOP module).</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://gnosis.local/ontologies/comp101#commonCauses">
        <rdfs:domain rdf:resource="http://gnosis.local/ontologies/comp101#ErrorType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>commonCauses</rdfs:label>
        <rdfs:comment>Typical student mistakes that trigger this error, to seed remediation (shared pedagogy metadata; from the OOP module).</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Annotation properties -->
    <owl:AnnotationProperty rdf:about="http://gnosis.local/ontologies/comp101#socraticQuestion">
        <rdfs:label>socraticQuestion</rdfs:label>
        <rdfs:comment>A starter Socratic probe an LLM tutor can ask about this concept.</rdfs:comment>
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="http://gnosis.local/ontologies/comp101#sharedConcept">
        <rdfs:label>sharedConcept</rdfs:label>
        <rdfs:comment>Marks a cross-cutting concept owned by no single module; the merge tool should dedupe these across course modules.</rdfs:comment>
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="http://gnosis.local/ontologies/comp101#canonicalId">
        <rdfs:label>canonicalId</rdfs:label>
        <rdfs:comment>Stable cross-module identity (e.g. core:time_complexity) that the merge tool collapses duplicate nodes onto.</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- Individuals -->
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#W2_python">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Lecture"/>
        <rdfs:label>Week 2 — Intro to Python (placeholder; owned by another module)</rdfs:label>
        <canonicalId>course:W2</canonicalId>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#W3_control">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Lecture"/>
        <rdfs:label>Week 3 — Control Structures (placeholder; owned by another module)</rdfs:label>
        <canonicalId>course:W3</canonicalId>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#W2_python"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#W4_functions">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Lecture"/>
        <rdfs:label>Week 4 — Functions (placeholder; owned by another module)</rdfs:label>
        <canonicalId>course:W4</canonicalId>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#W3_control"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#W5_lists">
