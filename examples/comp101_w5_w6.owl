        <rdfs:label>int</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
        <isOrdered rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isOrdered>
        <isMutable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isMutable>
        <isHashable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isHashable>
        <isIndexed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isIndexed>
        <isIterable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isIterable>
        <allowsDuplicates rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</allowsDuplicates>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W2_python"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#bool">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#DataType"/>
        <rdfs:label>bool</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
        <isOrdered rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isOrdered>
        <isMutable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isMutable>
        <isHashable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isHashable>
        <isIndexed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isIndexed>
        <isIterable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isIterable>
        <allowsDuplicates rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</allowsDuplicates>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W2_python"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#mutability">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Mutability</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high</difficulty>
        <socraticQuestion>After you change a list inside a function, is the original list changed too?</socraticQuestion>
        <sharedConcept rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sharedConcept>
        <canonicalId>core:mutability</canonicalId>
        <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Whether a value can be changed in place after creation; lists are mutable, tuples and strings are not.</definition>
        <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand</cognitiveType>
        <bestPractice rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Introduce after students have used append/pop empirically — practice first, explain why behavior occurs.</bestPractice>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#sequence"/>
        <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#list_append"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#aliasing">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Aliasing (references)</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high</difficulty>
        <socraticQuestion>If b = a and you append to b, what happens to a?</socraticQuestion>
        <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Two names referring to the same object in memory; mutation through one name affects the other.</definition>
        <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand</cognitiveType>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#mutability"/>
        <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#list_sort"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#indexing">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Indexing</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
        <socraticQuestion>How would you get just one item out of a list?</socraticQuestion>
        <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand</cognitiveType>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#sequence"/>
        <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#mutability"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#zero_based_indexing">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Zero-based Indexing</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
        <socraticQuestion>A list has 5 items — what is the index of the first one? And the last one?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#indexing"/>
        <contrastsWith rdf:resource="http://gnosis.local/ontologies/comp101#negative_indexing"/>
        <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#negative_indexing"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#negative_indexing">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Negative Indexing</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
        <socraticQuestion>What do you think list[-1] gives you?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#indexing"/>
        <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#index_error"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#string_slicing">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Slicing</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
        <socraticQuestion>What does items[1:3] include on a list — and does it include index 3? Does the same slice work on a string?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#list"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#str"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#indexing"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#zero_based_indexing"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#iteration">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Iteration</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
        <socraticQuestion>How would you do something to every item in a list?</socraticQuestion>
        <sharedConcept rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sharedConcept>
        <canonicalId>core:iteration</canonicalId>
        <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W3_control"/>
        <revisitedIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <revisitedIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#membership_test">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Membership Test</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
        <socraticQuestion>How can you check if a value is in a list without writing a loop?</socraticQuestion>
        <sharedConcept rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sharedConcept>
        <canonicalId>core:membership_test</canonicalId>
        <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand</cognitiveType>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <revisitedIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#container"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#list_creation">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>List Creation</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
        <socraticQuestion>What are the different ways you could make a new list?</socraticQuestion>
        <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand</cognitiveType>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#list"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#op_create"/>
        <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#indexing"/>
        <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#membership_test"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#nested_lists">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Nested Lists</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
        <socraticQuestion>If a list holds other lists, how would you reach an item inside the inner list?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#list"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#indexing"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#list_comprehension">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>List Comprehension</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high</difficulty>
        <socraticQuestion>Can you build this new list in one line instead of a for loop?</socraticQuestion>
        <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A concise syntax that always builds a new list; it does not mutate an existing list.</definition>
        <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply</cognitiveType>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#iteration"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#for_loop"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#list"/>
        <contrastsWith rdf:resource="http://gnosis.local/ontologies/comp101#for_loop"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#sort_vs_sorted">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>sort() vs sorted()</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
        <socraticQuestion>What does list.sort() return? What about sorted(list)?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#mutability"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#shallow_copy">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Shallow Copy</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high</difficulty>
        <socraticQuestion>If you copy a list of lists, and change an inner list, does the copy change too?</socraticQuestion>
        <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A new outer container that still shares inner objects with the original.</definition>
        <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyze</cognitiveType>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#aliasing"/>
        <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#list_copy"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#deep_copy">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Deep Copy</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high</difficulty>
        <socraticQuestion>How could you copy a nested list so that nothing is shared with the original?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#shallow_copy"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#nested_lists"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#accumulator_pattern">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Pattern"/>
        <rdfs:label>Accumulator Pattern</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
        <socraticQuestion>How would you add up all the numbers in a list?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W3_control"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#iteration"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#counter_pattern">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Pattern"/>
        <rdfs:label>Counter Pattern</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
        <socraticQuestion>How would you count how many items match a condition?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W3_control"/>
        <revisitedIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#iteration"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#key_value_mapping">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Key-Value Mapping</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#key">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Key</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
        <socraticQuestion>In a phone book, what do you look something up by?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#key_value_mapping"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#value">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Value</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
        <socraticQuestion>Once you find a key, what does it give you back?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#key_value_mapping"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#key_value_pair">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Key-Value Pair</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
        <socraticQuestion>What are the two halves of a single dictionary entry?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#key"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#value"/>
        <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#key_error"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#key_immutability">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Key Immutability</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high</difficulty>
        <socraticQuestion>Why can you use a string or tuple as a dict key, but not a list?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#hashing"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#mutability"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#dict_comprehension">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Dictionary Comprehension</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high</difficulty>
        <socraticQuestion>Could you build a dict in one line the way you build a list with a comprehension?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#list_comprehension"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#key_value_mapping"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#nested_dicts">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Nested Dictionaries</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
        <socraticQuestion>If a value in a dict is itself a dict, how would you reach an inner value?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#dict"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#key_value_mapping"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#dict_default_iteration">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Dict Default Iteration (keys)</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
        <socraticQuestion>What does for x in d give you — keys, values, or pairs?</socraticQuestion>
        <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Iterating a dict directly yields its keys, not values or key-value pairs.</definition>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#iteration"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#dict"/>
        <contrastsWith rdf:resource="http://gnosis.local/ontologies/comp101#dict_keys"/>
        <contrastsWith rdf:resource="http://gnosis.local/ontologies/comp101#dict_values"/>
        <contrastsWith rdf:resource="http://gnosis.local/ontologies/comp101#dict_items"/>
        <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#dict_keys"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#empty_brace_ambiguity">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Empty Brace Ambiguity</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
        <socraticQuestion>What does {} create — an empty dict or an empty set?</socraticQuestion>
        <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In Python, {} is always an empty dict; an empty set requires set().</definition>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#dict"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#set"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#hashing">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Hashing</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high</difficulty>
        <sharedConcept rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sharedConcept>
        <canonicalId>core:hashing</canonicalId>
        <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand</cognitiveType>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#key_value_mapping"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#deduplication">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Deduplication</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
        <sharedConcept rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sharedConcept>
        <canonicalId>core:deduplication</canonicalId>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#set_operations">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Set Operations</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
        <socraticQuestion>You have two sets of student names — how would you find who is in both?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#set"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#membership_test"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#set_union">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Set Union</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
        <socraticQuestion>If A = {1,2} and B = {2,3}, what is everything that appears in either set?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#set_operations"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#set_intersection">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Set Intersection</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
        <socraticQuestion>Given two sets, how would you keep only the items they share?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#set_operations"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#set_difference">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Set Difference</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
        <socraticQuestion>How would you find items in A that are not in B?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#set_operations"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#symmetric_difference">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Symmetric Difference</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
        <socraticQuestion>How would you find items that are in exactly one of the two sets?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#set_operations"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#subset">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Subset</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
        <socraticQuestion>How would you check if every element of A is also in B?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#set_operations"/>
        <contrastsWith rdf:resource="http://gnosis.local/ontologies/comp101#superset"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#superset">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Superset</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
        <socraticQuestion>How would you check if A contains all of B's elements?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#set_operations"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#list_to_set">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>List-to-Set Conversion</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
        <socraticQuestion>You have a list with repeated names — how could a set help you get only the unique ones?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#set"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#deduplication"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#time_complexity">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Time Complexity of Operations</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high</difficulty>
        <socraticQuestion>Why might checking whether an item is in a set be faster than checking a list?</socraticQuestion>
        <sharedConcept rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sharedConcept>
        <canonicalId>core:time_complexity</canonicalId>
        <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">How the cost of an operation grows with collection size; list membership scans all elements, dict/set lookup is typically constant time on average.</definition>
        <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyze</cognitiveType>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#hashing"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#membership_test"/>
        <recommendedBefore rdf:resource="http://gnosis.local/ontologies/comp101#data_structure_selection"/>
        <revisitedIn rdf:resource="http://gnosis.local/ontologies/comp101#W8_sorting"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#data_structure_selection">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Data Structure Selection</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high</difficulty>
        <socraticQuestion>Given a problem, which structure would you choose — list, tuple, dict, or set — and why?</socraticQuestion>
        <sharedConcept rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sharedConcept>
        <canonicalId>core:data_structure_selection</canonicalId>
        <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Choosing among list, tuple, dict, and set based on order, mutability, uniqueness, keyed lookup, and operation cost.</definition>
        <cognitiveType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluate</cognitiveType>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#collection"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#time_complexity"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#list"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#tuple"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#dict"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#set"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#tuple_packing">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Tuple Packing</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
        <socraticQuestion>What happens when you write t = 1, 2, 3 without parentheses?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#tuple"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#tuple_unpacking">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Tuple Unpacking</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
        <socraticQuestion>How could you assign a, b = (1, 2) in a single line?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#tuple_packing"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#nested_tuples">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Nested Tuples</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
        <socraticQuestion>If a tuple holds other tuples, how would you reach an inner value?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#tuple"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#tuples_as_keys">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Concept"/>
        <rdfs:label>Tuples as Dictionary Keys</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high</difficulty>
        <socraticQuestion>Why can a tuple be a dictionary key when a list cannot?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#tuple"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#hashing"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#key_immutability"/>
    </owl:NamedIndividual>
