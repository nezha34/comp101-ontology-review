        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <implementsConcept rdf:resource="http://gnosis.local/ontologies/comp101#membership_test"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#concatenation_operator">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#LanguageConstruct"/>
        <rdfs:label>+ (concatenation operator)</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <implementsConcept rdf:resource="http://gnosis.local/ontologies/comp101#concatenation"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#repetition_operator">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#LanguageConstruct"/>
        <rdfs:label>* (repetition operator)</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <implementsConcept rdf:resource="http://gnosis.local/ontologies/comp101#repetition"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#union_operator">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#LanguageConstruct"/>
        <rdfs:label>| (union operator)</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <implementsConcept rdf:resource="http://gnosis.local/ontologies/comp101#set_union"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#intersection_operator">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#LanguageConstruct"/>
        <rdfs:label>&amp; (intersection operator)</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <implementsConcept rdf:resource="http://gnosis.local/ontologies/comp101#set_intersection"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#difference_operator">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#LanguageConstruct"/>
        <rdfs:label>- (difference operator)</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <implementsConcept rdf:resource="http://gnosis.local/ontologies/comp101#set_difference"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#symmetric_difference_operator">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#LanguageConstruct"/>
        <rdfs:label>^ (symmetric difference operator)</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <implementsConcept rdf:resource="http://gnosis.local/ontologies/comp101#symmetric_difference"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#list_literal_syntax">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#LanguageConstruct"/>
        <rdfs:label>[] list literal</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <implementsConcept rdf:resource="http://gnosis.local/ontologies/comp101#op_create"/>
        <implementsConcept rdf:resource="http://gnosis.local/ontologies/comp101#list_creation"/>
        <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#op_create"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#dict_literal_syntax">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#LanguageConstruct"/>
        <rdfs:label>{} dict literal</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
        <socraticQuestion>What does {} create — an empty dict or an empty set?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <implementsConcept rdf:resource="http://gnosis.local/ontologies/comp101#op_create"/>
        <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#op_create"/>
        <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#empty_brace_ambiguity"/>
        <contrastsWith rdf:resource="http://gnosis.local/ontologies/comp101#set_constructor"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#tuple_literal_syntax">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#LanguageConstruct"/>
        <rdfs:label>() tuple literal</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <implementsConcept rdf:resource="http://gnosis.local/ontologies/comp101#op_create"/>
        <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#op_create"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#len_function">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#BuiltInFunction"/>
        <rdfs:label>len()</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
        <socraticQuestion>Which single built-in gives you the size of a list, a string, a dict, or a set?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#length"/>
        <producesType rdf:resource="http://gnosis.local/ontologies/comp101#int"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#sorted_function">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#BuiltInFunction"/>
        <rdfs:label>sorted()</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
        <socraticQuestion>You need the sorted order but must keep the original list untouched — sorted() or list.sort()?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#sort_vs_sorted"/>
        <producesType rdf:resource="http://gnosis.local/ontologies/comp101#list"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#enumerate_function">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#BuiltInFunction"/>
        <rdfs:label>enumerate()</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</difficulty>
        <socraticQuestion>How can you loop over both index and value at the same time?</socraticQuestion>
        <sharedConcept rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sharedConcept>
        <canonicalId>core:enumerate</canonicalId>
        <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yields (index, value) pairs when looping over an iterable.</definition>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W3_control"/>
        <revisitedIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#iteration"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#for_loop"/>
        <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#iteration"/>
        <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#tuple_unpacking"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#range_function">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#BuiltInFunction"/>
        <rdfs:label>range()</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
        <socraticQuestion>How would you write a loop that runs exactly n times without building a list of numbers?</socraticQuestion>
        <sharedConcept rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sharedConcept>
        <canonicalId>core:range</canonicalId>
        <definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Produces an immutable sequence of integers; common in for i in range(len(lst)).</definition>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W3_control"/>
        <revisitedIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#iteration"/>
        <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#iteration"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#list_constructor">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#BuiltInFunction"/>
        <rdfs:label>list()</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#op_create"/>
        <producesType rdf:resource="http://gnosis.local/ontologies/comp101#list"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#dict_constructor">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#BuiltInFunction"/>
        <rdfs:label>dict()</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
        <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#op_create"/>
        <producesType rdf:resource="http://gnosis.local/ontologies/comp101#dict"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#tuple_constructor">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#BuiltInFunction"/>
        <rdfs:label>tuple()</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <usesConcept rdf:resource="http://gnosis.local/ontologies/comp101#op_create"/>
        <producesType rdf:resource="http://gnosis.local/ontologies/comp101#tuple"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#set_constructor">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#BuiltInFunction"/>
        <rdfs:label>set()</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
        <socraticQuestion>How could you turn a list with repeats into a collection of unique items? How is that different from {}?</socraticQuestion>
