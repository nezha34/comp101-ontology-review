        <requiresConcept rdf:resource="http://gnosis.local/ontologies/comp101#time_complexity"/>
        <requiresConcept rdf:resource="http://gnosis.local/ontologies/comp101#collection"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#skill_dedupe">
