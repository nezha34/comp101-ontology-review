    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#skill_select_data_structure">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#Skill"/>
        <rdfs:label>Choose the right data structure for a problem</rdfs:label>
        <socraticQuestion>Given a problem, which structure would you choose — list, tuple, dict, or set — and why?</socraticQuestion>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W6_dicts_sets"/>
