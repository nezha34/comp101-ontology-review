        <contrastsWith rdf:resource="http://gnosis.local/ontologies/comp101#str"/>
        <throwsError rdf:resource="http://gnosis.local/ontologies/comp101#index_error"/>
        <throwsError rdf:resource="http://gnosis.local/ontologies/comp101#value_error"/>
