        <dependsOn rdf:resource="http://gnosis.local/ontologies/comp101#mutability"/>
        <throwsError rdf:resource="http://gnosis.local/ontologies/comp101#type_error"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#str">
        <rdf:type rdf:resource="http://gnosis.local/ontologies/comp101#DataType"/>
        <rdfs:label>str</rdfs:label>
        <difficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low</difficulty>
        <socraticQuestion>A string keeps its characters in order and cannot be changed once created — which other type behaves the same way? Does items[1:3] on a string work the same as on a list?</socraticQuestion>
        <sharedConcept rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sharedConcept>
        <canonicalId>core:str</canonicalId>
        <isOrdered rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isOrdered>
        <isMutable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isMutable>
        <isHashable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isHashable>
        <isIndexed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isIndexed>
        <isIterable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isIterable>
        <allowsDuplicates rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</allowsDuplicates>
        <taughtIn rdf:resource="http://gnosis.local/ontologies/comp101#W2_python"/>
        <revisitedIn rdf:resource="http://gnosis.local/ontologies/comp101#W5_lists"/>
        <contrastsWith rdf:resource="http://gnosis.local/ontologies/comp101#tuple"/>
        <throwsError rdf:resource="http://gnosis.local/ontologies/comp101#index_error"/>
        <throwsError rdf:resource="http://gnosis.local/ontologies/comp101#value_error"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://gnosis.local/ontologies/comp101#int">
