{
  "name": "COMP101_GENERIC",
  "namespace": null,
  "id_property": "courseId",
  "match": "fallback",
  "skill_graph": {
    "class": "Skill",
    "depends_on": "dependsOn",
    "uses_concept": "usesConcept"
  },
  "competency_questions": [
    {
      "id": "CQ_GEN_01",
      "question": "Are there Concept individuals in this module?",
      "sparql": "SELECT ?c WHERE {{ ?c a <{ns}Concept> . }}",
      "expect_min": 1
    },
    {
      "id": "CQ_GEN_02",
      "question": "Are there Skill individuals?",
      "sparql": "SELECT ?s WHERE {{ ?s a <{ns}Skill> . }}",
      "expect_min": 1
    },
    {
      "id": "CQ_GEN_03",
      "question": "Do any skills declare dependsOn prerequisites?",
      "sparql": "SELECT ?s WHERE {{ ?s a <{ns}Skill> . ?s <{ns}dependsOn> ?p . }}",
      "expect_min": 1
    },
    {
      "id": "CQ_GEN_04",
      "question": "Do any skills useConcept links?",
      "sparql": "SELECT ?s WHERE {{ ?s a <{ns}Skill> . ?s <{ns}usesConcept> ?c . }}",
      "expect_min": 1
    },
    {
      "id": "CQ_GEN_05",
      "question": "Is anything taughtIn a lecture / session individual?",
      "sparql": "SELECT ?c WHERE {{ ?c <{ns}taughtIn> ?lec . }}",
      "expect_min": 1
    },
    {
      "id": "CQ_GEN_06",
      "question": "Are object-property edges using shared predicates present?",
      "sparql": "SELECT DISTINCT ?p WHERE {{ VALUES ?p {{ <{ns}dependsOn> <{ns}usesConcept> <{ns}taughtIn> <{ns}requiresConcept> <{ns}partOf> }} ?s ?p ?o . }}",
      "expect_min": 1
    }
  ]
}
