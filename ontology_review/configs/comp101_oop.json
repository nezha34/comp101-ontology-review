{
  "name": "COMP101_OOP",
  "namespace": "http://comp101.sase.um6p.ma/ontology/oop#",
  "id_property": "courseId",
  "skill_graph": {
    "class": "Skill",
    "depends_on": "dependsOn",
    "uses_concept": "usesConcept"
  },
  "competency_questions": [
    {
      "id": "CQ_OOP_01",
      "question": "Which entities does 'Design a class to model a real entity' use?",
      "sparql": "SELECT ?entity WHERE {{ <{ns}SKOOP001> <{ns}usesConcept> ?entity . }}",
      "expect_min": 5
    },
    {
      "id": "CQ_OOP_02",
      "question": "What are the prerequisite skills before 'Apply polymorphism'?",
      "sparql": "SELECT ?prereq WHERE {{ <{ns}SKOOP004> <{ns}dependsOn>+ ?prereq . ?prereq a <{ns}Skill> . }}",
      "expect_min": 1
    },
    {
      "id": "CQ_OOP_03",
      "question": "Which mechanisms enable 'Data Hiding'?",
      "sparql": "SELECT ?mech WHERE {{ ?mech <{ns}enables> <{ns}COOP009> . }}",
      "expect_min": 1
    },
    {
      "id": "CQ_OOP_04",
      "question": "Which concepts are taught in L10?",
      "sparql": "SELECT ?c WHERE {{ ?c <{ns}taughtIn> <{ns}L10> . ?c a <{ns}Concept> . }}",
      "expect_min": 5
    },
    {
      "id": "CQ_OOP_05",
      "question": "What does Inheritance depend on?",
      "sparql": "SELECT ?dep WHERE {{ <{ns}COOP013> <{ns}dependsOn> ?dep . }}",
      "expect_min": 1
    },
    {
      "id": "CQ_OOP_06",
      "question": "Which errors can be thrown in the OOP ontology?",
      "sparql": "SELECT DISTINCT ?err WHERE {{ ?x <{ns}throwsError> ?err . }}",
      "expect_min": 1
    },
    {
      "id": "CQ_OOP_07",
      "question": "Which entities are part_of the Class concept?",
      "sparql": "SELECT ?part WHERE {{ ?part <{ns}partOf> <{ns}COOP001> . }}",
      "expect_min": 3
    }
  ]
}
